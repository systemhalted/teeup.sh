#!/usr/bin/env bash
# bootstrap - set up a fresh Mac with teeup.
#
#   git clone <repo> ~/.local/share/teeup && cd ~/.local/share/teeup && ./bootstrap
#
# bash 3.2, no dependencies beyond a fresh macOS. Safe to re-run: every step
# is idempotent, so re-running is also the repair path.
set -eu

TEEUP_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TEEUP_PATH
# shellcheck source=lib/all.sh
source "$TEEUP_PATH/lib/all.sh"

RECONFIGURE=false
SKIP_DAILY=false

usage() {
  cat <<'USAGE'
Usage: ./bootstrap [--dry-run] [--reconfigure] [--skip-daily]

  --dry-run      print every command instead of running it
  --reconfigure  ask the setup questions again even if answers exist
  --skip-daily   install only the core tier this run
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true ;;
    --reconfigure) RECONFIGURE=true ;;
    --skip-daily) SKIP_DAILY=true ;;
    -h|--help) usage; exit 0 ;;
    *) err "Unknown option: $1"; usage >&2; exit 2 ;;
  esac
  shift
done
export DRY_RUN

if [[ "$DRY_RUN" != "true" ]]; then
  TEEUP_LOG_FILE="${TEEUP_LOG_FILE:-$TEEUP_STATE_DIR/logs/bootstrap.log}"
fi
export TEEUP_LOG_FILE

started="$(date +%s)"

# --- 0. preflight -----------------------------------------------------------
is_macos || die "teeup targets macOS only (uname -s reports $(uname -s))."
[[ "$(id -u)" -ne 0 ]] || die "Run bootstrap as your user, not root."
if [[ "$DRY_RUN" == "true" ]]; then
  log "Dry run: nothing will be changed."
else
  sudo -v || die "sudo is required for the package manager and system settings."
  parent=$$
  ( while kill -0 "$parent" 2>/dev/null; do sudo -n true; sleep 60; done ) 2>/dev/null &
  SUDO_KEEPALIVE_PID=$!
  trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT
fi
log "macOS $(sw_vers -productVersion 2>/dev/null || echo '?') on $(arch), teeup at $TEEUP_PATH"

# --- helpers ----------------------------------------------------------------
# Every capability run_capability completed this run, space-delimited.
CONFIGURED_THIS_RUN=" "

run_capability() {
  # run_capability <name> -> install then configure, recording done or
  # not-applicable (cap_install_verbs, lib/capability.sh). A not-applicable
  # capability did not really configure anything, so it is left out of
  # CONFIGURED_THIS_RUN.
  local name="$1"
  cap_install_verbs "$name" || return 1
  [[ "$TEEUP_CAP_NA" == "true" ]] || CONFIGURED_THIS_RUN="$CONFIGURED_THIS_RUN$name "
}

run_tier() {
  # run_tier <core|daily>. Core failures abort; daily failures warn.
  local tier="$1" name
  for name in $(cap_tier_list "$tier"); do
    if ! cap_exists "$name"; then
      warn "$name is listed in $tier.list but not implemented yet; skipping."
      continue
    fi
    if cap_skipped "$name"; then
      warn "Skipping $name (TEEUP_SKIP)"
      continue
    fi
    if ! run_capability "$name"; then
      if [[ "$tier" == "core" ]]; then
        die "Core capability $name failed. See ${TEEUP_LOG_FILE:-the output above}, fix the cause, and re-run ./bootstrap."
      fi
      warn "Daily capability $name failed; continuing. Re-run with: teeup install $name"
    fi
  done
}

# WIZARD_MAX_TRIES: a small number of tries, not infinite -- a wizard stuck
# re-prompting forever on a non-interactive stdin (a CI runner, a piped
# answers file) would otherwise hang bootstrap instead of failing loudly.
WIZARD_MAX_TRIES=3

# wizard_ask <prompt> <default> <validator> -> prints the validated answer.
# Re-prompts on an invalid answer instead of silently accepting it (the F2
# bug: an empty personal email, or a path typed into the work-email field,
# both used to sail through). <validator> is called with the candidate on
# $1; it warns and returns 1 for a bad answer, returns 0 for a good one. The
# rejected candidate becomes the next prompt's default, so a retry starts
# from what the user actually typed rather than snapping back to the
# original default.
wizard_ask() {
  local prompt="$1" default="$2" validator="$3" answer validated try
  for ((try = 1; try <= WIZARD_MAX_TRIES; try++)); do
    answer="$(ui_input "$prompt" "$default")"
    # Validators print the value they accepted (trimmed, normalised), so the
    # caller records what was validated rather than what was typed. Capturing
    # it here also keeps a validator's own output from leaking into this
    # function's stdout, which would hand the caller two lines.
    if validated="$("$validator" "$answer")"; then
      printf '%s\n' "$validated"
      return 0
    fi
    default="$answer"
  done
  die "Too many invalid answers for: $prompt. Run ./bootstrap --reconfigure once you have a valid value."
}

# _wizard_valid_name <candidate> -> prints <candidate> trimmed of
# leading/trailing blanks once that trimmed value is non-empty, else warns
# and fails. bash 3.2-safe: parameter-expansion glob trimming, no extglob.
_wizard_valid_name() {
  local v="$1" trimmed
  trimmed="${v#"${v%%[![:space:]]*}"}"
  trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
  if [[ -z "$trimmed" ]]; then
    warn "A name cannot be empty."
    return 1
  fi
  printf '%s\n' "$trimmed"
  return 0
}

# _wizard_valid_email <candidate>: the wizard's validator contract (print the
# accepted value, warn and fail otherwise) over the shared email check in
# lib/answers.sh, which the machine-file check uses too.
_wizard_valid_email() { email_valid "$1"; }

# The package manager is NOT asked here: step 2 below installs it, and this
# wizard runs after step 3. See ask_package_manager.
# Work is never asked here: it is per-machine, not a question. A work
# identity exists only when machines/<hostname>.conf sets TEEUP_WORK_EMAIL
# (see machines/example.conf.sample); this wizard has nothing to do with it.
wizard() {
  local name email theme daily themes pinned_theme ask_theme=true
  local flavor="" current_flavor other_flavor flavors pinned_flavor
  echo ""
  echo "A few questions. Answers are saved to $(answers_file) and can be changed later with: ./bootstrap --reconfigure"
  echo ""
  # The wizard that shipped before 2026-09-17 asked for a work email and wrote
  # it into the answers file. This one neither asks nor reads it (the work
  # identity comes from machines/<hostname>.conf alone), so the leftover answer
  # is inert -- but leaving it there means the only way to be rid of it is a
  # text editor. Clear it instead, and say so.
  if answers_unset TEEUP_WORK_EMAIL; then
    ok_unless_dry "Removed the old TEEUP_WORK_EMAIL answer; a work identity is configured in $(machine_file) now."
  fi
  name="$(wizard_ask "Your full name" "$(answers_get TEEUP_NAME "$(id -F 2>/dev/null || true)")" _wizard_valid_name)"
  email="$(wizard_ask "Personal email (your git identity)" "$(answers_get TEEUP_EMAIL)" _wizard_valid_email)"
  # A theme pinned by machines/<hostname>.conf wins in answers_load, so asking
  # would record an answer nothing reads (same rule as ask_package_manager).
  if pinned_theme="$(machine_get TEEUP_THEME)"; then
    log "Theme is pinned to ${pinned_theme:-catppuccin} by $(machine_file); not asking."
    ask_theme=false
  else
    # Offer what themes/ actually ships, so an answer can never name a palette
    # that theme_set would have to fall back from. An empty theme_list (a
    # checkout with no themes/ directory) still has to give ui_choose something
    # to offer, so fall back to catppuccin, theme_set's own fallback theme.
    themes="$(theme_list)"
    themes="${themes:-catppuccin}"
    # shellcheck disable=SC2086  # one option per word is exactly what ui_choose wants
    theme="$(ui_choose "Theme" $themes)"
  fi
  if ui_confirm "Install the daily set too (Emacs, Zed, Firefox Developer Edition, Obsidian)?" yes; then
    daily=yes
  else
    daily=no
  fi
  # The Emacs flavor only matters when the daily tier (where emacs lives) is
  # on. A pinned value is not asked, for the same reason as the theme. The
  # current answer is offered first, so an empty reply keeps it; on a first
  # run that is teeup's own starter configuration.
  if [[ "$daily" == "yes" ]]; then
    if pinned_flavor="$(machine_get TEEUP_EMACS_FLAVOR)"; then
      log "Emacs flavor is pinned to ${pinned_flavor:-starter} by $(machine_file); not asking."
    else
      current_flavor="$(answers_get TEEUP_EMACS_FLAVOR starter)"
      case "$current_flavor" in
        starter|doom|spacemacs|none) ;;
        *) current_flavor=starter ;;
      esac
      flavors="$current_flavor"
      for other_flavor in starter doom spacemacs none; do
        [[ "$other_flavor" == "$current_flavor" ]] || flavors="$flavors $other_flavor"
      done
      # shellcheck disable=SC2086  # one option per word is exactly what ui_choose wants
      flavor="$(ui_choose "Emacs flavor (starter is teeup's config; none leaves ~/.config/emacs alone)" $flavors)"
    fi
  fi
  answers_set TEEUP_NAME "$name"
  answers_set TEEUP_EMAIL "$email"
  if [[ "$ask_theme" == "true" ]]; then answers_set TEEUP_THEME "$theme"; fi
  answers_set TEEUP_DAILY "$daily"
  if [[ -n "$flavor" ]]; then answers_set TEEUP_EMACS_FLAVOR "$flavor"; fi
  answers_load
}

# The one question that cannot wait for the wizard: step 2 installs the package
# manager and the package-manager capability records whichever backend it used,
# so asking afterwards left the answer unable to affect the operation it names.
# Choosing MacPorts after Homebrew had been installed and recorded made the
# second package-manager pass in `run_tier core` fail, and on macOS 12 or older
# a missing MacPorts aborted step 2 before Homebrew could even be offered.
# ui_choose falls back to a plain numbered read, so this works before gum is
# installed. Asked only when there is no recorded answer yet (or --reconfigure
# was passed, which is the only way to change it).
ask_package_manager() {
  local detected other choice pinned
  # machines/<hostname>.conf is a hard constraint that answers_load applies
  # last, so every capability process would ignore a different answer given
  # here -- while this shell, where answers_set exports the choice, would not:
  # pkg_backend_path below would then add the ignored backend's bin dir and
  # the gum the capability just installed would be missing from the wizard.
  # Reached only with --reconfigure (a pinned value is never "unset"), and
  # the honest response is to say the value is pinned and not ask.
  if pinned="$(machine_get TEEUP_PACKAGE_MANAGER)"; then
    if [[ -n "$pinned" ]]; then
      log "Package manager is pinned to $pinned by $(machine_file); not asking."
    else
      log "Package manager is pinned to auto-detection by $(machine_file) (TEEUP_PACKAGE_MANAGER is empty there); not asking."
    fi
    return 0
  fi
  detected="$(pkg_backend)"
  if [[ "$detected" == "homebrew" ]]; then other=macports; else other=homebrew; fi
  echo ""
  choice="$(ui_choose "Package manager" "$detected" "$other")"
  answers_set TEEUP_PACKAGE_MANAGER "$choice"
  # pkg_backend ran in a command substitution, so it cached nothing here; an
  # earlier call in this shell could have. Drop the cache so the answer just
  # recorded is what every later call in this process resolves.
  unset TEEUP_PKG_BACKEND
}

# --- 1. Xcode Command Line Tools, Rosetta ------------------------------------
cap_run xcode-clt install || die "Xcode Command Line Tools are required. Complete the installer and re-run ./bootstrap."

# --- 2. package manager -------------------------------------------------------
answers_load
if [[ "$RECONFIGURE" == "true" || -z "$(answers_get TEEUP_PACKAGE_MANAGER)" ]]; then
  ask_package_manager
fi
run_capability package-manager || die "Core capability package-manager failed. Fix the cause and re-run ./bootstrap."
pkg_backend_path

# --- 3. teeup runtime (env file, command link, gum, jq) -----------------------
run_capability teeup-runtime || die "Core capability teeup-runtime failed. Fix the cause and re-run ./bootstrap."

# --- 4. answers ---------------------------------------------------------------
if answers_exist && [[ "$RECONFIGURE" != "true" ]]; then
  log "Using existing answers from $(answers_file) (pass --reconfigure to change them)."
else
  wizard
fi

# --- 5 and 6. tiers -----------------------------------------------------------
run_tier core
if [[ "$SKIP_DAILY" == "true" ]]; then
  log "Skipping the daily tier (--skip-daily)."
elif [[ "$(answers_get TEEUP_DAILY yes)" == "no" ]]; then
  log "Skipping the daily tier (TEEUP_DAILY=no)."
else
  run_tier daily
fi

# --- 7. theme and state -------------------------------------------------------
# theme is in core.list, so the core tier has already rendered it this run, and
# a second configure would render every template and rewrite starship.toml
# again. This step only covers a run where the core tier did not configure it.
if cap_exists theme && ! cap_skipped theme; then
  case "$CONFIGURED_THIS_RUN" in
    *" theme "*) ;;
    *) cap_run theme configure || warn "Theme configuration failed; run: teeup theme set $(answers_get TEEUP_THEME)" ;;
  esac
fi
if ! state_done check bootstrap; then
  # A fresh install starts with every shipped migration already applied: the
  # capabilities above put the machine in the state those migrations lead to.
  migrations_mark_all
fi
state_done mark bootstrap

# --- 8. hooks and summary -----------------------------------------------------
hook_run post-bootstrap
echo ""
ok "Bootstrap finished in $(format_duration $(( $(date +%s) - started )))."
if [[ "$DRY_RUN" == "true" ]]; then
  echo "This was a dry run: nothing was installed or written."
else
  echo "Open a new terminal (the zsh capability puts ~/.local/bin on PATH) and try: teeup status"
  echo "In this shell, use the full path: $HOME/.local/bin/teeup status"
fi
