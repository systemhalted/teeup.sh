#!/usr/bin/env bash
# teeup - dispatcher for the teeup macOS environment.
# Usage: teeup <verb> [capability] [args]
set -eu

# Resolve the checkout even when invoked through the ~/.local/bin symlink.
# macOS readlink has no -f, so follow links by hand.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
TEEUP_PATH="$(cd "$(dirname "$_self")/.." && pwd)"
export TEEUP_PATH
unset _self _dir

# shellcheck source=lib/all.sh
source "$TEEUP_PATH/lib/all.sh"
answers_load

usage() {
  cat <<'USAGE'
teeup - your Mac, as a distribution

  teeup install <capability>     install and configure it (and what it requires)
  teeup install dev-env <lang>   python|node|java|ruby|rust|go through mise
  teeup install font <name>      install a Nerd Font and point every tool at it
  teeup install font list        list the fonts teeup knows by name
  teeup configure <capability>   re-run only its configuration
  teeup reset <capability>       put its config files back to the shipped version (backups kept)
  teeup update [<capability>]    pull, migrate, upgrade packages, re-configure, re-theme
  teeup remove <capability>      undo what a capability installed
  teeup list [--tier core|daily|lazy]
  teeup theme set|list|current   apply, list or print the cross-tool theme
  teeup launch <app|capability>  open a GUI app, installing its cask first if needed
  teeup lazy-run <cap> <cmd> [args]  what a lazy shim runs: install <cap> on first use, then exec <cmd>
  teeup menu [<id>]              every teeup action as a keyboard-driven list
  teeup doctor [<capability>]    check what is installed, and say how to fix what is not
                                 (exit 0 verified healthy, 1 found problems,
                                  2 could not check something)
  teeup config get|set|edit      read or change the answers file
  teeup has <capability>         exit 0 when installed (for scripts and menus)
  teeup secret get|set|rm <name>  read, store or delete a Keychain secret
  teeup status                   package manager, answers, installed capabilities
  teeup commands --check         lint capability metadata
  teeup dev add-migration        start migrations/<epoch>.sh for machines already set up
  teeup dev new-capability <name>  scaffold capabilities/<name> and its test
  teeup dev check [<capability>]   metadata, menu, shellcheck and the tests
  teeup migrate legacy           retire the old teeup and chezmoi wiring on this Mac
  teeup version
  teeup help
USAGE
}

cmd_install() {
  local target="${1:-}" order c
  # `font` is not a capability: it is a switch over an already-installed
  # capability's state, so it is handled before the capability lookup.
  if [[ "$target" == "font" ]]; then
    shift
    # A skipped fonts capability means no font casks on this machine; listing
    # the table installs nothing, so it stays available.
    if [[ "$*" != "list" ]] && cap_skipped fonts; then
      die "fonts is skipped on this machine (TEEUP_SKIP)"
    fi
    font_set "$*"
    return $?
  fi
  # `dev-env` is not a capability either: runtimes come through mise and get
  # no shims (spec section 6), so they have their own switch.
  if [[ "$target" == "dev-env" ]]; then
    shift
    # dev_env_install takes exactly one language; a second, silently dropped
    # argument (M5) would let `teeup install dev-env python node` look like
    # it set up both when only python was ever installed.
    [[ $# -le 1 ]] || die "Usage: teeup install dev-env <python|node|java|ruby|rust|go>"
    dev_env_install "${1:-}"
    return $?
  fi
  [[ -n "$target" ]] || die "Usage: teeup install <capability>"
  cap_exists "$target" || die "Unknown capability: $target"
  if cap_skipped "$target"; then
    die "$target is skipped on this machine (TEEUP_SKIP)"
  fi
  order="$(cap_order "$target")" || die "Cannot resolve what $target requires."
  for c in $order; do
    if cap_skipped "$c"; then
      warn "Skipping $c (TEEUP_SKIP)"
      continue
    fi
    # A completed requirement is the expensive path lazy-run must not replay:
    # xcode-clt, package-manager and mise have already installed and configured.
    # The requested target is different. It always runs so `teeup install X`
    # repairs X after a wrapper, binary or config was removed by hand.
    if [[ "$c" != "$target" ]] && state_done check "cap-$c"; then
      log "Already installed: $c (required by $target)"
      continue
    fi
    # Explicit, not left to `set -e`: cmd_lazy_run calls cmd_install inside an
    # `if`, which disables `set -e` for everything it runs, so a failure that
    # used to abort the process would otherwise let the loop carry on and mark
    # the target installed (I3). Returning here keeps both entry points on the
    # same rule -- a dependency that fails stops the install.
    cap_install_verbs "$c" || return 1
  done
}

cmd_configure() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: teeup configure <capability>"
  cap_exists "$target" || die "Unknown capability: $target"
  if cap_skipped "$target"; then
    die "$target is skipped on this machine (TEEUP_SKIP)"
  fi
  cap_run "$target" configure
}

# Every file a capability installs with copy_config_once goes back to what
# teeup ships. The capability's own configure does the work, with TEEUP_RESET
# naming it (lib/files.sh), so a file configure renders for this machine (zsh's
# home files, git's config) is rendered again rather than copied raw. Each
# replaced file is backed up and its diff printed; a backup of a file that was
# already the shipped version is dropped. A reset file carries the shipped
# colours, so the theme hooks run again afterwards, and the font hooks too.
cmd_reset() {
  local target="${1:-}" dir rc=0
  [[ -n "$target" ]] || die "Usage: teeup reset <capability>"
  cap_exists "$target" || die "Unknown capability: $target"
  if cap_skipped "$target"; then
    die "$target is skipped on this machine (TEEUP_SKIP)"
  fi
  dir="$(cap_dir "$target")"
  if [[ ! -d "$dir/config" && ! -d "$dir/home" ]]; then
    die "$target ships no config files to reset."
  fi
  if state_na check "cap-$target"; then
    die "$target is not applicable on this machine."
  fi
  state_done check "cap-$target" || die "$target is not installed. Install it with: teeup install $target"
  export TEEUP_RESET="$target"
  cap_run "$target" configure || rc=$?
  unset TEEUP_RESET
  if [[ $rc -ne 0 ]]; then
    die "Resetting $target failed; the backups made so far are next to their files."
  fi
  if [[ "$(theme_current)" != "none" ]]; then
    TEEUP_THEME_DIR="$TEEUP_STATE_DIR/current/theme"
    TEEUP_THEME_NAME="$(theme_current)"
    export TEEUP_THEME_DIR TEEUP_THEME_NAME
    cap_run_hooks theme-apply
  fi
  if [[ -s "$(font_file)" ]]; then
    TEEUP_FONT_FAMILY="$(font_current)"
    export TEEUP_FONT_FAMILY
    cap_run_hooks font-apply
  fi
  ok_unless_dry "Reset $target."
}

# teeup remove <capability>
# The inverse of `teeup install`, read from metadata. A capability that ships
# a remove script owns the machine state it set up (a LaunchAgent, recorded
# `defaults`, a hidutil mapping, a mise wrapper); that script runs first,
# while its tool is still installed, and then the casks and packages its
# metadata names are uninstalled. Configuration files stay where they are:
# they are the user's, and re-installing the capability could not bring them
# back. A lazy capability keeps its shim, so typing its command offers to
# install it again. A capability with neither a remove script nor any
# packages or casks (xcode-clt, package-manager before a wrapper capability
# like ai grows one) has nothing teeup can undo, so it dies rather than
# claim a removal that never happened.
cmd_remove() {
  local target="${1:-}" dependents="" name cask pkg failed=0 tier
  local has_remove=false pkgs casks_meta
  [[ -n "$target" ]] || die "Usage: teeup remove <capability>"
  cap_exists "$target" || die "Unknown capability: $target"
  if state_na check "cap-$target"; then
    die "$target is not applicable on this machine."
  fi
  state_done check "cap-$target" || die "$target is not installed here."
  for name in $(cap_list); do
    if [[ "$name" == "$target" ]]; then continue; fi
    if ! state_done check "cap-$name"; then continue; fi
    case " $(cap_meta_get "$name" requires) " in
      *" $target "*) dependents="$dependents $name" ;;
    esac
  done
  if [[ -n "$dependents" ]]; then
    die "$target is required by:$dependents. Remove those first, then $target."
  fi
  pkgs="$(cap_meta_get "$target" packages)"
  casks_meta="$(cap_meta_get "$target" casks)"
  [[ -f "$(cap_dir "$target")/remove" ]] && has_remove=true
  if [[ "$has_remove" != "true" && -z "$pkgs" && -z "$casks_meta" ]]; then
    die "$target ships no remove script and installs no packages or casks that teeup tracks, so teeup remove cannot undo it; $target is still marked installed."
  fi
  if [[ "$has_remove" == "true" ]]; then
    cap_run "$target" remove || die "$target's remove script failed; nothing was uninstalled."
    # cap_run turns the not-applicable exit into a success for every verb, so
    # a remove script that answered "this machine cannot have it" gets here
    # having undone nothing. Saying "Removed $target." after that would be a
    # claim about work that did not happen; the packages below are still
    # taken off, since metadata is the other half of a removal.
    if [[ "$TEEUP_CAP_NA" == "true" ]]; then
      warn "$target's remove script reported it is not applicable on this machine, so it undid nothing of its own."
    fi
  fi
  for cask in $casks_meta; do
    cask_uninstall "$cask" || failed=1
  done
  for pkg in $pkgs; do
    pkg_uninstall "$pkg" || failed=1
  done
  # Only clear the done marker once every cask and package is actually gone.
  # Clearing it after a failed uninstall would make a retry see the
  # capability as not installed, and the leftover software could then never
  # be removed: cmd_install would skip it ("Already installed") and
  # cmd_remove itself would refuse with "not installed here".
  if [[ $failed -eq 0 ]]; then
    # `|| true`: state_done warns for itself when the marker will not clear,
    # and the packages are already off by here -- aborting would leave the
    # user with no teeup message at all.
    state_done clear "cap-$target" || true
    # Defensive, and unreachable today: cmd_remove refuses a capability that
    # is marked not-applicable before it gets here, and a `remove` script that
    # answers not_applicable only trips cap_run's own temp sentinel -- the
    # state_na marker is written by cap_install_verbs, which removal does not
    # call. It stays so that a future path that can set the marker cannot
    # leave `teeup status` calling a removed capability "not applicable on
    # this machine" (R-7.3). Do not write a test for it: there is nothing it
    # could assert that would not be vacuous.
    state_na clear "cap-$target" || true
  else
    warn "Leaving $target marked installed since something above failed; fix it and run teeup remove $target again."
  fi
  if [[ -d "$(cap_dir "$target")/config" || -d "$(cap_dir "$target")/home" ]]; then
    log "Your configuration files for $target were left in place."
  fi
  tier="$(cap_meta_get "$target" tier)"
  if [[ "$tier" != "lazy" ]]; then
    log "$target is in the $tier tier, so the next ./bootstrap installs it again unless machines/<hostname>.conf sets TEEUP_SKIP."
  fi
  if [[ $failed -ne 0 ]]; then
    err "teeup remove $target finished, with the problems above."
    exit 1
  fi
  ok_unless_dry "Removed $target."
}

# _update_checkout -> 0 updated, 1 could not update, 2 must not update.
# Spec section 9's first line. A checkout with local changes is the one case
# that stops the whole update: running migrations and seventeen configures
# from a half-edited tree is how a debugging session becomes a broken Mac.
# Every other failure (offline, no upstream, a diverged branch) is a warning,
# because everything after this step works from the checkout already here.
_update_checkout() {
  # -e, not -d: a linked worktree's .git is a file (it points at the real
  # repository's .git/worktrees/<name>), not a directory. TEEUP_PATH is
  # whatever checkout is running teeup, worktree or plain clone either way,
  # and the tests below run this against that same checkout, so treating a
  # worktree as "not a git checkout" would both be wrong on a real machine
  # and make the tests depend on which kind of checkout happens to be on
  # disk.
  if [[ ! -e "$TEEUP_PATH/.git" ]]; then
    log "$TEEUP_PATH is not a git checkout; nothing to pull."
    return 0
  fi
  if ! have git; then
    warn "git is not installed, so $TEEUP_PATH was not updated."
    return 1
  fi
  if [[ -n "$(git -C "$TEEUP_PATH" status --porcelain 2>/dev/null)" ]]; then
    err "$TEEUP_PATH has uncommitted changes, so teeup update will not pull."
    err "Commit, stash or discard them, then run: teeup update"
    return 2
  fi
  if ! run_cmd git -C "$TEEUP_PATH" pull --ff-only; then
    warn "git pull --ff-only failed; continuing with the checkout as it is."
    return 1
  fi
  return 0
}

# teeup update [<capability>]
# Spec section 9. Every step is idempotent, so this is also the repair path
# for a bootstrap that stopped half way. Failures are collected rather than
# fatal and the exit status reports them, so one formula that will not build
# cannot cancel the theme or the configures. A capability marked state_na
# (not_applicable) is skipped rather than told to install something the
# machine cannot have (R-A2), and cap_run's TEEUP_CAP_NA is read after every
# configure, because a script can decide "not applicable" during this very
# run, not only at install time.
cmd_update() {
  local target="${1:-}" failed=0 name pkg cask rc=0 theme_done=false current_theme
  if [[ -n "$target" ]]; then
    cap_exists "$target" || die "Unknown capability: $target"
    if cap_skipped "$target"; then
      die "$target is skipped on this machine (TEEUP_SKIP)"
    fi
    if state_na check "cap-$target"; then
      log "$target is not applicable on this machine; skipping."
      exit 0
    fi
    state_done check "cap-$target" || die "$target is not installed. Install it with: teeup install $target"
    # Spec section 4: `update` is an optional member of the capability
    # contract and the metadata upgrade is its default. A capability that
    # ships one owns its upgrade completely, so the packages its metadata
    # names are left alone; `configure` runs either way, because the point of
    # both paths is a capability that works after a new version lands.
    if [[ -f "$(cap_dir "$target")/update" ]]; then
      cap_run "$target" update || { warn "$target's update script failed."; failed=1; }
    else
      for cask in $(cap_meta_get "$target" casks); do
        cask_upgrade "$cask" || failed=1
      done
      for pkg in $(cap_meta_get "$target" packages); do
        pkg_upgrade "$pkg" || failed=1
      done
    fi
    local na=false
    if cap_run "$target" configure; then
      [[ "$TEEUP_CAP_NA" == "true" ]] && na=true
    else
      warn "$target configure failed."
      failed=1
    fi
    hook_run post-update "$target"
    if [[ "$na" == "true" ]]; then
      # It was installed and has just answered "this machine cannot have me"
      # -- a Mac that moved from Homebrew to MacPorts, say. Make the same
      # done-to-NA move cap_install_verbs makes, or `teeup has` and
      # `teeup status` go on calling it installed and every future update
      # runs its configure again instead of skipping it.
      state_done clear "cap-$target" || true
      state_na mark "cap-$target"
      log "$target is not applicable on this machine; skipping."
      return 0
    fi
    if [[ $failed -ne 0 ]]; then
      err "teeup update $target finished, with the problems above."
      exit 1
    fi
    ok_unless_dry "Updated $target."
    return 0
  fi

  _update_checkout || rc=$?
  if [[ $rc -eq 2 ]]; then exit 1; fi
  if [[ $rc -ne 0 ]]; then failed=1; fi

  pkg_update || { warn "$(pkg_backend_label) could not refresh its index."; failed=1; }
  pkg_upgrade_all || { warn "$(pkg_backend_label) could not upgrade everything."; failed=1; }
  mise_upgrade || failed=1

  # After the upgrades, before the configures. A migration exists to adjust a
  # config for a NEW version of a tool, so it has to see the version this
  # update just installed -- running it first deadlocks the update on a
  # machine whose old binary rejects the new config: the migration's refresh
  # validates against the binary still installed, fails, and the exit below
  # stops the update before the upgrade that would have fixed it. Every time.
  # (Concretely: the migration that moves aerospace.toml to config-version 2,
  # which capabilities/aerospace/configure asks the running AeroSpace to
  # validate.) Still ahead of the configure loop, because a later migration is
  # written against the state an earlier one leaves and a configure must never
  # run on top of a migration that has not been applied.
  migrations_run_pending || exit 1

  # core.list only (spec section 9). A capability this machine never installed
  # has no configuration to re-run, and a lazy capability's configure can
  # start a VM.
  for name in $(cap_tier_list core); do
    if ! cap_exists "$name"; then
      warn "$name is listed in core.list but not implemented yet; skipping."
      continue
    fi
    if cap_skipped "$name"; then
      log "Skipping $name (TEEUP_SKIP)"
      continue
    fi
    if state_na check "cap-$name"; then
      log "$name is not applicable on this machine; skipping."
      continue
    fi
    if ! state_done check "cap-$name"; then
      log "$name has never been installed here; run: teeup install $name"
      continue
    fi
    if cap_run "$name" configure; then
      if [[ "$TEEUP_CAP_NA" == "true" ]]; then
        # Same transition as the single-capability path above.
        state_done clear "cap-$name" || true
        state_na mark "cap-$name"
        log "$name is not applicable on this machine any more; it is no longer marked installed."
      fi
      if [[ "$name" == "theme" && "$TEEUP_CAP_NA" != "true" ]]; then theme_done=true; fi
    else
      warn "$name configure failed; continuing."
      failed=1
    fi
  done

  # The theme capability's configure already renders every template, so this
  # only covers a run where it did not happen (skipped, not installed, or the
  # theme capability's own configure answered not-applicable).
  if [[ "$theme_done" != "true" ]]; then
    current_theme="$(theme_current)"
    if [[ "$current_theme" == "none" ]]; then
      log "No theme recorded yet; pick one with: teeup theme set <name>"
    elif ! theme_set "$current_theme"; then
      warn "Could not regenerate the $current_theme theme."
      failed=1
    fi
  fi

  hook_run post-update
  if [[ $failed -ne 0 ]]; then
    err "teeup update finished, with the problems above."
    exit 1
  fi
  ok_unless_dry "teeup is up to date."
}

cmd_theme() {
  local op="${1:-current}" pinned
  [[ $# -gt 0 ]] && shift
  case "$op" in
    set)
      # With no name, ask. This is what the menu's Theme row runs, so the
      # list always covers whatever themes/ holds today, including any a
      # later phase adds. Backing out of the picker leaves the current theme
      # alone and is not an error.
      if [[ -z "${1:-}" ]]; then
        menu_validate_picker_env
        local names name
        names=()
        while IFS= read -r name; do
          names[${#names[@]}]="$name"
        done < <(theme_list)
        # bash 3.2 under `set -u` treats the expansion of an EMPTY array as
        # an unbound variable, so the count is checked before "${names[@]}".
        if [[ ${#names[@]} -eq 0 ]]; then
          die "No themes found. Look in $TEEUP_PATH/themes and $TEEUP_CONFIG_DIR/themes."
        fi
        set -- "$(menu_pick "Theme" "${names[@]}")" || true
        if [[ -z "${1:-}" ]]; then
          log "Keeping the current theme: $(theme_current)"
          return 0
        fi
      fi
      [[ -n "${1:-}" ]] || die "Usage: teeup theme set <name>"
      # A name typed here is strict. theme_set's catppuccin fallback exists for
      # configure reading a stale answer during bootstrap; on the command line a
      # typo would silently replace the theme that was working.
      if ! theme_dir "$1" >/dev/null; then
        echo "Available themes:" >&2
        theme_list | sed 's/^/  /' >&2
        exit 1
      fi
      theme_set "$1"
      # Remembered, so the next ./bootstrap or teeup configure theme keeps it.
      answers_set TEEUP_THEME "$1"
      if pinned="$(machine_get TEEUP_THEME)" && [[ "${pinned:-$TEEUP_THEME_FALLBACK}" != "$1" ]]; then
        warn "$(machine_file) pins TEEUP_THEME=${pinned:-$TEEUP_THEME_FALLBACK}; the next ./bootstrap or teeup configure theme will switch back to it."
      fi
      ;;
    list) theme_list ;;
    current) theme_current ;;
    *) die "Usage: teeup theme set|list|current" ;;
  esac
}

cmd_list() {
  local tier_filter="" name tier
  case "${1:-}" in
    "") ;;
    --tier)
      tier_filter="${2:-}"
      [[ -n "$tier_filter" ]] || die "Usage: teeup list [--tier core|daily|lazy]"
      case "$tier_filter" in
        core|daily|lazy) ;;
        *) die "Unknown tier '$tier_filter' (expected core, daily or lazy)" ;;
      esac
      ;;
    *) die "Usage: teeup list [--tier core|daily|lazy]" ;;
  esac
  # The catalogue below is machine-independent: `launch:` names the app a
  # capability's apps= promises, not one this machine has been confirmed to
  # be able to install (M7) -- on a MacPorts Mac several casks have no
  # MacPorts equivalent at all (`teeup status` and `teeup launch` say so
  # plainly once you act on one).
  if ! casks_supported; then
    log "This is a MacPorts machine: a lazy capability's 'launch:' route below assumes a Homebrew cask; teeup status and teeup launch say plainly when there is no MacPorts equivalent."
  fi
  for name in $(cap_list); do
    tier="$(cap_meta_get "$name" tier)"
    [[ -z "$tier_filter" || "$tier" == "$tier_filter" ]] || continue
    printf '%-18s %-6s %s%s\n' "$name" "$tier" "$(cap_meta_get "$name" summary)" "$(cap_list_via "$name")"
  done
}

# The lazy column: how a lazy capability is reached, since nothing installs
# it at bootstrap. Commands come from provides= (they have shims), an app
# from apps= (it has `teeup launch`); a capability can have both (a cask that
# links a command, like vscode's `code`), and one with neither is reached by
# `teeup install` alone.
cap_list_via() {
  local name="$1" tier provides app via=""
  tier="$(cap_meta_get "$name" tier)"
  [[ "$tier" == "lazy" ]] || return 0
  provides="$(cap_meta_get "$name" provides)"
  app="$(cap_apps "$name" | head -1)"
  [[ -z "$provides" ]] || via="on first: $provides"
  [[ -z "$app" ]] || via="${via:+$via; }launch: $app"
  printf '  [%s]' "${via:-teeup install $name}"
}

# What every lazy shim runs (lib/lazy.sh writes them). A real binary anywhere
# on PATH other than the shims directory wins outright; the package manager's
# bin directories are added first, because a shim fires whenever the calling
# shell's PATH lacks the command, and a stripped environment (an editor's
# process runner, a script run with `env -i`) can lack /opt/homebrew/bin
# while the tool is already installed there. Otherwise the capability is
# installed, on a terminal and after a yes, and the real binary is exec'd
# with the original arguments. A capability already marked installed whose
# command has gone missing (uninstalled by hand) gets the same question: its
# install is idempotent and puts the command back. Exit 127 is "command not
# found" for every path that ends without running the command, so a script
# that hit the shim fails the way it would have without teeup, with a hint.
cmd_lazy_run() {
  local cap="${1:-}" command="${2:-}" real p found=false
  if [[ -z "$cap" || -z "$command" ]]; then
    die "Usage: teeup lazy-run <capability> <command> [args...]"
  fi
  shift 2
  cap_exists "$cap" || die "Unknown capability: $cap"
  for p in $(cap_meta_get "$cap" provides); do
    if [[ "$p" == "$command" ]]; then found=true; fi
  done
  [[ "$found" == "true" ]] || die "$cap does not provide $command"
  pkg_backend_path
  if real="$(lazy_real_command "$command")"; then
    exec "$real" "$@"
  fi
  if cap_skipped "$cap"; then
    err "$command is provided by capability $cap, which is skipped on this machine (TEEUP_SKIP)."
    exit 127
  fi
  if ! lazy_is_tty; then
    err "$command is not installed. It is provided by capability $cap; run: teeup install $cap"
    exit 127
  fi
  if ! ui_confirm "$command is provided by capability $cap. Install now?" yes; then
    err "Not installed. When you want it: teeup install $cap"
    exit 127
  fi
  # Declines and previews create no log. Once a real install has been approved,
  # every cap_run bracket and capability line goes to the lazy transcript. An
  # explicit TEEUP_LOG_FILE remains authoritative for a diagnostic invocation.
  if [[ "$DRY_RUN" != "true" && -z "$TEEUP_LOG_FILE" ]]; then
    TEEUP_LOG_FILE="$TEEUP_STATE_DIR/logs/lazy.log"
    export TEEUP_LOG_FILE
  fi
  # A real install failure must reach the shim contract's 127 ("the command
  # still is not here"), not abort the process at this line under `set -e`
  # with cap_run's generic failure text and nothing teeup-authored (M2).
  if ! cmd_install "$cap"; then
    err "$cap could not be installed, so $command is still not available. The output above says why."
    exit 127
  fi
  if state_na check "cap-$cap"; then
    err "$cap is not applicable on this machine; $command was not installed."
    exit 127
  fi
  if [[ "$DRY_RUN" == "true" ]]; then
    log "Dry run: $command was not installed, so it was not run."
    exit 0
  fi
  if real="$(lazy_real_command "$command")"; then
    exec "$real" "$@"
  fi
  err "$cap is installed but $command is still not on PATH. Open a new terminal and try again."
  exit 127
}

# `open -a` launches the app, or brings it to the front when it is already
# running, so one call covers Omarchy's launch-or-focus. A missing app means
# its capability's cask is not installed yet: install it, then open. The
# arguments are joined, so `teeup launch Google Chrome` needs no quotes. A
# GUI-only capability (apps= and no provides=, like 3a's chrome) is reached
# only this way and through `teeup install`.
cmd_launch() {
  local target="$*" cap app
  [[ -n "$target" ]] || die "Usage: teeup launch <app|capability>"
  cap="$(launch_resolve "$target")" || exit 1
  # The app the user actually named, when they named one (M6): a capability
  # with more than one apps= entry must not always open the first regardless
  # of which one was asked for. Naming the capability itself falls back to
  # the first app, same as before.
  app="$(app_match_in_cap "$cap" "$target")" || app="$(cap_apps "$cap" | head -1)"
  if app_installed "$app"; then
    log "Opening $app"
  else
    if cap_skipped "$cap"; then
      die "$cap is skipped on this machine (TEEUP_SKIP); install $app by hand."
    fi
    log "$app is not installed; installing $cap first."
    # A genuine install failure must reach a teeup-authored message, not
    # `set -e` aborting here with cap_run's generic "Failed: X install" and
    # nothing explaining what that means for `teeup launch` (M9, the same
    # asymmetry I3/M2 removed from teeup lazy-run).
    if ! cmd_install "$cap"; then
      die "$cap could not be installed, so $app is still not available. The output above says why."
    fi
    if state_na check "cap-$cap"; then
      die "$cap is not applicable on this machine; $app was not installed."
    fi
    if [[ "$DRY_RUN" != "true" ]] && ! app_installed "$app"; then
      die "$app is still not in $(app_search_dirs) after installing $cap. Install it by hand, then run: teeup launch $target"
    fi
  fi
  run_cmd open -a "$app"
}

# _config_keys -> every TEEUP_* key either file names, sorted, once each.
# The machine file is included, so a key that exists only as a pin is still
# listed rather than being invisible until something breaks. Accepts a plain
# KEY="value" line (what answers_set writes) or an `export KEY=value` line
# (what a hand-written machine file may use), since machine_file's whole
# reason to exist is a file nobody but a person ever writes.
_config_keys() {
  local f
  for f in "$(answers_file)" "$(machine_file)"; do
    [[ -f "$f" ]] || continue
    sed -n \
      -e 's/^\(TEEUP_[A-Z0-9_]*\)=.*/\1/p' \
      -e 's/^export[[:space:]][[:space:]]*\(TEEUP_[A-Z0-9_]*\)=.*/\1/p' \
      "$f"
  done | sort -u
}

# _config_key_known <KEY> -> true when KEY is named by the answers file or
# the machine file (R7.2): teeup config get must never present a runtime
# variable (TEEUP_PATH, TEEUP_CAPS_DIR, ...) as though it were an answer.
_config_key_known() {
  local key="$1" k
  for k in $(_config_keys); do
    if [[ "$k" == "$key" ]]; then
      return 0
    fi
  done
  return 1
}

# _config_machine_edit_target -> the machine file to tell a user to edit.
# machine_file() itself when it already exists, whichever of the two that
# is; the personal overlay under TEEUP_CONFIG_DIR when neither exists yet.
# machine_file()'s own fallback names the checkout's machines/<host>.conf,
# which is not what R7.1 asked for: a user is told to edit their own
# overlay, never the checkout, even before that overlay file exists.
_config_machine_edit_target() {
  local f
  f="$(machine_file)"
  if [[ -f "$f" ]]; then
    printf '%s\n' "$f"
  else
    printf '%s/machines/%s.conf\n' "$TEEUP_CONFIG_DIR" "$(hostname -s 2>/dev/null || hostname)"
  fi
}

# _config_edit_error <file> -> prints why <file> would be unsafe to keep as
# the answers file, or nothing when it is fine. Two gates: every live line
# must have the shape answers_set itself writes -- KEY="value" or a bare
# KEY=value with no spaces -- because bash -n alone accepts
# `TEEUP_NAME=Ada Lovelace`, which is valid shell that *runs* Lovelace as a
# command every time answers_load sources the file (R7.4); bash -n then
# catches anything the shape check cannot see (unbalanced parens in a bare
# value, ...).
#
# The quoted form must accept exactly what answers_set (lib/answers.sh)
# itself writes, or every answer that has ever contained a quote breaks
# `teeup config edit` for good: answers_set backslash-escapes ", \, $ and `
# in the value, so the content between the quotes here is any run of chars
# that are none of those four, or one of those four preceded by a backslash.
# An UNescaped ", $ or ` inside the quotes is exactly what would let the
# line run a command when answers_load sources it, so it is refused, not
# waved through because bash -n alone finds it syntactically valid.
#
# Output is tagged shape:... or syntax:... so the caller can say which gate
# failed -- a shape failure is a file bash would parse just fine, so calling
# it unparseable would be a lie.
_config_edit_error() {
  local f="$1" line lineno=0 quoted_pat bare_pat syntax_error
  quoted_pat='^TEEUP_[A-Z0-9_]+="([^"\$`]|\\[\"$`])*"$'
  bare_pat='^TEEUP_[A-Z0-9_]+=[A-Za-z0-9_.,:/@%+=-]*$'
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    if [[ "$line" =~ ^[[:space:]]*$ ]]; then continue; fi
    if [[ "$line" =~ ^[[:space:]]*# ]]; then continue; fi
    if [[ "$line" =~ $quoted_pat ]]; then continue; fi
    if [[ "$line" =~ $bare_pat ]]; then continue; fi
    printf 'shape:line %d does not read KEY="value": %s\n' "$lineno" "$line"
    return 0
  done < "$f"
  syntax_error="$(bash -n "$f" 2>&1)"
  if [[ -n "$syntax_error" ]]; then
    printf 'syntax:%s\n' "$syntax_error"
  fi
  return 0
}

# teeup config get [<KEY>] | set <KEY> <value> | edit
# Over the answers file only (spec section 7). answers_load has already
# layered machines/<hostname>.conf on top, so `get` prints what the rest of
# teeup will actually see. `set` writes the answers file and never the
# machine file -- and says so when the machine file is about to make the
# write pointless, because that is the one thing about this precedence that
# is impossible to notice on your own.
cmd_config() {
  local op="${1:-}" key value f pinned editor backup parse_error
  local host user_machine repo_machine
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$op" in
    get)
      key="${1:-}"
      if [[ -n "$key" ]]; then
        if [[ "$key" =~ ^TEEUP_[A-Z0-9_]+$ ]] && _config_key_known "$key"; then
          case "$key" in
            # work_get (lib/answers.sh) never reads the answers file, only
            # machines/<hostname>.conf -- so this has to match it, or a
            # leftover answers-file TEEUP_WORK_* value reads as live (I3).
            TEEUP_WORK_*) printf '%s\n' "$(work_get "$key")" ;;
            *) printf '%s\n' "${!key:-}" ;;
          esac
          return 0
        fi
        die "No answer named $key. List what there is with: teeup config get"
      fi
      f="$(answers_file)"
      if answers_exist; then
        echo "Answers: $f"
      else
        echo "Answers: $f (the wizard has not run here; ./bootstrap writes it)"
      fi
      # Name both machine files when both exist (R7.6): the generic
      # shadowed-machine-file notice from answers_load lands on stderr, and
      # this header is the one place that says so on stdout, where a user
      # reading `teeup config get` will actually see it.
      host="$(hostname -s 2>/dev/null || hostname)"
      user_machine="$TEEUP_CONFIG_DIR/machines/$host.conf"
      repo_machine="$TEEUP_MACHINES_DIR/$host.conf"
      if [[ -f "$user_machine" && -f "$repo_machine" && "$user_machine" != "$repo_machine" ]]; then
        echo "Machine: $user_machine  (sourced last, so it wins; $repo_machine also exists and is ignored)"
      elif [[ -f "$(machine_file)" ]]; then
        echo "Machine: $(machine_file)  (sourced last, so it wins)"
      fi
      for key in $(_config_keys); do
        case "$key" in
          # A TEEUP_WORK_* key in _config_keys can only have come from the
          # answers file or the machine file (that is everywhere _config_keys
          # looks); work_get reads only the machine file, so whichever this
          # is, the listing has to say what teeup will actually use, not the
          # raw sourced value (I3).
          TEEUP_WORK_*)
            if machine_get "$key" >/dev/null; then
              printf '  %-26s %s   [pinned by %s]\n' "$key" "$(work_get "$key")" "$(basename "$(machine_file)")"
            else
              printf '  %-26s %s   (ignored: work settings are read from the machine file only)\n' "$key" "${!key:-}"
            fi
            ;;
          *)
            if machine_get "$key" >/dev/null; then
              printf '  %-26s %s   [pinned by %s]\n' "$key" "${!key:-}" "$(basename "$(machine_file)")"
            else
              printf '  %-26s %s\n' "$key" "${!key:-}"
            fi
            ;;
        esac
      done
      ;;
    set)
      if [[ $# -lt 2 ]]; then
        die "Usage: teeup config set <KEY> <value>"
      fi
      key="$1"
      shift
      # Joined, so `teeup config set TEEUP_NAME Ada Lovelace` needs no quotes.
      value="$*"
      # Checked before anything else touches $key with `${!key}` or
      # machine_get (R7.2): an invalid variable name there is a raw bash
      # "bad substitution" error, not a teeup message.
      if ! [[ "$key" =~ ^TEEUP_[A-Z0-9_]+$ ]]; then
        die "Key must look like TEEUP_NAME, got '$key'. teeup config only changes TEEUP_* answers."
      fi
      case "$key" in
        TEEUP_WORK_*)
          die "$key is a work identity setting; work_get reads it from machines/<hostname>.conf only, never the answers file, so writing it here would change nothing. Edit $(_config_machine_edit_target) instead (copy $TEEUP_PATH/machines/example.conf.sample for the shape)."
          ;;
      esac
      if [[ "$key" == "TEEUP_PACKAGE_MANAGER" ]] && state_done check "cap-package-manager"; then
        die "$key picks which package manager teeup drives, and package-manager is already installed on this Mac; teeup config cannot switch that safely after the fact. Run teeup remove package-manager first, or edit $(machine_file) to pin it."
      fi
      if pinned="$(machine_get "$key")"; then
        if [[ "$pinned" != "$value" ]]; then
          warn "$(machine_file) pins $key=${pinned:-<empty>}, which is sourced after the answers file, so this write will have no effect until that line changes."
        fi
      fi
      # answers_set validates the key shape and refuses a newline in the value.
      answers_set "$key" "$value"
      ok_unless_dry "Set $key in $(answers_file)"
      # R7.5: name the one command that actually applies the change. Nothing
      # here re-reads $key elsewhere, so this list is deliberately narrow --
      # only the answers the wizard itself writes.
      if [[ "$DRY_RUN" != "true" ]]; then
        case "$key" in
          TEEUP_NAME|TEEUP_EMAIL) log "Run: teeup configure git -- that is what reads $key." ;;
          TEEUP_EMACS_FLAVOR) log "Run: teeup configure emacs -- that is what reads $key." ;;
          TEEUP_DAILY) log "Run: ./bootstrap -- that is what reads $key." ;;
          TEEUP_THEME) log "Run: teeup theme set $value -- it validates the name and re-renders every themed tool, which this write alone does not." ;;
          TEEUP_PACKAGE_MANAGER) warn "$key only takes effect the next time ./bootstrap or teeup install package-manager runs; nothing on this machine changed yet." ;;
          *) warn "$key is not one of the answers ./bootstrap writes (TEEUP_NAME, TEEUP_EMAIL, TEEUP_EMACS_FLAVOR, TEEUP_DAILY, TEEUP_PACKAGE_MANAGER, TEEUP_THEME); teeup config cannot say what, if anything, reads it." ;;
        esac
      fi
      ;;
    edit)
      f="$(answers_file)"
      editor="${VISUAL:-${EDITOR:-vi}}"
      if [[ "$DRY_RUN" == "true" ]]; then
        printf "%b %s\n" "🔍" "[DRY-RUN] Would open $editor on $f"
        return 0
      fi
      if [[ ! -f "$f" ]]; then
        mkdir -p "$(dirname "$f")"
        : > "$f"
        chmod 600 "$f"
      fi
      backup="$(mktemp)"
      cp "$f" "$backup"
      # Run through `bash -c` with the path as $1, so an EDITOR that carries
      # flags ("code -w", "emacsclient -t") works and a path with spaces or
      # metacharacters in it is still one argument.
      if ! run_cmd bash -c "$editor \"\$1\"" bash "$f"; then
        cp "$backup" "$f"
        chmod 600 "$f"
        rm -f "$backup"
        die "$editor did not finish; $f is unchanged."
      fi
      # teeup sources this file at the start of every command, so a syntax
      # error -- or a line that merely *looks* like an assignment -- breaks
      # every verb including the one that would fix it.
      parse_error="$(_config_edit_error "$f")"
      if [[ -z "$parse_error" ]]; then
        chmod 600 "$f"
        rm -f "$backup"
        ok "Saved $f"
      else
        cp "$backup" "$f"
        chmod 600 "$f"
        rm -f "$backup"
        # A shape failure is a file bash would source without a syntax
        # complaint at all -- the danger is what it would run, not that it
        # fails to parse -- so it gets its own wording rather than the
        # "would not parse" text that only fits a real bash -n failure.
        case "$parse_error" in
          shape:*)
            die "The edited $f was rolled back: ${parse_error#shape:}. Every line has to read KEY=\"value\", with any \", \\, \$ or \` inside the value backslash-escaped."
            ;;
          syntax:*)
            die "The edited $f would not parse as shell, so your edit was rolled back. Every line has to read KEY=\"value\". (${parse_error#syntax:})"
            ;;
          *)
            die "The edited $f was rolled back. Every line has to read KEY=\"value\". ($parse_error)"
            ;;
        esac
      fi
      ;;
    *) die "Usage: teeup config get [<KEY>] | set <KEY> <value> | edit" ;;
  esac
}

# _menu_parent <id> -> the id with its last dotted segment removed, or
# nothing at the top level.
_menu_parent() {
  local id="$1" parent
  parent="${id%.*}"
  if [[ "$parent" != "$id" ]]; then
    printf '%s\n' "$parent"
  fi
}

# _menu_loop <cache> <route>
# Iterative, not recursive: bash 3.2 has no tail calls and a menu is a walk,
# not a stack. Arrays are indexed by hand throughout, and "${labels[@]}" is
# only ever expanded after the count has been checked, because bash 3.2 under
# `set -u` treats the expansion of an EMPTY array as an unbound variable.
_menu_loop() {
  local cache="$1" current="$2" id chosen action title i
  local rows labels
  if [[ -n "$current" ]] && ! menu_ids "$cache" | grep -qxF "$current"; then
    err "No menu row with the id '$current'."
    return 1
  fi
  # M2: a route straight to a leaf (`teeup menu style.theme`, matching the
  # `omarchy menu summon style.theme` example in cmd_menu's own comment) runs
  # that row's action outright, rather than falling into the loop below,
  # which only ever lists CHILDREN of $current and would report a leaf's
  # empty child list as "Nothing left to show".
  if [[ -n "$current" ]]; then
    action="$(menu_field "$cache" "$current" action)"
    if [[ -n "$action" ]]; then
      menu_run "$action"
      return $?
    fi
  fi
  while :; do
    rows=()
    labels=()
    for id in $(menu_children "$cache" "$current"); do
      if menu_visible "$cache" "$id"; then
        rows[${#rows[@]}]="$id"
        labels[${#labels[@]}]="$(menu_label "$cache" "$id")"
      fi
    done
    if [[ ${#rows[@]} -eq 0 ]]; then
      if [[ -z "$current" ]]; then
        err "Every row in the menu is hidden by its own 'when' condition."
        return 1
      fi
      warn "Nothing left to show under $current."
      current="$(_menu_parent "$current")"
      continue
    fi
    if [[ -n "$current" ]]; then
      rows[${#rows[@]}]=".."
      labels[${#labels[@]}]=".."
    fi
    title="$(menu_field "$cache" "$current" title)"
    if [[ -z "$title" ]]; then
      if [[ -n "$current" ]]; then
        title="$(menu_label "$cache" "$current")"
      else
        title="teeup"
      fi
    fi
    # Cancelling is how you leave a submenu: it goes back one level, exactly
    # like choosing "..". Only a cancel at the top level actually ends the
    # menu, which is what makes leaving it a deliberate, separate step rather
    # than a single stray keypress from anywhere in the tree.
    if ! chosen="$(menu_pick "$title" "${labels[@]}")"; then
      if [[ -z "$current" ]]; then
        return 0
      fi
      current="$(_menu_parent "$current")"
      continue
    fi
    id=""
    i=0
    while [[ $i -lt ${#labels[@]} ]]; do
      if [[ "${labels[$i]}" == "$chosen" ]]; then
        id="${rows[$i]}"
        break
      fi
      i=$((i + 1))
    done
    if [[ -z "$id" ]]; then
      warn "Unknown choice: $chosen"
      continue
    fi
    if [[ "$id" == ".." ]]; then
      current="$(_menu_parent "$current")"
      continue
    fi
    action="$(menu_field "$cache" "$id" action)"
    if [[ -n "$action" ]]; then
      menu_run "$action"
      return $?
    fi
    current="$id"
  done
}

# teeup menu [<id>]
# The whole of teeup as a list (spec section 2: Omarchy's menu, translated to
# a TUI). An optional id opens straight at that row, the way `omarchy menu
# summon style.theme` does.
cmd_menu() {
  local route="${1:-}" cache rc=0
  menu_validate_picker_env
  cache="$(menu_cache)" || exit 1
  # The path, not the variable name, goes in the trap: "cache" is local to
  # this function, so a trap that looked it up by name at fire time would
  # find nothing left once cmd_menu has returned, and die of its own
  # `set -u` on the script's own exit -- long after the interrupted run this
  # trap exists to clean up after.
  # shellcheck disable=SC2064  # deliberate: "cache" is local, so a
  # single-quoted trap that looked it up by name would find nothing at the
  # script's own exit, once cmd_menu has already returned.
  trap "rm -f $(printf '%q' "$cache")" EXIT
  _menu_loop "$cache" "$route" || rc=$?
  rm -f "$cache"
  return $rc
}

# teeup doctor [<capability>]
# Exit 0 when healthy: the spec's release gate is "a real bootstrap on a
# clean macOS VM, then teeup doctor must exit 0". With no argument it checks
# what this machine has installed; with one it checks that capability whether
# or not it is installed, because "why is this not working" gets asked about
# things that did not install properly in the first place.
#
# The exit status is whatever doctor_summary (lib/doctor.sh) decides from the
# report: 0 only when every check reached a verdict and none found a
# problem, 1 when at least one did, 2 when nothing is confirmed broken but
# something material could not be checked at all -- see lib/doctor.sh's
# header comment for the full convention. This function does not re-decide
# any of that; it only collects into the report and returns what the summary
# says.
cmd_doctor() {
  local target="${1:-}" report targets name rc=0 checked=true
  report="$(mktemp)"
  TEEUP_DOCTOR_REPORT="$report"
  export TEEUP_DOCTOR_REPORT
  if [[ -n "$target" ]]; then
    if ! cap_exists "$target"; then
      rm -f "$report"
      die "Unknown capability: $target"
    fi
    doctor_run_one "$target"
  elif ! doctor_state_readable; then
    # A done/ teeup cannot read or search makes every state_done lookup
    # below answer "no" for a reason that has nothing to do with what is
    # installed (B4) -- report that directly instead of falling through to
    # "nothing is marked installed here".
    doctor_report_state_unreadable
  else
    targets="$(doctor_targets)"
    if [[ -z "$targets" ]]; then
      checked=false
      # "Nothing installed" and "everything installed is skipped on this
      # machine" are different facts, and saying the first when the second is
      # true sends the user to ./bootstrap over a machine that is set up
      # exactly as its machine file asks.
      if doctor_installed_any; then
        warn "Every installed capability is skipped on this machine (TEEUP_SKIP), so there was nothing to check."
        warn "Check one anyway by naming it: teeup doctor <capability>"
      else
        warn "No capability is marked installed here. Run ./bootstrap, or name one: teeup doctor <capability>"
      fi
    fi
    for name in $targets; do
      doctor_run_one "$name"
    done
  fi
  doctor_summary "$report" "$checked" || rc=$?
  rm -f "$report"
  return $rc
}

cmd_has() {
  [[ -n "${1:-}" ]] || die "Usage: teeup has <capability>"
  state_done check "cap-$1"
}

# Secrets live in the login Keychain under the service name "teeup"; nothing
# secret ever reaches the repo, the answers file or a log. `set` is the one
# mutation in teeup that does not go through run_cmd: run_cmd echoes its whole
# argument list in dry run, and the value must not appear there.
cmd_secret() {
  local op="${1:-}" name="${2:-}" value
  case "$op" in
    get|set|rm) ;;
    *) die "Usage: teeup secret get|set|rm <name>" ;;
  esac
  [[ -n "$name" ]] || die "Usage: teeup secret get|set|rm <name>"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "Secret names use letters, digits, dot, underscore and dash, and cannot start with a dash"
  have security || die "teeup secret needs macOS's security command."
  case "$op" in
    get)
      security find-generic-password -s teeup -a "$name" -w 2>/dev/null ||
        die "No secret named '$name'. Store one with: teeup secret set $name"
      ;;
    set)
      if [[ "$DRY_RUN" == "true" ]]; then
        printf "%b %s\n" "🔍" "[DRY-RUN] Would execute: security add-generic-password -U -s teeup -a $name -w <value>"
        return 0
      fi
      local was_x=0 quoted_name quoted_value store_rc
      case $- in *x*) was_x=1;; esac
      set +x 2>/dev/null
      value="$(ui_secret "Value for $name")"
      [[ -n "$value" ]] || die "Refusing to store an empty value for '$name'."
      # macOS does not hide other users' argv from ps, so the value must never
      # be a command-line argument (that would defeat the one command whose
      # whole purpose is keeping secrets out of sight). Feed the whole
      # command to `security -i` on stdin instead; both fields are quoted for
      # security's own command parser, which accepts a double-quoted string
      # with backslash-escaped \ and ".
      quoted_name="$(printf '"%s"' "$(printf '%s' "$name" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')")"
      quoted_value="$(printf '"%s"' "$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')")"
      printf 'add-generic-password -a %s -s teeup -U -w %s\n' "$quoted_name" "$quoted_value" |
        security -i >/dev/null
      store_rc=$?
      [[ $was_x == 1 ]] && set -x 2>/dev/null
      [[ $store_rc -eq 0 ]] || die "Could not store '$name' in the Keychain."
      ok "Stored $name in the Keychain (service: teeup)"
      ;;
    rm)
      # No >/dev/null here: that would swallow run_cmd's own dry-run line.
      if ! run_cmd security delete-generic-password -s teeup -a "$name"; then
        die "No secret named '$name'."
      fi
      ok "Removed $name from the Keychain"
      ;;
  esac
}

cmd_status() {
  local total=0 installed=0 unsupported=0 name tier shims="" f envs
  echo "teeup $(cat "$TEEUP_PATH/version" 2>/dev/null || echo dev) at $TEEUP_PATH"
  echo "Package manager: $(pkg_backend)"
  if answers_exist; then echo "Answers: $(answers_file)"; else echo "Answers: missing (run ./bootstrap)"; fi
  for name in $(cap_list); do
    total=$((total + 1))
    tier="$(cap_meta_get "$name" tier)"
    if state_done check "cap-$name"; then
      installed=$((installed + 1))
      printf '  %-18s installed (%s)\n' "$name" "$tier"
    elif state_na check "cap-$name"; then
      unsupported=$((unsupported + 1))
      printf '  %-18s not applicable on this machine\n' "$name"
    fi
  done
  echo "Installed: $installed of $total capabilities"
  [[ "$unsupported" -gt 0 ]] && echo "Not applicable on this machine: $unsupported"
  # What the lazy machinery has in place: the shims the shell will fall back
  # to, and the runtimes `teeup install dev-env` has set up.
  for f in "$(shims_dir)"/*; do
    [[ -x "$f" ]] || continue
    shims="$shims ${f##*/}"
  done
  echo "Lazy shims:${shims:- none (run: teeup configure teeup-runtime)}"
  envs="$(dev_env_installed | tr '\n' ' ')"
  echo "Dev envs: ${envs:-none (teeup install dev-env <python|node|java|ruby|rust|go>)}"
  return 0
}

# Developer verbs, for people changing teeup itself. Each subcommand is one
# case arm; the scaffold writes into the checkout (TEEUP_MIGRATIONS_DIR).
cmd_dev() {
  local op="${1:-}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$op" in
    add-migration) migration_new ;;
    new-capability) dev_new_capability "$@" ;;
    check) dev_check "$@" ;;
    *) die "Usage: teeup dev add-migration | new-capability <name> | check [<capability>]" ;;
  esac
}

cmd_commands() {
  case "${1:-}" in
    --check) cap_check ;;
    *) cap_list ;;
  esac
}

# `teeup migrate <target>` retires one of this teeup's predecessors on a
# machine that already had it (spec section 10). It takes a target rather than
# doing one fixed thing, so a later migration off something else needs no new
# verb; `legacy` is the only one today.
#
# Each step returns 1 when it REFUSED something rather than when it failed:
# the migration always runs to the end, and the exit status says whether
# anything was left alone. Nothing is ever lost -- every removal is of a file
# teeup itself generated, and every foreign file is moved to a
# .teeup_backup_<ts> copy beside it.
cmd_migrate() {
  local target="${1:-}" rc=0
  case "$target" in
    legacy) ;;
    "") die "Usage: teeup migrate legacy" ;;
    *) die "Unknown migration target '$target'. The only one is: legacy" ;;
  esac
  migrate_legacy_paths || rc=1
  migrate_disable_runtime_inits || rc=1
  migrate_chezmoi || rc=1
  echo ""
  if [[ "$DRY_RUN" == "true" ]]; then
    # A preview claims nothing: the steps above said what they would do, and
    # "finished, now run teeup update" only makes sense after a real run.
    # The exit status still reports a refusal a real run would hit.
    if [[ $rc -eq 0 ]]; then
      log "Dry run finished: nothing was changed. Run it again without DRY_RUN=true to migrate."
    else
      warn "Dry run finished: nothing was changed, and a real run would refuse to touch something above. Read the warnings first."
    fi
  elif [[ $rc -eq 0 ]]; then
    ok "Migration finished. Open a new terminal, then run: teeup update, then teeup doctor to see anything still left over"
  else
    err "Migration finished, but teeup refused to touch something above. Nothing was lost; read the warnings, then run: teeup doctor"
  fi
  return $rc
}

verb="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$verb" in
  install) cmd_install "$@" ;;
  configure) cmd_configure "$@" ;;
  reset) cmd_reset "$@" ;;
  update) cmd_update "$@" ;;
  remove) cmd_remove "$@" ;;
  theme) cmd_theme "$@" ;;
  list) cmd_list "$@" ;;
  launch) cmd_launch "$@" ;;
  lazy-run) cmd_lazy_run "$@" ;;
  menu) cmd_menu "$@" ;;
  doctor) cmd_doctor "$@" ;;
  config) cmd_config "$@" ;;
  has) cmd_has "$@" ;;
  secret) cmd_secret "$@" ;;
  status) cmd_status ;;
  commands) cmd_commands "$@" ;;
  dev) cmd_dev "$@" ;;
  migrate) cmd_migrate "$@" ;;
  version) cat "$TEEUP_PATH/version" 2>/dev/null || echo dev ;;
  help|-h|--help) usage ;;
  *)
    err "Unknown verb: $verb"
    usage >&2
    exit 2
    ;;
esac
