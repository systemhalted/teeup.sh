#!/usr/bin/env bash
# Raycast keeps its own settings, so there is nothing to ship. The script says
# whether the app is in place. app_installed also looks in ~/Applications,
# where a cask can install, so a Raycast there counts on a MacPorts Mac too.
app="Raycast"
if app_installed "$app"; then
  log "$app is installed; open it with: open -a '$app'"
elif ! casks_supported; then
  not_applicable "Raycast is a cask and MacPorts has no port of it; download it from https://www.raycast.com/"
else
  log "$app.app is not in ${TEEUP_APPS_DIR:-/Applications} or ~/Applications; run: teeup install $TEEUP_CAP"
fi
