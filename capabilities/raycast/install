#!/usr/bin/env bash
# Raycast is an app with no command, so this is a cask and the metadata has
# casks= and apps= and no provides=. MacPorts has no port of it.
if casks_supported; then
  cask_install raycast
else
  warn "Raycast is a cask and MacPorts has no port of it; download it from https://www.raycast.com/"
fi
