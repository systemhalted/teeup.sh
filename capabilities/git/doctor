#!/usr/bin/env bash
# Settings are asked of git itself, against the files `teeup configure git`
# owns and isolated from the system and global config: git's own include
# order, type parsing and path expansion are the answer, and --show-origin
# says which layer (shipped, generated, yours) a value came from.
git_dir="$(user_config_dir)/git"

# git_doctor_read <file> <key> -> the value git resolves for <key> in <file>
# Asked of git, never grepped: a line-oriented search is not section aware --
# its last-match-wins picks up an identically-named key in a later, unrelated
# section -- and it does not follow [include], which is how people keep a work
# identity in its own file.
#
# Isolated from the system and global config. `-f` pins which file the VALUE
# comes from but git still loads the others, so one unreadable file anywhere
# in that chain makes the whole invocation exit 128 -- and teeup's own
# ~/.config/git/config [include]s ~/.config/git/local, which is exactly the
# file a user may have chmod'ed. Without this, an unreadable `local` made
# every lookup return nothing and the doctor reported a perfectly good
# identity as absent.
git_doctor_read() {
  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git config -f "$1" --includes --get "$2" 2>/dev/null || true
}

# git_doctor_effective <git-config options...>
# Asks git itself, of the top-level config with its includes (configure
# renders them to $git_dir), so the answer follows git's own include order,
# its type parsing and its path expansion. Prints git's answer; the exit
# status is git's (0 found, 1 unset, 128 git could not read the graph).
git_doctor_effective() {
  LC_ALL=C GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git config -f "$git_dir/config" --includes "$@" 2>/dev/null
}

# git_doctor_effective_error <git-config options...> -> git's fatal line for
# the same query: what it could not read or parse. The first `fatal:` line,
# not the first line: git can warn about something else first (an include
# that is a directory, say), and that is not why it failed.
git_doctor_effective_error() {
  LC_ALL=C GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git config -f "$git_dir/config" --includes "$@" 2>&1 >/dev/null |
    awk '/^fatal: / { print; found = 1; exit } NR == 1 { first = $0 } END { if (!found) print first }' || true
}

# git_doctor_access_fix <path> -> the command that lets git open <path>:
# chmod u+r on the file, preceded by chmod u+x on every directory from the
# outermost one git cannot search down to the file's own. Nothing below a
# blocked directory can be inspected -- an unsearchable directory hides
# whether the ones inside it are searchable -- so the whole chain is
# included; u+x on a directory that already has it changes nothing.
git_doctor_access_fix() {
  local path="$1" dir chain="" blocked=""
  dir="$(dirname "$path")"
  while [[ -n "$dir" && "$dir" != "/" && "$dir" != "." ]]; do
    chain="$dir"$'\n'"$chain"
    if [[ -d "$dir" && ! -x "$dir" ]]; then
      blocked="$dir"
    fi
    dir="$(dirname "$dir")"
  done
  if [[ -z "$blocked" ]]; then
    printf 'chmod u+r %s\n' "$(printf '%q' "$path")"
    return 0
  fi
  # One chmod per directory, outermost first. On macOS `chmod u+x outer
  # outer/inner` failed with "outer/inner: Permission denied" (CI, #37):
  # BSD chmod apparently looks at every argument before changing any,
  # while GNU chmod works through them in order.
  local cmds="" d started=false
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    [[ "$d" == "$blocked" ]] && started=true
    [[ "$started" == "true" ]] && cmds="${cmds}chmod u+x $(printf '%q' "$d") && "
  done <<< "$chain"
  printf '%schmod u+r %s\n' "$cmds" "$(printf '%q' "$path")"
}

# git 2.55.0, verified: an unreadable config file this one [include]s is not
# a "could not check" situation, it is fatal -- `git config --list`, `git
# commit`, every git command exits 128 the moment it tries to read an
# [include]d path it cannot open (identity, teeup-generated, local are all
# included this way; see capabilities/git/config/git/config). config itself
# unreadable is no better: git silently drops every include under it, so
# identity and signing are unset and `git commit` fails with "Author
# identity unknown". So each is a doctor_fail with a chmod fix, the same
# pattern mise and starship already use for their own unreadable files
# (B-A) -- not a warn, and never a claim that the file "is in place" when
# git cannot actually read it.
if [[ ! -f "$git_dir/config" ]]; then
  doctor_fail "git has never been configured here: there is no $git_dir/config." "teeup configure git"
  doctor_verdict
  exit
fi
if [[ ! -r "$git_dir/config" ]]; then
  doctor_fail "$git_dir/config cannot be read, so every git command fails outright (fatal: unable to access ..., verified against real git). chmod u+r $git_dir/config" "chmod u+r $git_dir/config"
  doctor_verdict
  exit
fi
doctor_ok "$git_dir/config is in place."

# One identity, full stop (2026-09-17 decision): git carries whatever
# $git_dir/identity says regardless of where a repository sits, so there is
# only ever this one file to check, never a per-root pair.
identity_file="$git_dir/identity"
if [[ ! -f "$identity_file" ]]; then
  doctor_fail "No $identity_file, so the git identity resolves to nothing." "teeup configure git"
elif [[ ! -r "$identity_file" ]]; then
  doctor_fail "$identity_file cannot be read, so every git command fails outright; it is [include]d from $git_dir/config. chmod u+r $identity_file" "chmod u+r $identity_file"
else
  # Both fields, not just the email. The shipped config sets
  # `useConfigOnly = true` so git never guesses an identity from the
  # hostname, which makes a missing name fatal rather than cosmetic: git
  # refuses every commit with "fatal: no name was given and auto-detection is
  # disabled". Reporting that machine healthy is the worst kind of wrong,
  # because the gate people check before starting work says it is fine.
  # git, not sed: the sed form matched a quoted value on its own line and
  # nothing else, so it missed an unquoted one, a key in a subsection, and
  # most importantly an [include] -- which is how people keep a work identity
  # in its own file, and which git follows. Reporting "sets no name and no
  # email" on a config git reads perfectly is the failure this check exists
  # to avoid making.
  identity_name="$(git_doctor_read "$identity_file" user.name)"
  identity_email="$(git_doctor_read "$identity_file" user.email)"
  if [[ -z "$identity_name" && -z "$identity_email" ]]; then
    doctor_fail "$identity_file sets no name and no email, so git refuses every commit (useConfigOnly is on, so it will not guess one)." "teeup configure git"
  elif [[ -z "$identity_name" ]]; then
    doctor_fail "$identity_file has no name, so git refuses every commit: useConfigOnly is on, so it will not guess one from the hostname." "teeup configure git"
  elif [[ -z "$identity_email" ]]; then
    doctor_fail "$identity_file has no email, so commits would be unattributed." "teeup configure git"
  else
    doctor_ok "Identity: $identity_name <$identity_email>"
  fi
fi

generated="$git_dir/teeup-generated"
if [[ ! -f "$generated" ]]; then
  doctor_fail "No $generated, so the editor, pager and signing settings the shipped config expects are missing." "teeup configure git"
  doctor_verdict
  exit
fi
if [[ ! -r "$generated" ]]; then
  doctor_fail "$generated cannot be read, so every git command fails outright; it is [include]d from $git_dir/config. chmod u+r $generated" "chmod u+r $generated"
  doctor_verdict
  exit
fi

# The generated file records what was installed when configure last ran. A
# delta that has since been installed means it is stale, and `git diff` is
# quietly plainer than it should be.
if have delta; then
  if grep -q '^[[:space:]]*pager = delta$' "$generated" 2>/dev/null; then
    doctor_ok "delta is git's pager."
  else
    doctor_fail "delta is installed but $generated still names another pager." "teeup configure git"
  fi
fi

# Signing turns itself on at the next configure once the personal key has
# both halves -- git signs with that key alone, whatever repository it is in,
# so a work key (when one even exists) never enters into this. On a first
# bootstrap git runs before ssh, so this is the ordinary state of a machine
# that has not been re-configured since.
personal_key="$(identity_key personal)"
# An unsearchable ~/.ssh makes every test below answer "no", which would
# downgrade the failure two branches down ("every key is here but signing is
# off") into a note that the key does not exist yet -- about a machine where
# teeup simply could not look.
keys_unknown=false
if [[ ! -r "$(dirname "$personal_key")" || ! -x "$(dirname "$personal_key")" ]]; then
  keys_unknown=true
  keys_present=false
elif [[ -s "$personal_key" && -s "$personal_key.pub" ]]; then
  keys_present=true
else
  keys_present=false
fi
# Whether signing is on is git's own answer, asked of the top-level config
# with its includes -- configure renders those to $git_dir, so this reads
# identity, teeup-generated and local in the order git does, and a line after
# the last include still wins. --type=bool is git's boolean parser (a bare
# key is true, `2` is true, garbage is an error), and --show-origin says which
# file decided. Reading teeup-generated alone reported "signing is on" for a
# machine whose local override turns it off (Codex, PR #32); reading the
# files one by one got the order and the booleans wrong (Codex, follow-up).
gpgsign_rc=0
gpgsign_raw="$(git_doctor_effective --show-origin --type=bool --get commit.gpgsign)" || gpgsign_rc=$?
gpgsign_origin="${gpgsign_raw%%$'\t'*}"
gpgsign="${gpgsign_raw##*$'\t'}"
gpgsign_unknown=false
gpgsign_invalid=false
gpgsign_broken=false
gpgsign_err=""
gpgsign_fix=""
case "$gpgsign_rc" in
  0) ;;
  1) gpgsign=false ;; # unset: git's default is off
  *)
    # 128 is git failing anywhere in the include graph, not only on this
    # value, so what went wrong is read from git's own message (Codex, #33):
    # a file it cannot open, a value it rejects, or a file it cannot parse.
    gpgsign_err="$(git_doctor_effective_error --type=bool --get commit.gpgsign)"
    gpgsign_err="${gpgsign_err#fatal: }"
    case "$gpgsign_err" in
      "unable to access '"*)
        gpgsign_unknown=true
        # "unable to access '<path>': <reason>". The suffix is stripped
        # rather than cutting at the next quote, which a path can contain.
        gpgsign_err="${gpgsign_err#unable to access \'}"
        gpgsign_err="${gpgsign_err%\': *}"
        gpgsign_fix="$(git_doctor_access_fix "$gpgsign_err")"
        ;;
      "bad boolean config value"*) gpgsign_invalid=true ;;
      *) gpgsign_broken=true ;;
    esac
    gpgsign=false
    ;;
esac
# Off in teeup-generated is teeup's own call and can go stale; off in local
# is the owner's choice -- including in any file local itself includes, so
# the question is whether the deciding line is one local's own graph
# reaches, not whether it sits in local itself (Codex, #33).
gpgsign_local=false
if [[ "$gpgsign_rc" -eq 0 && -r "$git_dir/local" ]]; then
  local_raw="$(LC_ALL=C GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git config -f "$git_dir/local" --includes --show-origin --get commit.gpgsign 2>/dev/null || true)"
  local_origin="${local_raw%%$'\t'*}"
  [[ -n "$local_raw" && ( "$local_origin" == "$gpgsign_origin" || "$gpgsign_origin" == "file:$git_dir/local" ) ]] && gpgsign_local=true
fi
if [[ "$gpgsign_unknown" == "true" ]]; then
  doctor_unknown "git cannot read $gpgsign_err, so teeup could not tell whether commit signing is on." "$gpgsign_fix"
  signing_on=false
elif [[ "$gpgsign_invalid" == "true" ]]; then
  doctor_fail "commit.gpgsign is set to something that is not a value git accepts, so every git commit fails (fatal: bad boolean config value)." "git config -f $(printf '%q' "$git_dir/config") --includes --show-origin --get-all commit.gpgsign"
  signing_on=false
elif [[ "$gpgsign_broken" == "true" ]]; then
  doctor_fail "git cannot read its configuration: ${gpgsign_err:-it exited without saying why}. Every git command that reads config fails until that file is fixed." "git config -f $(printf '%q' "$git_dir/config") --includes --list"
  signing_on=false
elif [[ "$gpgsign" == "true" ]]; then
  # Signing on with the key gone is worse than signing off: every `git commit`
  # fails outright, and the doctor that reported full health is the reason
  # nobody looked here first. The key is the one git signs with: its answer
  # from the whole graph, which also reaches a signingkey set after the last
  # include (Codex, #33). The graph was just read, so it is readable.
  # What the key is depends on gpg.format (git's default, unset, is
  # openpgp): under ssh a path or a `key::` literal, under openpgp or x509
  # an ID the GPG tooling resolves -- not a file teeup can look for.
  gpg_format="$(git_doctor_effective --get gpg.format || true)"
  signing_key_raw="$(git_doctor_effective --get user.signingkey || true)"
  signing_key_rc=0
  signing_key="$(git_doctor_effective --path --get user.signingkey)" || signing_key_rc=$?
  signing_key="${signing_key%.pub}"
  if [[ -z "$signing_key_raw" ]]; then
    # What real git does here: "fatal: either user.signingkey or
    # gpg.ssh.defaultKeyCommand needs to be configured" on every commit.
    doctor_fail "commit.gpgsign is on but no user.signingkey is set, so every git commit fails." "teeup configure git"
  elif [[ $signing_key_rc -ne 0 ]]; then
    # --path could not expand it: a ~user whose home does not exist.
    doctor_fail "Commit signing is on with user.signingkey = $signing_key_raw, a path git cannot expand, so every git commit fails." "teeup configure git"
  elif [[ -n "$gpg_format" && "$gpg_format" != "openpgp" && "$gpg_format" != "x509" && "$gpg_format" != "ssh" ]]; then
    # `git config --get` does not check the enum; `git commit` does, and
    # refuses ("invalid value for 'gpg.format'") every time.
    doctor_fail "gpg.format = $gpg_format is not a format git knows (openpgp, x509, ssh), so every signed commit fails." "git config -f $(printf '%q' "$git_dir/config") --includes --show-origin --get gpg.format"
  elif [[ "$gpg_format" != "ssh" ]]; then
    doctor_ok "Commit signing is on with gpg.format = ${gpg_format:-openpgp} and key $signing_key_raw; teeup checks SSH keys only."
  elif [[ "$signing_key_raw" == key::* ]]; then
    # The literal is the public half; git signs through ssh-agent, which has
    # to hold the private half. An empty agent is per-session state (the ssh
    # doctor says the same), so that is a note, not a failure.
    literal_file="$(mktemp "${TMPDIR:-/tmp}/teeup-doctor-key.XXXXXX")"
    printf '%s\n' "${signing_key_raw#key::}" > "$literal_file"
    literal_ok=true
    if have ssh-keygen && ! ssh-keygen -l -f "$literal_file" >/dev/null 2>&1; then
      literal_ok=false
    fi
    rm -f "$literal_file"
    literal_body="$(printf '%s' "${signing_key_raw#key::}" | awk '{ print $2 }')"
    literal_agent_rc=0
    literal_agent="$(ssh-add -L 2>/dev/null)" || literal_agent_rc=$?
    if [[ "$literal_ok" != "true" ]]; then
      doctor_fail "user.signingkey is a key:: literal that is not a valid SSH public key, so every signed commit fails." "teeup configure git"
    elif [[ $literal_agent_rc -ge 2 ]] || ! have ssh-add; then
      doctor_unknown "Commit signing uses a literal SSH key, which git signs with through ssh-agent, and no agent could be reached to check it holds that key." "echo \$SSH_AUTH_SOCK, and start an agent if it is empty"
    elif [[ -n "$literal_body" ]] && printf '%s\n' "$literal_agent" | awk -v k="$literal_body" '$2 == k { f = 1 } END { exit !f }'; then
      doctor_ok "Commit signing is on with a literal SSH key in user.signingkey, held by ssh-agent."
    else
      doctor_warn "Commit signing uses a literal SSH key, and ssh-agent does not hold it right now, so signed commits fail until its private key is added (ssh-add <private key>)."
    fi
  elif [[ ! -s "$signing_key" ]]; then
    doctor_fail "Commit signing is on with user.signingkey = $signing_key, but that key is not on this machine, so every git commit fails." "teeup configure ssh"
  else
    doctor_ok "Commit signing is on."
  fi
  signing_on=true
elif [[ "$gpgsign_local" == "true" ]]; then
  # Name the file that decided: local itself, or a file local includes.
  gpgsign_from="${gpgsign_origin#file:}"
  doctor_warn "$gpgsign_from turns commit signing off, so git signs nothing. That file is yours; remove the commit.gpgsign line there to sign again."
  signing_on=false
elif [[ "$keys_present" == "true" ]]; then
  doctor_fail "git has every key it needs on disk but commit signing is off in $generated." "teeup configure git"
  signing_on=false
elif [[ "$keys_unknown" == "true" ]]; then
  doctor_unknown "Commit signing is off in $generated, and $(dirname "$personal_key") cannot be read, so teeup could not tell whether the key it needs is there." "chmod u+rx $(dirname "$personal_key")"
  signing_on=false
else
  doctor_warn "Commit signing is off because the personal key does not exist yet. Run: teeup configure ssh"
  signing_on=false
fi

# Signing with an SSH key is only half of it. Verification reads
# gpg.ssh.allowedSignersFile, and with none set `git log --show-signature`
# reports every commit teeup just signed as having no known signer. Nothing
# in teeup writes that file yet (B2, 2026-09-23 review): `configure git`
# never sets gpg.ssh.allowedSignersFile, so a standard, correctly bootstrapped
# machine has signing on and no allowed-signers file every single time. That
# is the ordinary state, not a broken one, so it is a note with instructions
# rather than a failure -- and the instructions never touch ~/.gitconfig,
# which the warning two sections down says to delete.
if [[ "$signing_on" == "true" ]]; then
  # gpg.format decides whether any of this even applies: a machine that has
  # switched to GPG signing (or turned SSH signing off) does not owe teeup an
  # allowedSignersFile, and the message above must say what format actually
  # is rather than assuming the shipped default is still in effect.
  # gpg.format was read with the key, above, from the same graph.
  if [[ "$gpg_format" != "ssh" ]]; then
    doctor_ok "Commit signing is on with gpg.format = ${gpg_format:-openpgp}, so the SSH allowed-signers check does not apply."
  else
    # git's effective value, like every other signing setting: its include
    # order (a later top-level line beats local), section awareness, and
    # --path expansion of a leading ~.
    signers_rc=0
    signers_file="$(git_doctor_effective --path --get gpg.ssh.allowedSignersFile)" || signers_rc=$?
    # The public key the repairs trust: the one git signs with. A key::
    # literal is the key itself; anything else is a key file.
    if [[ "$signing_key_raw" == key::* ]]; then
      signer_pub="$(printf '%q' "${signing_key_raw#key::}")"
    else
      signer_pub="\"\$(cat $(printf '%q' "${signing_key:-$(identity_key personal)}.pub"))\""
    fi
    if [[ $signers_rc -eq 0 ]]; then
      # Set is not the same as usable: a path that is not there verifies
      # nothing, and git says so only at the moment you read a signature.
      # There, readable, and naming at least one signer: an empty file or
      # one of comments only leaves every signature untrusted, and one git
      # cannot open verifies nothing either (Codex P2, PR #32).
      # Every path in the repairs is shell-quoted: they are printed to be
      # pasted, and a path with a space would otherwise split.
      signers_q="$(printf '%q' "$signers_file")"
      signers_add="printf '%s %s\\n' \"\$(git config user.email)\" $signer_pub >> $signers_q"
      if [[ -f "$signers_file" && ! -r "$signers_file" ]]; then
        doctor_fail "gpg.ssh.allowedSignersFile points at $signers_file, which cannot be read, so git can verify no signature." "chmod u+r $signers_q"
      elif [[ -f "$signers_file" ]] && ! grep -qE '^[[:space:]]*[^#[:space:]]' "$signers_file"; then
        doctor_fail "gpg.ssh.allowedSignersFile points at $signers_file, which names no signer, so git trusts no signature." "$signers_add"
      elif [[ -f "$signers_file" ]]; then
        doctor_ok "gpg.ssh.allowedSignersFile is set, so signatures can be verified."
      else
        doctor_fail "gpg.ssh.allowedSignersFile points at $signers_file, which does not exist, so git can verify no signature." "$signers_add"
      fi
    elif [[ $signers_rc -ne 1 ]]; then
      # Set, but git could not expand it (a ~user with no home).
      doctor_fail "gpg.ssh.allowedSignersFile is set to a path git cannot expand, so git can verify no signature." "git config -f $(printf '%q' "$git_dir/config") --includes --show-origin --get gpg.ssh.allowedSignersFile"
    else
      # B2 (2026-09-23 review): a note, not a failure -- teeup does not set
      # this yet, so a clean bootstrap must still pass doctor -- and the
      # instructions add a line to $git_dir/local, never to ~/.gitconfig
      # (the section below warns that file overrides teeup's own config).
      signers="$git_dir/allowed_signers"
      doctor_warn "Commit signing is on with gpg.format = ssh, but gpg.ssh.allowedSignersFile is not set, so git cannot verify its own signatures yet (git log --show-signature calls them unknown). teeup does not set this yet. To enable verification: printf '%s %s\n' \"\$(git config user.email)\" $signer_pub >> $(printf '%q' "$signers"), then add gpg.ssh.allowedSignersFile = $signers to $git_dir/local (never ~/.gitconfig)."
    fi
  fi
fi

# Two ways for the whole tree above to be ignored. teeup never edits either,
# so both are notes with an instruction rather than failures with a fix.
if [[ -f "$HOME/.gitconfig" ]]; then
  doctor_warn "$HOME/.gitconfig exists and its keys win over $git_dir/config. Move what you want to keep into $git_dir/local, then delete it."
fi
if [[ -n "${GIT_CONFIG_GLOBAL:-}" ]]; then
  doctor_warn "GIT_CONFIG_GLOBAL=$GIT_CONFIG_GLOBAL overrides $git_dir/config outright; nothing above is read."
fi

doctor_verdict
