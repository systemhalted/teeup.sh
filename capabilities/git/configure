#!/usr/bin/env bash
# One identity, full stop (2026-09-17 decision). A repository that needs a
# different address gets `git config user.email ...` by hand -- teeup does
# not model that here.

# git_quote <value> -> a double-quoted git-config string. Without this, an
# unquoted value in a git config file is truncated at the first `#` or `;`
# and mangled by a `"` or `\` (git's config parser treats those as special
# outside quotes) — a name like "Jane Smith #3" would lose everything from
# the `#` on. No `local`: this script is sourced, not run as its own process.
git_quote() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

git_dir="$(user_config_dir)/git"

name="$(answers_get TEEUP_NAME)"
email="$(answers_get TEEUP_EMAIL)"
if [[ -z "$name" || -z "$email" ]]; then
  warn "No name or personal email in the answers file; skipping the git identity."
  warn "Run ./bootstrap --reconfigure, then: teeup configure git"
else
  key="$(identity_key personal)"
  write_managed_file "$git_dir/identity" "git identity" <<GIT_IDENTITY
# Generated by teeup (teeup configure git). Your edits here are overwritten.
[user]
	name = $(git_quote "$name")
	email = $(git_quote "$email")
	signingkey = $(git_quote "$key.pub")
GIT_IDENTITY
  ok_unless_dry "git identity: $email"
fi

# Three settings depend on what is actually installed, so they are generated
# rather than shipped. The shipped config includes this file AFTER its own
# defaults, so what is written here wins over them (and ~/.config/git/local,
# included last, still wins over this).
if have emacsclient; then
  editor="emacsclient -t"
else
  editor="vim"
fi

# A pager that is not installed makes `git log`, `git diff` and `git show` fail
# machine-wide, so delta is only kept when delta exists.
if have delta; then
  pager="delta"
  diff_filter="delta --color-only"
else
  pager="less"
  diff_filter="cat"
  log "delta is not installed; leaving git on its default pager."
fi

# Mandatory SSH signing with no key makes every `git commit` fail, including
# the one that would fix it. ssh runs after git in the core list, so on a first
# bootstrap the key does not exist yet: signing turns itself on at the next
# `teeup configure git`, which the ssh capability runs for itself once it has
# made the key. Both halves of the keypair must exist, not just the .pub: a
# deleted private key (the .pub left behind) is the same failure as no key at
# all.
gpgsign="true"
key="$(identity_key personal)"
if [[ ! -f "$key" ]]; then
  gpgsign="false"
  log "No $key yet; commit signing stays off."
  log "After the ssh capability has made your keys, run: teeup configure git"
elif [[ ! -f "$key.pub" ]]; then
  gpgsign="false"
  log "No $key.pub yet; commit signing stays off."
  log "After the ssh capability has made your keys, run: teeup configure git"
fi

write_managed_file "$git_dir/teeup-generated" "git generated settings" <<GIT_GENERATED
# Generated by teeup (teeup configure git). Your edits here are overwritten.
[core]
	editor = $editor
	pager = $pager
[sequence]
	editor = $editor
[interactive]
	diffFilter = $diff_filter
[commit]
	gpgsign = $gpgsign
GIT_GENERATED

# The shipped config hardcodes ~/.config/git/... in its [include] paths;
# rendered here to the real config dir so a non-default XDG_CONFIG_HOME still
# resolves. With the default XDG layout this is a no-op.
# A bash substitution loop, not sed: $git_dir can contain |, \ or & (all sed
# replacement metacharacters), and any of them would corrupt a
# `sed "s|~/.config/git|$git_dir|g"` render.
# bash 5.2+ treats & in a ${var//pat/repl} replacement as the matched text
# (patsub_replacement). Bash 3.2 does not have the option; the redirect hides
# its "invalid shell option name" error there.
shopt -u patsub_replacement 2>/dev/null || true
rendered_git_config="$(mktemp)"
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    # Anchored on the leading tab so a future comment mentioning this same
    # text (not just an actual "path = ~/.config/git..." key line) can never
    # be rewritten by mistake.
    $'\t''path = ~/.config/git'*)
      # The value is a path, not just a bareword: an XDG_CONFIG_HOME with a
      # `#` or `;` in it (both comment characters to git's config parser
      # outside quotes) would otherwise truncate everything after it. Quoting
      # the whole rendered value, not just substituting $git_dir in place,
      # makes every such include path a proper git-config string.
      value="${line#*= }"
      rel="${value#\~/.config/git}"
      printf '%s = %s\n' "${line%% = *}" "$(git_quote "$git_dir$rel")"
      ;;
    *)
      printf '%s\n' "$line"
      ;;
  esac
done < "$TEEUP_CAP_DIR/config/git/config" > "$rendered_git_config"
copy_config_once "$rendered_git_config" "$git_dir/config" "$TEEUP_CAP_DIR/config/git/config"
rm -f "$rendered_git_config"

# git reads ~/.gitconfig after ~/.config/git/config, so a leftover file wins
# silently. teeup never edits, moves or deletes it; it says so instead.
if [[ -f "$HOME/.gitconfig" ]]; then
  # $HOME rather than a literal ~: a tilde inside a quoted string is not
  # expanded by the shell and shellcheck rejects it (SC2088).
  warn "$HOME/.gitconfig exists and its keys win over $git_dir/config."
  warn "Move what you want to keep into $git_dir/config or $git_dir/local, then delete it."
fi

# GIT_CONFIG_GLOBAL overrides ~/.config/git/config outright, the same failure
# mode as a leftover ~/.gitconfig, only quieter: nothing under $git_dir is
# even read.
if [[ -n "${GIT_CONFIG_GLOBAL:-}" ]]; then
  warn "GIT_CONFIG_GLOBAL=$GIT_CONFIG_GLOBAL overrides $git_dir/config outright."
fi

if ! have git-lfs; then
  log "git-lfs is not installed; large-file repositories will not clone correctly."
fi

log "pre-commit is installed by the mise capability, later in the core list."
