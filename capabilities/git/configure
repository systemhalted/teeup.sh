#!/usr/bin/env bash
# One identity, full stop (2026-09-17 decision). A repository that needs a
# different address gets `git config user.email ...` by hand -- teeup does
# not model that here.

# git_quote <value> -> a double-quoted git-config string. Without this, an
# unquoted value in a git config file is truncated at the first `#` or `;`
# and mangled by a `"` or `\` (git's config parser treats those as special
# outside quotes) — a name like "Jane Smith #3" would lose everything from
# the `#` on. No `local`: this script is sourced, not run as its own process.
git_quote() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

git_dir="$(user_config_dir)/git"

name="$(answers_get TEEUP_NAME)"
email="$(answers_get TEEUP_EMAIL)"
if [[ -z "$name" || -z "$email" ]]; then
  warn "No name or personal email in the answers file; skipping the git identity."
  warn "Run ./bootstrap --reconfigure, then: teeup configure git"
else
  key="$(identity_key personal)"
  # write_managed_file already warns on its own refusal (M11: a file that is
  # not writable); `|| true` keeps that a warning instead of aborting the
  # rest of this script under `bash -eu`.
  write_managed_file "$git_dir/identity" "git identity" <<GIT_IDENTITY || true
# Generated by teeup (teeup configure git). Your edits here are overwritten.
[user]
	name = $(git_quote "$name")
	email = $(git_quote "$email")
	signingkey = $(git_quote "$key.pub")
GIT_IDENTITY
  # Only when this run actually wrote it: a second configure reports "Already
  # current" and has no mutation to announce under it.
  [[ "$WRITE_MANAGED_FILE_CHANGED" == "true" ]] && ok_unless_dry "git identity: $email"
fi

# Three settings depend on what is actually installed, so they are generated
# rather than shipped. The shipped config includes this file AFTER its own
# defaults, so what is written here wins over them (and ~/.config/git/local,
# included last, still wins over this).
if have emacsclient; then
  editor="emacsclient -t"
else
  editor="vim"
fi

# A pager that is not installed makes `git log`, `git diff` and `git show` fail
# machine-wide, so delta is only kept when delta exists.
if have delta; then
  pager="delta"
  diff_filter="delta --color-only"
else
  pager="less"
  diff_filter="cat"
  log "delta is not installed; leaving git on its default pager."
fi

# Mandatory SSH signing with no key makes every `git commit` fail, including
# the one that would fix it. ssh runs after git in the core list, so on a first
# bootstrap the key does not exist yet: signing turns itself on at the next
# `teeup configure git`, which the ssh capability runs for itself once it has
# made the key. Both halves of the keypair must exist, not just the .pub: a
# deleted private key (the .pub left behind) is the same failure as no key at
# all.
gpgsign="true"
key="$(identity_key personal)"
if [[ ! -f "$key" ]]; then
  gpgsign="false"
  log "No $key yet; commit signing stays off."
  log "After the ssh capability has made your keys, run: teeup configure git"
elif [[ ! -f "$key.pub" ]]; then
  gpgsign="false"
  log "No $key.pub yet; commit signing stays off."
  log "After the ssh capability has made your keys, run: teeup configure git"
fi

# write_managed_file already warns on its own refusal (M11); `|| true` keeps
# that a warning instead of aborting the rest of this script under
# `bash -eu`.
write_managed_file "$git_dir/teeup-generated" "git generated settings" <<GIT_GENERATED || true
# Generated by teeup (teeup configure git). Your edits here are overwritten.
[core]
	editor = $editor
	pager = $pager
[sequence]
	editor = $editor
[interactive]
	diffFilter = $diff_filter
[commit]
	gpgsign = $gpgsign
GIT_GENERATED

# The shipped config hardcodes ~/.config/git/... in its [include] paths;
# rendered here to the real config dir so a non-default XDG_CONFIG_HOME still
# resolves. With the default XDG layout this is a no-op.
# A bash substitution loop, not sed: $git_dir can contain |, \ or & (all sed
# replacement metacharacters), and any of them would corrupt a
# `sed "s|~/.config/git|$git_dir|g"` render.
# bash 5.2+ treats & in a ${var//pat/repl} replacement as the matched text
# (patsub_replacement). Bash 3.2 does not have the option; the redirect hides
# its "invalid shell option name" error there.
shopt -u patsub_replacement 2>/dev/null || true
rendered_git_config="$(mktemp)"
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    # Anchored on the leading tab so a future comment mentioning this same
    # text (not just an actual "path = ~/.config/git..." key line) can never
    # be rewritten by mistake.
    $'\t''path = ~/.config/git'*)
      # The value is a path, not just a bareword: an XDG_CONFIG_HOME with a
      # `#` or `;` in it (both comment characters to git's config parser
      # outside quotes) would otherwise truncate everything after it. Quoting
      # the whole rendered value, not just substituting $git_dir in place,
      # makes every such include path a proper git-config string.
      value="${line#*= }"
      rel="${value#\~/.config/git}"
      printf '%s = %s\n' "${line%% = *}" "$(git_quote "$git_dir$rel")"
      ;;
    *)
      printf '%s\n' "$line"
      ;;
  esac
done < "$TEEUP_CAP_DIR/config/git/config" > "$rendered_git_config"
# An upgraded machine still has the two-identity config teeup used to ship:
# copy_config_once compares the installed file against the sha recorded when it
# was installed, they still match, and it reports "Already installed" -- so the
# includeIf blocks and the identity-personal/identity-work files survive forever
# and ~/Work keeps committing as the work address. The migration framework does
# not exist yet, so the repair happens here, in place, and only on the blocks
# teeup itself shipped: anything else in the file is the user's.
#
# git_repair_old_identity_model: takes no arguments; reads $git_dir.
git_repair_old_identity_model() {
  local config="$git_dir/config" was_pristine=false recorded current
  local old_a_comment old_path_personal old_path_work new_path
  local personal_file="$git_dir/identity-personal" work_file="$git_dir/identity-work"
  local i=0 n tmp leftover=false line link_target
  local -a lines out

  old_a_comment=$'\t''# Default identity; the includeIf blocks at the bottom override it per root.'
  old_path_personal=$'\t''path = "'"$git_dir"'/identity-personal"'
  old_path_work=$'\t''path = "'"$git_dir"'/identity-work"'
  new_path=$'\t''path = "'"$git_dir"'/identity"'

  # Nothing to do unless this machine actually carries the old shape.
  if [[ ! -f "$personal_file" && ! -f "$work_file" ]]; then
    [[ -f "$config" ]] || return 0
    grep -q 'identity-personal\|identity-work' "$config" || return 0
  fi

  log "This machine still carries the old two-identity git model; repairing it."
  log "git has one identity now, so the includeIf blocks and the per-root identity files go."

  if [[ -f "$config" ]]; then
    # Was this the file teeup installed, untouched? The answer decides whether
    # the stock record can be refreshed below, and it has to be taken before
    # the repair rewrites the file.
    recorded="$(stock_sha "$config" || true)"
    current="$(file_sha "$config")"
    [[ -n "$recorded" && "$recorded" == "$current" ]] && was_pristine=true
    # The whole file in memory (bash 3.2 indexed arrays, no mapfile): the
    # includeIf pair is matched as a run of lines, which a line-at-a-time read
    # cannot do without a lookahead.
    lines=()
    while IFS= read -r line || [[ -n "$line" ]]; do
      lines[${#lines[@]}]="$line"
    done < "$config"
    n=${#lines[@]}
    out=()
    while [[ $i -lt $n ]]; do
      # The shipped includeIf pair, with its shipped two-line comment when that
      # is still above it, and the blank line that followed it.
      if [[ "${lines[$i]}" == '# Identity by directory (spec section 8). Both identities live on every' &&
            "${lines[$((i + 1))]:-}" == '# machine; where the repository sits decides which one applies.' &&
            "${lines[$((i + 2))]:-}" == '[includeIf "gitdir:~/Personal/"]' ]]; then
        i=$((i + 2))
        continue
      fi
      if [[ "${lines[$i]}" == '[includeIf "gitdir:~/Personal/"]' &&
            "${lines[$((i + 1))]:-}" == "$old_path_personal" &&
            "${lines[$((i + 2))]:-}" == '[includeIf "gitdir:~/Work/"]' &&
            "${lines[$((i + 3))]:-}" == "$old_path_work" ]]; then
        i=$((i + 4))
        # Two blank lines where a block was removed read as a stray gap.
        if [[ "${lines[$i]:-}" == "" && ${#out[@]} -gt 0 && "${out[$((${#out[@]} - 1))]}" == "" ]]; then
          i=$((i + 1))
        fi
        continue
      fi
      # The file's own header paragraph, which still describes "the two
      # identities" teeup used to generate.
      if [[ "${lines[$i]}" == '# Generated pieces (editor, pager, signing, the two identities) live in' &&
            "${lines[$((i + 1))]:-}" == '# separate included files so teeup can regenerate them without touching your' &&
            "${lines[$((i + 2))]:-}" == '# edits here. Include order is load-bearing: git keeps the LAST value it' &&
            "${lines[$((i + 3))]:-}" == '# reads, so teeup-generated is included below the defaults it has to be able' &&
            "${lines[$((i + 4))]:-}" == '# to override, and ~/.config/git/local last of all.' ]]; then
        out[${#out[@]}]='# Generated pieces (editor, pager, signing, the identity) live in separate'
        out[${#out[@]}]='# included files so teeup can regenerate them without touching your edits'
        out[${#out[@]}]='# here. Include order is load-bearing: git keeps the LAST value it reads, so'
        out[${#out[@]}]='# teeup-generated is included below the defaults it has to be able to'
        out[${#out[@]}]='# override, and ~/.config/git/local last of all.'
        i=$((i + 5))
        continue
      fi
      # The remaining identity-personal include is the default-identity block at
      # the top; it becomes the one identity, comment and all.
      if [[ "${lines[$i]}" == "$old_a_comment" ]]; then
        out[${#out[@]}]=$'\t''# One identity, full stop (2026-09-17 decision). A repository that needs a'
        out[${#out[@]}]=$'\t''# different address gets `git config user.email ...` by hand.'
        i=$((i + 1))
        continue
      fi
      if [[ "${lines[$i]}" == "$old_path_personal" ]]; then
        out[${#out[@]}]="$new_path"
        i=$((i + 1))
        continue
      fi
      out[${#out[@]}]="${lines[$i]}"
      i=$((i + 1))
    done

    # Anything still naming the old model was not a block teeup shipped, so the
    # whole file is the user's to change and teeup edits none of it.
    for line in ${out+"${out[@]}"}; do
      case "$line" in
        *identity-personal*|*identity-work*|*'gitdir:~/Personal/'*|*'gitdir:~/Work/'*)
          leftover=true
          break
          ;;
      esac
    done
    if [[ "$leftover" == "true" ]]; then
      warn "$config still carries the old two-identity model in a shape teeup did not ship, so it was left alone."
      warn "These are its lines, as the file has them:"
      # Listed from the file itself, not from the transformed copy: that copy
      # has already rewritten the top-level include, which the user would then
      # never be told to fix, and nothing is being written anyway. An includeIf
      # header is listed alongside the path under it -- on its own,
      # "path = .../identity-work" says nothing about which root sends a
      # repository there, and a root the user renamed would otherwise never
      # appear at all.
      i=0
      while [[ $i -lt $n ]]; do
        case "${lines[$i]}" in
          *identity-personal*|*identity-work*|*'gitdir:~/Personal/'*|*'gitdir:~/Work/'*)
            printf '  %d: %s\n' "$((i + 1))" "${lines[$i]}" >&2
            ;;
          '[includeIf "gitdir:'*)
            case "${lines[$((i + 1))]:-}" in
              *identity-personal*|*identity-work*)
                printf '  %d: %s\n' "$((i + 1))" "${lines[$i]}" >&2
                ;;
            esac
            ;;
        esac
        i=$((i + 1))
      done
      warn "git has one identity now: one include of $git_dir/identity, no includeIf blocks. teeup changed nothing."
      return 0
    fi
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    [[ -L "$config" ]] && printf "%b %s\n" "🔍" "[DRY-RUN] Would back up the symlink at $config and write a real file in its place"
    [[ -f "$config" ]] && printf "%b %s\n" "🔍" "[DRY-RUN] Would drop the old identity blocks from $config"
    [[ -f "$personal_file" ]] && printf "%b %s\n" "🔍" "[DRY-RUN] Would back up $personal_file"
    [[ -f "$work_file" ]] && printf "%b %s\n" "🔍" "[DRY-RUN] Would back up $work_file"
    return 0
  fi

  if [[ -f "$config" ]]; then
    # A symlink is never a file teeup installed, so it is foreign the same way
    # one at a key path or at any other shipped config is: the link is backed
    # up and a real file takes its place, rather than the repair being written
    # through it into whatever repo the link points at. Say so, and name that
    # file: it still has the old blocks, and nothing else will tell the user.
    if [[ -L "$config" ]]; then
      link_target="$(readlink "$config")"
      case "$link_target" in /*) ;; *) link_target="$(dirname "$config")/$link_target" ;; esac
      warn "$config is a symlink to $link_target."
      warn "teeup backs the link up and writes a real file here, as it does for every file it did not install."
      warn "$link_target keeps the old blocks; update or delete them there too."
    fi
    backup_target "$config" >/dev/null
    tmp="$(mktemp)"
    for line in ${out+"${out[@]}"}; do printf '%s\n' "$line"; done > "$tmp"
    mv "$tmp" "$config"
    ok "Dropped the old identity blocks from $config"
    # The record still holds the sha of the config teeup shipped before this
    # branch, so copy_config_once would now call the repaired file a user edit
    # and say so on every run. Re-record it when the file teeup just repaired
    # was the pristine one it had installed; a config the user had already
    # edited keeps its old record and goes on being reported as edited, which
    # is what it is.
    if [[ "$was_pristine" == "true" ]]; then
      stock_record "$config" "$(file_sha "$config")"
    fi
  fi
  for line in "$personal_file" "$work_file"; do
    [[ -f "$line" ]] || continue
    backup_target "$line" >/dev/null
    ok "Removed $line; teeup no longer writes it."
  done
}

git_repair_old_identity_model

copy_config_once "$rendered_git_config" "$git_dir/config" "$TEEUP_CAP_DIR/config/git/config"
rm -f "$rendered_git_config"

# git reads ~/.gitconfig after ~/.config/git/config, so a leftover file wins
# silently. teeup never edits, moves or deletes it; it says so instead.
if [[ -f "$HOME/.gitconfig" ]]; then
  # $HOME rather than a literal ~: a tilde inside a quoted string is not
  # expanded by the shell and shellcheck rejects it (SC2088).
  warn "$HOME/.gitconfig exists and its keys win over $git_dir/config."
  warn "Move what you want to keep into $git_dir/config or $git_dir/local, then delete it."
fi

# GIT_CONFIG_GLOBAL overrides ~/.config/git/config outright, the same failure
# mode as a leftover ~/.gitconfig, only quieter: nothing under $git_dir is
# even read.
if [[ -n "${GIT_CONFIG_GLOBAL:-}" ]]; then
  warn "GIT_CONFIG_GLOBAL=$GIT_CONFIG_GLOBAL overrides $git_dir/config outright."
fi

if ! have git-lfs; then
  log "git-lfs is not installed; large-file repositories will not clone correctly."
fi

log "pre-commit is installed by the mise capability, later in the core list."
