#!/usr/bin/env bash
# What configure put in place, checked from the outside: the env file shells
# and LaunchAgents read, the command link users type, the state tree, and the
# two PATH facts everything lazy depends on.
env_file="$TEEUP_CONFIG_DIR/env"
if [[ ! -f "$env_file" ]]; then
  doctor_fail "No $env_file, so shells and LaunchAgents cannot find the checkout." "teeup configure teeup-runtime"
elif [[ ! -r "$env_file" ]]; then
  doctor_fail "$env_file cannot be read, so teeup cannot tell whether shells and LaunchAgents can find the checkout." "chmod u+r $env_file"
else
  # Sourced in a subshell rather than parsed: configure writes the three
  # values %q-escaped, so only a shell can read them back correctly. All
  # three are unset first: lib/all.sh has already exported them into this
  # process, so without the unset, a file that never sets one of them --
  # empty, truncated mid-write, or with the line commented out -- would
  # print this process's own value back and the comparison below would
  # always pass.
  env_read_ok=true
  env_values="$( (
    set +u
    unset TEEUP_PATH TEEUP_CONFIG_DIR TEEUP_STATE_DIR
    # shellcheck source=/dev/null
    source "$env_file" >/dev/null 2>&1 || exit 1
    # A tab is IFS whitespace, so `read` would collapse a leading empty
    # field (TEEUP_PATH commented out or unset) into the next one instead of
    # keeping it empty. \x1f is not whitespace, so each field survives empty.
    printf '%s\x1f%s\x1f%s\n' "${TEEUP_PATH:-}" "${TEEUP_CONFIG_DIR:-}" "${TEEUP_STATE_DIR:-}"
  ) )" || env_read_ok=false
  if [[ "$env_read_ok" != "true" ]]; then
    doctor_fail "$env_file exists but a shell could not source it (a syntax error, most likely), so teeup cannot tell whether it points at this checkout." "teeup configure teeup-runtime"
  else
    IFS=$'\x1f' read -r recorded_path recorded_config_dir recorded_state_dir <<EOF_ENV_VALUES
$env_values
EOF_ENV_VALUES
    mismatch=""
    if [[ "$recorded_path" != "$TEEUP_PATH" ]]; then
      mismatch="$mismatch TEEUP_PATH=${recorded_path:-nothing} (expected $TEEUP_PATH);"
    fi
    if [[ "$recorded_config_dir" != "$TEEUP_CONFIG_DIR" ]]; then
      mismatch="$mismatch TEEUP_CONFIG_DIR=${recorded_config_dir:-nothing} (expected $TEEUP_CONFIG_DIR);"
    fi
    if [[ "$recorded_state_dir" != "$TEEUP_STATE_DIR" ]]; then
      mismatch="$mismatch TEEUP_STATE_DIR=${recorded_state_dir:-nothing} (expected $TEEUP_STATE_DIR);"
    fi
    if [[ -z "$mismatch" ]]; then
      doctor_ok "$env_file points at this checkout."
    else
      doctor_fail "$env_file does not match this checkout:$mismatch" "teeup configure teeup-runtime"
    fi
  fi
fi

link="$HOME/.local/bin/teeup"
link_target="$(readlink "$link" 2>/dev/null || true)"
if [[ "$link_target" == "$TEEUP_PATH/bin/teeup" ]]; then
  doctor_ok "$link points at this checkout."
elif [[ -e "$link" || -L "$link" ]]; then
  doctor_fail "$link is not teeup's symlink; it points at ${link_target:-a regular file}." "teeup configure teeup-runtime"
else
  doctor_fail "No $link, so the teeup command is not on PATH." "teeup configure teeup-runtime"
fi

case ":$PATH:" in
  *":$HOME/.local/bin:"*)
    doctor_ok "$HOME/.local/bin is on PATH."
    ;;
  *)
    doctor_fail "$HOME/.local/bin is not on PATH, so neither teeup nor its mise wrappers can be run by name." "teeup configure zsh"
    ;;
esac

missing="" unusable="" unusable_paths=""
for d in "done" toggles migrations shims logs current stock; do
  dir="$TEEUP_STATE_DIR/$d"
  if [[ ! -d "$dir" ]]; then
    missing="$missing $d"
  elif [[ ! -r "$dir" || ! -x "$dir" ]]; then
    # -d succeeds on a directory that cannot be read or searched, which is
    # exactly the state that makes every state_done lookup under it lie
    # (a root-owned state tree left behind by a sudo bootstrap, or a bad
    # umask): every "is this marked installed/done" check answers "no",
    # silently, and this loop must not call that "present".
    unusable="$unusable $d"
    unusable_paths="$unusable_paths $dir"
  fi
done
if [[ -z "$missing" && -z "$unusable" ]]; then
  doctor_ok "Every state directory is present under $TEEUP_STATE_DIR."
else
  if [[ -n "$missing" ]]; then
    doctor_fail "Missing under $TEEUP_STATE_DIR:$missing" "teeup configure teeup-runtime"
  fi
  if [[ -n "$unusable" ]]; then
    doctor_fail "Present but not readable/searchable under $TEEUP_STATE_DIR:$unusable, so teeup cannot tell what is recorded there." "chmod u+rx$unusable_paths"
  fi
fi

# A lazy shim fires only when the calling shell cannot find the real command,
# and that is only true while the shims directory is the LAST thing on PATH.
# The shell layer appends it last; anything that moves it earlier turns a shim
# into a shadow over a real binary.
shims="$(shims_dir)"
# How many times it appears, not just whether it ends there: a PATH that
# carries the shims directory twice -- once early, once last -- ends with it
# and would pass an "ends with" test, while the early copy shadows every real
# binary behind a shim. That is the exact failure this check exists for.
shims_count="$(printf '%s' ":$PATH:" | awk -v d=":$shims:" '
  { n = 0; i = 1
    while (1) { p = index(substr($0, i), d); if (p == 0) break; n++; i += p }
    print n }')"
case ":$PATH:" in
  *":$shims:"*)
    if [[ "$shims_count" -gt 1 ]]; then
      doctor_warn "The lazy shims directory is on PATH $shims_count times; the earlier copy shadows real commands with shims. Check what prepends to PATH after ~/.zshenv."
    else
      case "$PATH" in
        "$shims"|*":$shims")
          doctor_ok "The lazy shims directory is last on PATH."
          ;;
        *)
          doctor_warn "The lazy shims directory is on PATH but not last, so a shim can shadow a real command. Open a new login shell, or check what prepends to PATH after ~/.zshenv."
          ;;
      esac
    fi
    ;;
  *)
    doctor_fail "$shims is not on PATH, so no lazy shim can fire." "teeup configure zsh"
    ;;
esac

# install puts both in place. Neither is fatal any more (prompts fall back to
# plain reads and the menu parses its own file), so they are notes.
for cmd in gum jq; do
  if have "$cmd"; then
    doctor_ok "$cmd is installed."
  else
    doctor_warn "$cmd is not installed. Run: teeup install teeup-runtime"
  fi
done

doctor_verdict
