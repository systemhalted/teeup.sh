#!/usr/bin/env bash
# The backend itself, not the packages: the generic metadata check covers
# what each capability declares, and this capability declares nothing. What
# it owns is whether the package manager exists, is reachable, and is the one
# everything else has been assuming.
# Where the backend really is, asked of the machine rather than derived from
# the architecture. pkg_prefix guesses (/opt/homebrew on Apple Silicon,
# /usr/local otherwise) unless HOMEBREW_PREFIX says otherwise, and a Homebrew
# installed at the other standard prefix -- or one whose HOMEBREW_PREFIX is
# exported only in an interactive shell -- makes every line below name a
# directory that has nothing in it.
# Captured once, not read back from TEEUP_PKG_BACKEND: pkg_backend runs
# inside this command substitution's own subshell, so the export
# _pkg_backend_resolve makes never reaches this process.
backend="$(pkg_backend)"
backend_cmd="$(pkg_backend_cmd)"
found_bin=""
if [[ -n "$backend_cmd" ]] && have "$backend_cmd"; then
  found_bin="$(command -v "$backend_cmd")"
fi
assumed_prefix="$(pkg_prefix)"
if [[ -n "$found_bin" ]]; then
  real_prefix="${found_bin%/bin/*}"
  # On PATH is not the same as reachable: a brew/port that errors on every
  # call would otherwise be reported "installed", and every capability's
  # doctor would then read the resulting flood of "not installed" package
  # lines as fact instead of as a backend that was never really asked.
  # doctor_backend_can_answer (lib/doctor.sh) is the one definition of
  # "reachable" every capability's metadata check also uses (NI3): rolling a
  # second probe here let the two disagree about the very same `brew`.
  if doctor_backend_can_answer; then
    doctor_ok "$(pkg_backend_label) is installed under $real_prefix."
    if [[ "$real_prefix" != "$assumed_prefix" ]]; then
      # HOMEBREW_PREFIX is what pkg_prefix obeys for Homebrew; MacPorts'
      # prefix is hardcoded to /opt/local and reads no override, so offering
      # the Homebrew fix on a MacPorts machine names an environment variable
      # that changes nothing (I4).
      case "$backend" in
        homebrew)
          doctor_warn "teeup looks for it under $assumed_prefix instead, so anything it installs there will not be found. Set HOMEBREW_PREFIX=$real_prefix in $(machine_file), or in your shell before running teeup."
          ;;
        macports)
          doctor_warn "teeup looks for it under $assumed_prefix instead, so anything it installs there will not be found. teeup's MacPorts prefix is fixed at $assumed_prefix; a MacPorts installed elsewhere is not supported."
          ;;
      esac
    fi
  else
    unreachable_fix="$backend_cmd version"
    if [[ "$backend" == "homebrew" ]]; then
      unreachable_fix="brew doctor"
    fi
    doctor_fail "$found_bin is on PATH but did not answer ($TEEUP_DOCTOR_BACKEND_OUT), so teeup could not check what $(pkg_backend_label) has installed." "$unreachable_fix"
  fi
elif [[ -x "$assumed_prefix/bin/$backend_cmd" ]]; then
  doctor_fail "$(pkg_backend_label) is installed under $assumed_prefix but $assumed_prefix/bin is not on PATH, so nothing installed through it can be found." "teeup configure zsh"
else
  doctor_fail "$(pkg_backend_label) is not installed." "./bootstrap"
fi

# configure records the resolved backend so that a macOS upgrade past the
# MacPorts cut-off cannot silently move the machine to Homebrew. The answers
# file is read on its own here, not through answers_get: answers_load has
# already layered the machine file on top, and the question this check asks
# is whether `teeup configure package-manager` ever wrote the answer down.
answers_recorded="$( (
  unset TEEUP_PACKAGE_MANAGER
  answers_f="$(answers_file)"
  # shellcheck source=/dev/null
  if [ -f "$answers_f" ]; then . "$answers_f"; fi
  printf '%s\n' "${TEEUP_PACKAGE_MANAGER:-}"
) )"
if [[ -n "$answers_recorded" ]]; then
  doctor_ok "The package manager is recorded in the answers file: $answers_recorded"
else
  doctor_fail "No TEEUP_PACKAGE_MANAGER in the answers file; the backend is detected afresh on every run." "teeup configure package-manager"
fi

# The machine file wins over the answers file by design, so this is not a
# failure. It is the thing to know before wondering why an answer, or a
# `teeup config set`, had no effect.
if pinned="$(machine_get TEEUP_PACKAGE_MANAGER)"; then
  doctor_warn "$(machine_file) pins TEEUP_PACKAGE_MANAGER=${pinned:-detect}, which wins over the answers file (currently ${answers_recorded:-unset})."
fi

doctor_verdict
