#!/usr/bin/env bash
# Two roots, answered by the wizard (identity_dir, lib/answers.sh) with
# today's $HOME/Work and $HOME/Personal as the fallback for a machine that
# never answered. The git capability keys identity off them (includeIf), so
# they must exist before git is configured.
for d in "$(identity_dir personal)" "$(identity_dir work)"; do
  if [[ -d "$d" ]]; then
    log "Already present: $d"
  else
    run_cmd mkdir -p "$d"
    ok_unless_dry "Created $d"
  fi
done
