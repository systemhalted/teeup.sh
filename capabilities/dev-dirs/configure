#!/usr/bin/env bash
# One root (2026-09-17 decision): git identity lives in generated settings
# now, not a directory rule, so there is no longer a reason for a second,
# ~/Personal root to exist.
d="$HOME/Work"
if [[ -d "$d" ]]; then
  log "Already present: $d"
else
  run_cmd mkdir -p "$d"
  ok_unless_dry "Created $d"
fi
