#!/usr/bin/env bash
# GitHub: per host AND per account (2026-09-17 decision). The personal
# identity always uploads to github.com; a work identity uploads to whatever
# host identity_gh_host names for it (lib/answers.sh) -- github.com by
# default, or a GitHub Enterprise host when machines/<hostname>.conf sets
# TEEUP_WORK_GH_HOST. GH_HOST is pinned per identity, not once at the top: a
# value left over in the caller's environment would otherwise silently
# redirect every call below to the wrong host, and the whole point of
# iterating identities is that they may not share a host.
#
# GH_HOST selects a host, not an account, and every host has exactly one
# active account that gh targets. So two identities on the same host (a work
# account beside a personal one, both on github.com) are told apart by
# `gh auth switch --hostname <host> --user <account>`, which is what
# TEEUP_WORK_GH_ACCOUNT names. Without it there is no way to aim the upload,
# and the work key would land on the personal account: teeup refuses that
# upload rather than performing it on the wrong account.

if ! have gh; then
  warn "gh is not installed; skipping the GitHub setup. Re-run: teeup install github"
  exit 0
fi

# _github_key_uploaded <listed> <body> <type> -> exits 0 when `gh ssh-key
# list`'s output (a tab-separated TITLE/KEY/ADDED/ID/TYPE, the real non-TTY
# format gh 2.100.0 prints) already has a row for this key body and type.
# The title is free text and comes first, so it must never be scanned for a
# type match (a key titled exactly "signing", or one that merely contains the
# word, would otherwise be mistaken for the row it is not); the type is the
# LAST field, full stop, and the key body is found scanning backwards from
# the type towards the title, stopping before field 1 so a title that
# happens to hold our key body can never count either. The match is the
# field whose second word is exactly the public key body ("ssh-ed25519
# <body>") -- exact, not substring, so a body that merely contains ours does
# not count as ours.
_github_key_uploaded() {
  local listed="$1" body="$2" type="$3"
  printf '%s\n' "$listed" | awk -F'\t' -v body="$body" -v type="$type" '
    NF < 2 || $NF != type { next }
    {
      for (i = NF - 1; i >= 2; i--) {
        if (split($i, w, " ") >= 2 && w[2] == body) { found = 1; exit }
      }
    }
    END { exit found ? 0 : 1 }'
}

# _gh_active_account <host> -> the account gh currently targets on <host>, or
# nothing when it is not signed in there. gh 2.100.0 prints it as
# "Logged in to github.com account ada (keyring)".
_gh_active_account() {
  gh auth status --active -h "$1" 2>/dev/null |
    awk '{ for (i = 1; i < NF; i++) if ($i == "account") { print $(i + 1); exit } }'
}

# _github_upload_answer_key <identity> -> the answers-file key that records
# whether this identity's public key may be uploaded to GitHub.
_github_upload_answer_key() {
  case "$1" in
    personal) printf 'TEEUP_GITHUB_UPLOAD_PERSONAL\n' ;;
    work) printf 'TEEUP_GITHUB_UPLOAD_WORK\n' ;;
    *) die "_github_upload_answer_key: unknown identity '$1' (expected personal or work)" ;;
  esac
}

_github_upload_declined() {
  local answer_key="$1"
  log "Not uploading the SSH key because $answer_key is no."
  log "To change this choice: teeup config set $answer_key yes && teeup configure github"
}

# _github_sync_git_signing: the git capability renders commit.gpgsign from
# TEEUP_GITHUB_UPLOAD_PERSONAL, but git runs before github in the core list.
# On a first bootstrap git rendered before this script asked the question,
# and a later `teeup config set` of the answer never reaches git either. So
# re-run git's configure whenever the rendered value no longer matches the
# answer. Only when git has been configured already, as ssh/configure does,
# and only with both halves of the personal key on disk: without them git
# keeps signing off whatever the answer says.
_github_sync_git_signing() {
  local generated want have key
  generated="$(user_config_dir)/git/teeup-generated"
  [[ -f "$generated" ]] || return 0
  key="$(identity_key personal)"
  want=true
  if [[ "$(answers_get TEEUP_GITHUB_UPLOAD_PERSONAL)" == "no" ]]; then
    want=false
  elif [[ ! -f "$key" || ! -f "$key.pub" ]]; then
    return 0
  fi
  have="$(sed -n 's/^[[:space:]]*gpgsign = //p' "$generated")"
  [[ "$have" != "$want" ]] || return 0
  log "Re-running the git configuration so commit signing follows TEEUP_GITHUB_UPLOAD_PERSONAL."
  cap_run git configure || { rc=$?; ui_rc_or_exit $rc || true; warn "Could not re-run the git configuration. Run: teeup configure git"; }
}

# github_configure_identity <identity>: everything done on the host and
# account already selected for this identity. A function rather than the body
# of the loop so that its several early exits cannot skip the switch back to
# the account that was active before teeup ran.
github_configure_identity() {
  local identity="$1" gh_host="$2" gh_account="$3"
  local status_out pub body listed type title answer_key upload_answer upload_account needs_upload target_account ssh_out ssh_login
  local refresh_out refresh_status active_account

  pub="$(identity_key "$identity").pub"
  if [[ ! -f "$pub" ]]; then
    local early_account="$gh_account"; [[ -n "$early_account" ]] || early_account="active account"; warn "No ${pub%.pub} yet (for the $identity identity, $early_account on $gh_host). Run: teeup configure ssh"
    return 0
  fi

  answer_key="$(_github_upload_answer_key "$identity")"
  upload_answer="$(answers_get "$answer_key")"

  if [[ "$upload_answer" != "yes" && "$upload_answer" != "no" ]]; then
    if lazy_is_tty; then
      upload_account="$gh_account"
      [[ -n "$upload_account" ]] || upload_account="$(_gh_active_account "$gh_host")"
      [[ -n "$upload_account" ]] || upload_account="active account"
      if ui_confirm "Upload ${pub%.pub} to GitHub for the $identity identity ($upload_account on $gh_host) for pushing and commit signing?" yes; then
        upload_answer=yes
      else
        ui_rc_or_exit $? || true
        upload_answer=no
      fi
      answers_set "$answer_key" "$upload_answer"
    else
      upload_answer=yes
    fi
  fi

  if [[ "$upload_answer" == "no" ]]; then
    _github_upload_declined "$answer_key"
    return 0
  fi

  active_account="$(_gh_active_account "$gh_host")"
  target_account="$gh_account"
  [[ -n "$target_account" ]] || target_account="$active_account"


  if status_out="$(gh auth status --active -h "$gh_host" 2>&1)"; then
    ok "Already signed in to GitHub ($gh_host)."
    if [[ "$status_out" != *"admin:public_key"* || "$status_out" != *"admin:ssh_signing_key"* ]]; then
      local display_account="$target_account"
      [[ -n "$display_account" ]] || display_account="unknown account"
      log "Refreshing gh's permissions for the $identity identity ($display_account on $gh_host, key ${pub%.pub}). In the browser, sign in as $display_account."

      if [[ "$DRY_RUN" == "true" ]]; then
        run_cmd gh auth refresh -h "$gh_host" -s admin:public_key,admin:ssh_signing_key
      else
        refresh_status=0
        refresh_out="$(gh auth refresh -h "$gh_host" -s admin:public_key,admin:ssh_signing_key 2>&1)" || refresh_status=$?
        if [[ $refresh_status -ne 0 ]]; then
          if [[ "$refresh_out" =~ error\ refreshing\ credentials\ for\ ([^,]+),\ received\ credentials\ for\ ([^,]+) ]]; then
            warn "The browser was signed in as ${BASH_REMATCH[2]}, not ${BASH_REMATCH[1]}. Sign in as ${BASH_REMATCH[1]} in the browser (or sign out of ${BASH_REMATCH[2]}), then re-run: teeup configure github"
          else
            printf '%s\n' "$refresh_out"
            warn "Could not refresh gh's auth scopes for $gh_host. Re-run: teeup configure github"
          fi
          return 0
        fi
      fi
    fi
  else
    local display_account="$target_account"
    [[ -n "$display_account" ]] || display_account="unknown account"
    log "Signing in to GitHub for the $identity identity ($display_account on $gh_host, key ${pub%.pub}). A browser window opens; approve the SSH key scopes."
    if ! run_cmd gh auth login --hostname "$gh_host" --web --git-protocol ssh --skip-ssh-key --scopes admin:public_key,admin:ssh_signing_key; then
      warn "gh auth login did not complete for $gh_host. Re-run: teeup configure github"
      return 0
    fi
  fi

  run_cmd gh config set git_protocol ssh --host "$gh_host" || warn "Could not set gh's git protocol to ssh for $gh_host."

  body="$(awk 'NR == 1 { print $2 }' < "$pub")"
  listed="$(gh ssh-key list 2>/dev/null || true)"
  needs_upload=false
  for type in authentication signing; do
    if [[ -z "$body" ]] || ! _github_key_uploaded "$listed" "$body" "$type"; then
      needs_upload=true
    fi
  done
  if [[ "$needs_upload" != "true" ]]; then
    log "Already uploaded (authentication): ${pub%.pub} (for the $identity identity, $target_account on $gh_host)"
    log "Already uploaded (signing): ${pub%.pub} (for the $identity identity, $target_account on $gh_host)"
    return 0
  fi

  # target account might have changed if we just logged in
  target_account="$gh_account"
  [[ -n "$target_account" ]] || target_account="$(_gh_active_account "$gh_host")"

  if [[ -n "$target_account" ]]; then
    ssh_out="$(ssh -T -i "$(identity_key "$identity")" -o IdentitiesOnly=yes "git@$gh_host" 2>&1 || true)"
    if [[ "$ssh_out" =~ Hi\ ([^!]+)!\ You\'ve\ successfully ]]; then
      ssh_login="${BASH_REMATCH[1]}"
      if [[ "$ssh_login" != "$target_account" ]]; then
        warn "Refusing upload: the $identity key (${pub%.pub}) belongs to GitHub account '$ssh_login', but gh is targeting '$target_account' on $gh_host."
        return 0
      fi
    fi
  fi

  for type in authentication signing; do
    if [[ -n "$body" ]] && _github_key_uploaded "$listed" "$body" "$type"; then
      log "Already uploaded ($type): ${pub%.pub} (for the $identity identity, $target_account on $gh_host)"
      continue
    fi
    title="$host_short $identity"
    [[ "$type" == "signing" ]] && title="$title (signing)"
    run_cmd gh ssh-key add "$pub" --type "$type" --title "$title" ||
      warn "Could not upload ${pub%.pub} as a $type key for the $identity identity ($target_account on $gh_host)."
  done
}
host_short="$(hostname -s 2>/dev/null || hostname)"

for identity in $(identity_list); do
  gh_host="$(identity_gh_host "$identity")"
  gh_account="$(identity_gh_account "$identity")"
  export GH_HOST="$gh_host"
  restore_account=""
  verify_after_login=false
  if [[ -n "$gh_account" ]]; then
    active_account="$(_gh_active_account "$gh_host")"
    if [[ -z "$active_account" ]]; then
      # Nothing is signed in on this host, so there is no account to switch
      # from: the `gh auth login` below decides who teeup ends up as, and it
      # is whoever answers in the browser, not necessarily the account named
      # here. Check afterwards rather than assume.
      verify_after_login=true
    elif [[ "$active_account" != "$gh_account" ]]; then
      if run_cmd gh auth switch --hostname "$gh_host" --user "$gh_account"; then
        restore_account="$active_account"
      else
        warn "Could not switch gh to $gh_account on $gh_host; skipping the $identity identity."
        warn "Check the account name in $(machine_file), or run: gh auth login --hostname $gh_host --skip-ssh-key"
        continue
      fi
    fi
  elif [[ "$identity" != "personal" && "$gh_host" == "$(identity_gh_host personal)" ]]; then
    # Same host as personal, no account named: gh would target the personal
    # account and the work key would be uploaded to it.
    warn "The $identity identity is on $gh_host, the same host as personal, and $(machine_file) names no TEEUP_WORK_GH_ACCOUNT."
    warn "gh targets a host, not an account, so the $identity key would be uploaded to the personal account. Not uploading it."
    warn "Set TEEUP_WORK_GH_ACCOUNT to the work account's GitHub login (see machines/example.conf.sample)."
    continue
  fi

  github_configure_identity "$identity" "$gh_host" "$gh_account"
  if [[ "$identity" == "personal" ]]; then
    _github_sync_git_signing
  fi

  # Skipped under DRY_RUN: no login ran, so the account on the host is still
  # whatever it was and would only produce a warning about a mismatch this run
  # never created.
  if [[ "$verify_after_login" == "true" && "$DRY_RUN" != "true" ]]; then
    active_account="$(_gh_active_account "$gh_host")"
    if [[ -n "$active_account" && "$active_account" != "$gh_account" ]]; then
      warn "gh is signed in to $gh_host as $active_account, not the $gh_account named in $(machine_file)."
      warn "The $identity key went to $active_account. Sign in as $gh_account (gh auth login --hostname $gh_host --skip-ssh-key) and re-run: teeup configure github"
    fi
  fi

  if [[ -n "$restore_account" ]]; then
    run_cmd gh auth switch --hostname "$gh_host" --user "$restore_account" ||
      warn "Could not switch gh back to $restore_account on $gh_host. Run: gh auth switch --hostname $gh_host --user $restore_account"
  fi
done
