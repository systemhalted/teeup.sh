#!/usr/bin/env bash
# Two files, both the user's from the moment they land: the thin config that
# pulls in teeup's layer, and the machine-specific override table.
WEZTERM_DIR="$(user_config_dir)/wezterm"
copy_config_once "$TEEUP_CAP_DIR/config/wezterm/wezterm.lua" "$WEZTERM_DIR/wezterm.lua"
copy_config_once "$TEEUP_CAP_DIR/config/wezterm/local.lua" "$WEZTERM_DIR/local.lua"

# aqua/wezterm's MacPorts Portfile moves the built WezTerm.app into
# applications_dir at destroot time and only symlinks the wezterm/
# wezterm-gui binaries into ${prefix}/bin; it never touches /Applications.
# Launchpad only indexes /Applications (and ~/Applications), so on MacPorts
# the app is really installed but invisible there -- worth saying once,
# since nothing else in this capability says so. `port dir <name>` prints
# the *Portfile's* own directory in the ports tree, and `port -q variants`
# lists build variants; neither exposes applications_dir. macports-base
# ships that key active (uncommented) in macports.conf by default, so read
# it there rather than assume; when the file or key is missing, fall back to
# macports-base's own compiled-in default for the same key:
# /Applications/MacPorts.
wezterm_macports_apps_dir() {
  local conf dir=""
  conf="$(pkg_prefix)/etc/macports/macports.conf"
  if [[ -r "$conf" ]]; then
    dir="$(awk '$1 == "applications_dir" { print $2; exit }' "$conf")"
  fi
  printf '%s\n' "${dir:-/Applications/MacPorts}"
}

if ! casks_supported; then
  WEZTERM_APPS_DIR="$(wezterm_macports_apps_dir)"
  log "MacPorts installs WezTerm.app under $WEZTERM_APPS_DIR, not /Applications, so Launchpad won't show it; open it with: open -a \"$WEZTERM_APPS_DIR/WezTerm.app\""
fi
