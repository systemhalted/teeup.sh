#!/usr/bin/env bash
# Undo what colima/configure set up. Stop the VM first, whether or not
# packages are about to come off: teeup's configure is what started it, and
# leaving it running once the capability is forgotten hands it to nobody. On
# Homebrew, `brew uninstall colima` (which runs right after this script when
# packages are not kept) under a running lima VM leaves the VM process
# orphaned and the docker context pointing at nothing -- a real-Mac risk,
# invisible under mocks (R-7.2).
# A failed stop ends the removal: cmd_remove uninstalls the packages right
# after this script returns, and `brew uninstall colima` under a VM that is
# still running is the exact damage this script exists to prevent. Warning
# and carrying on would do it anyway and then report "Removed".
if have colima; then
  if colima status >/dev/null 2>&1; then
    if run_cmd colima stop; then
      ok_unless_dry "Colima stopped."
    else
      err "colima stop failed, so colima was not removed: uninstalling it now would orphan the running VM."
      err "Stop it by hand (colima stop), then run: teeup remove colima"
      exit 1
    fi
  fi
else
  log "colima is not on PATH; nothing to stop."
fi

# `teeup uninstall` without --packages keeps colima, docker and Compose
# installed (TEEUP_REMOVE_PACKAGES=false, from lib/capability.sh's
# cap_remove). The VM is already stopped above; what stays is the software
# itself and the Compose plugin symlink configure created (configure:9-27),
# which is what makes the docker the user keeps work.
if [[ "${TEEUP_REMOVE_PACKAGES:-true}" != "true" ]]; then
  log "Keeping colima, docker and Compose installed, so the docker compose link stays as it is."
  exit 0
fi

# Drop the Compose plugin symlink configure created; Homebrew's own uninstall
# knows nothing about it. Only the symlink teeup itself put there is
# touched: it is removed only when it still points at this backend's
# Compose plugin, the same check configure makes before deciding it is
# "Already linked".
if [[ "$(pkg_backend)" == "homebrew" ]]; then
  plugin="$(pkg_prefix)/lib/docker/cli-plugins/docker-compose"
  plugins_dir="${DOCKER_CONFIG:-$HOME/.docker}/cli-plugins"
  link="$plugins_dir/docker-compose"
  if [[ -L "$link" && "$(readlink "$link" 2>/dev/null)" == "$plugin" ]]; then
    run_cmd rm -f "$link"
    ok_unless_dry "Removed the docker compose plugin link at $link"
  fi
fi
