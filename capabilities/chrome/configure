#!/usr/bin/env bash
# Same guard as install, repeated here because configure can run on its own
# (teeup configure chrome): a machine below the floor, or a MacPorts Mac,
# must report this capability not-applicable, not installed.
chrome_macos_major="$(macos_major)"
if [[ "${chrome_macos_major:-99}" -lt 13 ]] 2>/dev/null; then
  not_applicable "Google Chrome requires macOS 13 or newer; this Mac is on macOS $chrome_macos_major, so there is nothing to configure."
fi
unset chrome_macos_major
if ! casks_supported; then
  not_applicable "Google Chrome is a cask and MacPorts has no port of it; download it from https://www.google.com/chrome/"
fi

# Chrome syncs its settings through a Google account, so there is nothing to
# ship. The script records that decision, and says whether the app is in
# place.
app="Google Chrome"
if [[ -d "${TEEUP_APPS_DIR:-/Applications}/$app.app" ]]; then
  log "$app is installed; open it with: open -a '$app'"
else
  # M4: a standalone `teeup configure chrome` has no install step above it to
  # point at, so this says only what is actually known here -- casks are
  # supported and the floor is met (both guards above already passed) and
  # the app is simply not there yet.
  log "$app.app is not in ${TEEUP_APPS_DIR:-/Applications}; run: teeup install $TEEUP_CAP"
fi
