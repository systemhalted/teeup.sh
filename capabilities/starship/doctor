#!/usr/bin/env bash
# The prompt itself, and the one part of its config teeup keeps writing: the
# marker block `teeup theme set` rewrites. Lose the markers and the prompt
# keeps working while quietly staying on whatever colours it had, which is the
# kind of failure nobody reports because nothing looks broken.
if have starship; then
  doctor_ok "starship is on PATH."
else
  doctor_fail "starship is not on PATH, so the prompt falls back to zsh's default." "teeup install starship"
fi

name_file="$TEEUP_STATE_DIR/current/theme.name"
if [[ -e "$name_file" && ! -r "$name_file" ]]; then
  # theme_current does a plain `cat`, which would abort this whole script
  # under `bash -eu` with a raw "Permission denied" and no findings at all
  # (NI5, the same defect theme/doctor already guards against) -- say so
  # instead of dying.
  doctor_fail "$name_file cannot be read, so teeup cannot tell which theme is current." "chmod u+r $name_file"
  doctor_verdict
  exit
fi
name="$(theme_current)"
# A name in theme.name is only a claim; nothing before this confirmed teeup
# still has a theme by that name. `teeup theme set $name`, the fix every
# other finding below offers, cannot succeed against a name that is not real
# (NI5).
if [[ "$name" != "none" ]] && ! theme_list | grep -qxF "$name"; then
  doctor_fail "$name is recorded as the current theme, but teeup has no theme by that name (try: teeup theme list)." "teeup theme set catppuccin"
  doctor_verdict
  exit
fi
config="$(user_config_dir)/starship.toml"
if [[ ! -f "$config" ]]; then
  doctor_fail "No $config, so starship runs on its built-in defaults." "teeup configure starship"
  doctor_verdict
  exit
fi
# Unreadable is not missing, and the fix is not the same: every check below
# reads this file, so without this they would all report their own kind of
# absence -- and `teeup reset starship`, which replaces the file, would be
# offered for what is only a permissions problem.
if [[ ! -r "$config" ]]; then
  doctor_fail "$config cannot be read, so teeup cannot tell whether the prompt follows the theme." "chmod u+r $config"
  doctor_verdict
  exit
fi
doctor_ok "$config is in place."

start_count="$(grep -cxF '# teeup:theme-palette:start' "$config" || true)"
end_count="$(grep -cxF '# teeup:theme-palette:end' "$config" || true)"
if [[ "$start_count" -eq 1 && "$end_count" -eq 1 ]]; then
  # Intact markers are not intact colours: the block between them is what
  # `teeup theme set` writes, and a hand-edited or stale one keeps the prompt
  # on colours the current theme does not name while every structural check
  # here passes. Compare what is in the file with what the theme renders.
  #
  # `theme-apply` (capabilities/theme/theme-apply) writes ONE block that
  # holds BOTH modes -- the dark render, a blank line, the light render, a
  # blank line -- because starship needs both `[palettes.teeup-dark]` and
  # `[palettes.teeup-light]` on disk to switch appearance without a re-render.
  # Diffing that block against only one mode's rendered file can never equal
  # it, in either appearance, and reports a freshly-written, correct block as
  # broken every time (NB2). The expected content is built here the same way
  # theme-apply builds it, from the same two files, so what is compared is
  # what was actually written.
  dark_palette="$TEEUP_STATE_DIR/current/theme/dark/starship-palette.toml"
  light_palette="$TEEUP_STATE_DIR/current/theme/light/starship-palette.toml"
  if [[ ! -f "$dark_palette" && ! -f "$light_palette" ]]; then
    doctor_ok "The starship palette block is intact."
  elif { [[ -f "$dark_palette" ]] && [[ ! -r "$dark_palette" ]]; } || { [[ -f "$light_palette" ]] && [[ ! -r "$light_palette" ]]; }; then
    doctor_warn "$dark_palette or $light_palette cannot be read, so the palette block's colours were not compared."
  else
    expected_palette="$(mktemp)"
    for mode in dark light; do
      rendered="$TEEUP_STATE_DIR/current/theme/$mode/starship-palette.toml"
      if [[ -f "$rendered" ]]; then
        cat "$rendered" >> "$expected_palette"
        echo "" >> "$expected_palette"
      fi
    done
    if awk '/^# teeup:theme-palette:start$/ { inside = 1; next }
            /^# teeup:theme-palette:end$/ { inside = 0; next }
            inside { print }' "$config" | diff -q - "$expected_palette" >/dev/null 2>&1; then
      doctor_ok "The starship palette block is intact and matches the current theme."
    else
      doctor_fail "$config's palette block does not match what the $name theme renders, so the prompt is on other colours." "teeup theme set $name"
    fi
    rm -f "$expected_palette"
  fi
elif [[ "$start_count" -eq 0 && "$end_count" -eq 0 ]]; then
  doctor_fail "$config has no teeup:theme-palette markers, so it no longer follows the teeup theme." "teeup reset starship"
else
  doctor_fail "$config has $start_count start and $end_count teeup:theme-palette end markers; the palette rewrite refuses anything but one of each, so it no longer follows the teeup theme." "teeup reset starship"
fi

# The root selector the theme switch rewrites. Without it the palette tables
# are present and unused. Only a `palette =` line before the file's first
# [table] header counts: `grep -q '^palette *='` anywhere in the file also
# matches inside a [palettes.X] table, which selects nothing at the root.
root_palette="$(awk '
  /^\[/ { exit }
  /^palette[[:space:]]*=/ {
    line = $0
    sub(/^palette[[:space:]]*=[[:space:]]*/, "", line)
    print line
    exit
  }
' "$config")"
if [[ -n "$root_palette" ]]; then
  doctor_ok "A root palette selector is present ($root_palette)."
else
  doctor_fail "$config has no root 'palette =' line before its first [table], so the rendered palettes are never selected." "teeup reset starship"
fi

doctor_verdict
