# ~/.ssh/config - installed once by teeup; this copy is yours to edit.
# ssh keeps the FIRST value it finds for each keyword, so specific hosts come
# first and the catch-all Host * block goes last.

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes

#TEEUP_WORK_ALIAS teeup renders the work alias here, and only on a machine
#TEEUP_WORK_ALIAS whose machines/<hostname>.conf configures a work identity.
#TEEUP_WORK_ALIAS An alias pointing at a key that does not exist, with
#TEEUP_WORK_ALIAS IdentitiesOnly yes, fails with no usable identity the first
#TEEUP_WORK_ALIAS time anyone uses it by accident. These marker lines are
#TEEUP_WORK_ALIAS dropped either way; they never reach ~/.ssh/config.

Host *
  # Add a key to the agent on first use and keep its passphrase in the login
  # Keychain. IdentitiesOnly is deliberately NOT set here: restricting every
  # host to explicitly named keys breaks agent-forwarded and corporate hosts.
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
