#!/usr/bin/env bash
# Keys, their permissions, and the host aliases that decide which key a push
# uses. ssh refuses a private key other people can read, and it refuses it at
# the moment you need it, so the mode is checked here rather than assumed.
ssh_dir="$HOME/.ssh"

# The same probe capabilities/ssh/configure's file_mode uses: GNU stat first
# because its -f means something else entirely, BSD stat second.
mode_of() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || printf 'unknown\n'; }

# ssh_expand_includes <file> [depth]
# The config as ssh reads it: every root-level `Include` replaced by the
# contents of the files it names, recursively. ssh resolves a relative pattern
# against ~/.ssh (verified against a real `ssh -G`), accepts several patterns
# on one line, and globs each of them.
#
# Not following Include is a false NEGATIVE with teeth: a `Host github.com`
# block in ~/.ssh/conf.d/ is a supported layout -- lib/answers.sh says in so
# many words that it asks ssh rather than parsing because "Include was not
# followed at all" -- so identity_key adopts a key from an included file on
# the very machine this doctor then calls broken, and `teeup reset ssh` cannot
# repair a config the user owns.
#
# Two deliberate limits. An Include that sits INSIDE a Host block is
# conditional in ssh and is not expanded here; the conventional position, and
# the one ssh's own documentation recommends, is at the top. And a depth cap
# stops a circular include from hanging the doctor -- ssh has one too.
ssh_expand_includes() {
  local file="$1" depth="${2:-0}" raw line kw tok pattern f_inc seen_host=false
  [[ -r "$file" ]] || return 0
  if [[ "$depth" -ge 16 ]]; then
    return 0
  fi
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    line="${raw%%#*}"
    line="${line/=/ }"
    set -f
    # shellcheck disable=SC2086
    set -- $line
    set +f
    if [[ $# -ge 1 ]]; then
      kw="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
      if [[ "$kw" == "host" || "$kw" == "match" ]]; then
        seen_host=true
      fi
      if [[ "$kw" == "include" && "$seen_host" != "true" ]]; then
        shift
        for tok in "$@"; do
          # No ${var/pattern/} here: bash 3.2 mis-parses a quoted pattern
          # containing a slash inside one, which is why lib/files.sh carries
          # replace_literal at all. A case and a substring do the same job
          # with no parser involved.
          # The "~/" here is a literal token out of the config file, not a
          # path for the shell to expand.
          # shellcheck disable=SC2088
          case "$tok" in
            /*) pattern="$tok" ;;
            "~/"*) pattern="$HOME/${tok#\~/}" ;;
            *) pattern="$HOME/.ssh/$tok" ;;
          esac
          # Deliberate glob expansion of a pattern from the config -- ssh
          # globs these itself -- with an unmatched pattern expanding to
          # itself, which the -f test below then rejects.
          # shellcheck disable=SC2231
          for f_inc in $pattern; do
            if [[ -f "$f_inc" ]]; then
              ssh_expand_includes "$f_inc" "$((depth + 1))"
            fi
          done
        done
        continue
      fi
    fi
    printf '%s\n' "$raw"
  done < "$file"
  return 0
}

# ssh_host_block_applies <alias> <pattern>...
# ssh's own Host matching, including negation. A pattern list is a set of
# globs, any of which may be negated with a leading "!". ssh applies the block
# when at least one positive pattern matches AND no negated pattern matches:
# `Host * !github.com` means every host EXCEPT github.com, so a loop that
# stops at the first positive hit marks the alias matched on `*` and never
# unmarks it -- reporting a block OpenSSH does not apply, and crediting the
# key named inside it, while the alias resolves to nothing and every push
# fails.
#
# ssh -G would answer this with ssh's own semantics and is what lib/answers.sh
# uses, but it cannot be used here: teeup's shipped config sets UseKeychain,
# which OpenSSH outside macOS rejects outright ("Bad configuration option",
# exit 255), so the resolver cannot read teeup's own config on the Linux CI
# runner and every check would be permanently "could not check" there.
# One definition, used everywhere this file needs the question answered.
ssh_host_block_applies() {
  local want="$1" tok positive=false
  shift
  for tok in "$@"; do
    case "$tok" in
      "!"*)
        # shellcheck disable=SC2254  # a glob from the config, matched as one
        case "$want" in
          ${tok#!}) return 1 ;;
        esac
        ;;
      *)
        if [[ "$tok" == "$want" ]]; then
          positive=true
        else
          # shellcheck disable=SC2254  # a glob from the config, matched as one
          case "$want" in
            $tok) positive=true ;;
          esac
        fi
        ;;
    esac
  done
  [[ "$positive" == "true" ]]
}

# ssh_doctor_identity_files <config-file> <alias>
# Prints, one per line, every IdentityFile value from every Host block in
# <config-file> whose pattern list matches <alias> the way ssh itself
# matches it: a literal token, or a glob (`case "$alias" in $pattern)`).
# ssh accepts `Key=Value` as well as `Key Value` on a line, and a trailing
# comment, so both forms are normalised before the line is tokenized.
ssh_doctor_identity_files() {
  local file="$1" want="$2" raw line kw tok in_block=false
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    line="${raw%%#*}"
    line="${line/=/ }"
    # Deliberate word splitting, to tokenize the line -- but pathname
    # expansion must stay off while it does: a bare `set -- $line` also
    # expands `*` and friends against files in the current directory, so a
    # config's own `Host *` (the commonest ssh pattern of all) or an
    # `IdentityFile ~/.ssh/id_*` silently turned into whatever happened to be
    # in $PWD instead of staying the literal pattern ssh itself reads (NI6).
    set -f
    # shellcheck disable=SC2086
    set -- $line
    set +f
    [[ $# -ge 1 ]] || continue
    kw="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    shift
    if [[ "$kw" == "host" ]]; then
      in_block=false
      if ssh_host_block_applies "$want" "$@"; then
        in_block=true
      fi
      continue
    fi
    if [[ "$in_block" == "true" && "$kw" == "identityfile" ]]; then
      printf '%s\n' "$*"
    fi
  done <<EOF_SSH_CFG
$(ssh_expand_includes "$file")
EOF_SSH_CFG
}

if [[ ! -d "$ssh_dir" ]]; then
  doctor_fail "No $ssh_dir, so no identity exists on this machine." "teeup configure ssh"
  doctor_verdict
  exit
fi
if [[ "$(mode_of "$ssh_dir")" == "700" ]]; then
  doctor_ok "$ssh_dir is mode 700."
else
  doctor_fail "$ssh_dir is mode $(mode_of "$ssh_dir"), not 700." "chmod 700 $ssh_dir"
fi

# identity_key is the source of truth for which file this is, teeup's own
# convention or a key named by an existing ~/.ssh/config (2026-09-20
# decision) -- never re-derived by hand, so a reused key is checked at the
# path ssh actually uses.
for identity in $(identity_list); do
  key="$(identity_key "$identity")"
  if [[ ! -s "$key" || ! -s "$key.pub" ]]; then
    doctor_fail "The $identity identity has no key pair at $key." "teeup configure ssh"
    continue
  fi
  doctor_ok "The $identity key pair is present at $key."

  # A private key file that exists and is non-empty is not necessarily a
  # private key: a half-written copy, or a passphrase pasted into the wrong
  # file, is just as non-empty. The marker line every OpenSSH/PEM private
  # key starts with never appears in a genuine key's byte stream by
  # accident, and reading only the first line never risks a passphrase
  # prompt or printing key material.
  if ! head -1 "$key" 2>/dev/null | grep -q 'PRIVATE KEY'; then
    doctor_fail "$key does not look like a private key, so ssh cannot use the $identity identity." "teeup configure ssh"
  elif have ssh-keygen; then
    if ! ssh-keygen -l -f "$key.pub" >/dev/null 2>&1; then
      doctor_fail "$key.pub is not a valid public key, so ssh cannot use the $identity key pair." "teeup configure ssh"
    # The header is not the key. A private key truncated or corrupted after
    # its first line still starts with "-----BEGIN OPENSSH PRIVATE KEY-----",
    # and both files stay non-empty, so `teeup configure ssh` skips
    # regenerating them too -- the pair reads as healthy while ssh cannot
    # load it at all.
    #
    # `-y -P '' -f <key> </dev/null` asks ssh-keygen to derive the public half.
    # Verified against a real ssh-keygen: 0 on an unencrypted key, non-zero on
    # a damaged one, and non-zero on an encrypted one, with no prompt in any
    # case -- the empty passphrase is rejected outright rather than waited on,
    # and stdin is closed as well. Only the PUBLIC half is ever printed, and
    # that goes to /dev/null.
    #
    # A failure cannot distinguish "encrypted" from "damaged" without the
    # passphrase, and teeup does not have it. That is a could-not-check, not a
    # confirmed fault -- but it is not healthy either, which is the whole
    # point: the old check said healthy.
    elif ! ssh-keygen -y -P '' -f "$key" </dev/null >/dev/null 2>&1; then
      doctor_unknown "teeup could not read $key: it is either protected by a passphrase or damaged, and without the passphrase there is no telling which. Check by hand: ssh-keygen -y -f $key" "ssh-keygen -y -f $key"
    fi
  else
    doctor_unknown "ssh-keygen is not on PATH, so teeup could not fully check the $identity key pair." "Check by hand: which ssh-keygen"
  fi

  # ssh refuses a private key that group or other can read; it does not
  # require exactly 600. Mode 400 (or 700) is just as acceptable as 600, so
  # only the last two digits -- group and other -- decide this.
  key_mode="$(mode_of "$key")"
  case "$key_mode" in
    unknown)
      doctor_unknown "$key's permissions could not be checked; no usable stat is on PATH. Check by hand: ls -l $key" "Check by hand: ls -l $key" ;;
    *00)
      : ;;
    *)
      doctor_fail "$key is mode $key_mode; ssh refuses a private key that group or other can read." "chmod 600 $key" ;;
  esac
done

# Only the aliases identity_list actually names: github.com-work is rendered
# only on a machine whose machines/<hostname>.conf configures a work
# identity, so checking for it unconditionally would fail every personal-only
# machine, which is most of them.
if [[ ! -f "$ssh_dir/config" ]]; then
  doctor_fail "No $ssh_dir/config, so no identity's key is ever offered to github.com." "teeup configure ssh"
elif [[ ! -r "$ssh_dir/config" ]]; then
  doctor_unknown "$ssh_dir/config cannot be read, so teeup could not check which Host block your keys use." "chmod u+r $ssh_dir/config"
else
  # Every pattern from every Host line, collected once: ssh reads Host
  # case-insensitively, allows leading whitespace, `Key=Value` as well as
  # `Key Value`, several patterns on one line, and ignores a trailing
  # comment. A hand-written config using any of that would otherwise fail an
  # exact, case-sensitive, whitespace-only match -- and be offered `teeup
  # reset ssh`, which would not change a thing.
  # One Host LINE at a time, not every pattern in the file flattened into one
  # list. Negation is per block -- `Host * !github.com` excludes that block
  # only -- so flattening loses which patterns belonged together and a
  # negation in one block would wrongly veto a different block that really
  # does apply. ssh reads Host case-insensitively, allows leading whitespace,
  # `Key=Value` as well as `Key Value`, several patterns on one line, and
  # ignores a trailing comment; a hand-written config using any of that must
  # not be called broken and offered a `teeup reset ssh` that changes nothing.
  host_lines="$(awk '
      { line = $0; sub(/#.*/, "", line) }
      { sub(/^[[:space:]]*[Hh][Oo][Ss][Tt][[:space:]]*=[[:space:]]*/, "Host ", line) }
      { n = split(line, f) }
      n >= 2 && tolower(f[1]) == "host" {
        out = ""
        for (i = 2; i <= n; i++) out = (out == "") ? f[i] : out " " f[i]
        print out
      }
    ' <<EOF_SSH_ROOT 2>/dev/null
$(ssh_expand_includes "$ssh_dir/config")
EOF_SSH_ROOT
)"
  for identity in $(identity_list); do
    alias_name="$(ssh_host_alias "$identity")"
    matched=false
    while IFS= read -r host_line; do
      if [[ -z "$host_line" ]]; then
        continue
      fi
      # Tokenize without letting the shell expand the globs against $PWD.
      set -f
      # shellcheck disable=SC2086
      set -- $host_line
      set +f
      if ssh_host_block_applies "$alias_name" "$@"; then
        matched=true
      fi
    done <<EOF_HOST_LINES
$host_lines
EOF_HOST_LINES
    if [[ "$matched" == "true" ]]; then
      doctor_ok "$ssh_dir/config declares Host $alias_name."
      # A Host block that exists but names a key that is not on this
      # machine is healthy in every way this script checked so far, and
      # every push still fails. A block with no IdentityFile at all is left
      # alone: ssh falls back to its own default key search, which is a
      # legitimate hand-written setup teeup never generated.
      id_files="$(ssh_doctor_identity_files "$ssh_dir/config" "$alias_name")"
      if [[ -n "$id_files" ]]; then
        any_exists=false
        while IFS= read -r idf; do
          if [[ -z "$idf" ]]; then
            continue
          fi
          # The tilde is deliberately quoted so the shell does not expand it
          # before matching: $idf is a literal string read from the config
          # file, and it is that literal leading "~/" being tested for, not
          # a real path.
          # shellcheck disable=SC2088
          case "$idf" in
            "~/"*) idf="$HOME/${idf#\~/}" ;;
            "~") idf="$HOME" ;;
          esac
          if [[ -f "$idf" ]]; then
            any_exists=true
          fi
        done <<EOF_ID_FILES
$id_files
EOF_ID_FILES
        if [[ "$any_exists" != "true" ]]; then
          doctor_fail "$ssh_dir/config's Host $alias_name block names an IdentityFile that is not on this machine, so pushes with it are refused." "teeup configure ssh"
        fi
      fi
    else
      doctor_fail "$ssh_dir/config has no 'Host $alias_name' block." "teeup reset ssh"
    fi
  done
fi

# The agent is per-session state, not configuration: a Mac that has just been
# rebooted has an empty agent and nothing is wrong. This only ever says
# whether the agent is holding something, never which key -- ssh-add -l does
# not say which identity a listed key belongs to without also running
# ssh-keygen over every public key on this machine, which is more than a
# fingerprint check earns here.
if have ssh-add; then
  # ssh-add -l separates the two: 1 means it reached the agent and the agent
  # holds nothing, 2 means it could not reach one at all. Reporting the second
  # as the first says a healthy-but-empty agent is waiting to fill on first
  # use, and prints a fix that fails with the very error being hidden.
  ssh_agent_rc=0
  ssh-add -l >/dev/null 2>&1 || ssh_agent_rc=$?
  case "$ssh_agent_rc" in
    0)
      doctor_ok "The ssh agent is holding at least one key."
      ;;
    1)
      doctor_warn "The ssh agent is holding no key yet; it fills up on first use. Run: ssh-add --apple-use-keychain $(identity_key personal)"
      ;;
    *)
      doctor_unknown "Could not reach an ssh agent (ssh-add -l exited $ssh_agent_rc), so teeup could not tell whether your key is loaded." "echo \$SSH_AUTH_SOCK, and start an agent if it is empty"
      ;;
  esac
fi

doctor_verdict
