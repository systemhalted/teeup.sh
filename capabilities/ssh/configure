#!/usr/bin/env bash
# One ed25519 key per identity. ssh-keygen prompts for a passphrase; that is
# why this capability is interactive. --apple-use-keychain then stores it in
# the login Keychain, so it is typed once and never again.
ssh_dir="$HOME/.ssh"
[[ -d "$ssh_dir" ]] || run_cmd mkdir -p "$ssh_dir"

# chmod_once <mode> <path>: only chmod when the mode is actually wrong, so a
# second configure is the reported no-op the contract asks for and a dry run
# does not print four "Would execute: chmod" lines for nothing. GNU stat is
# probed first on purpose: GNU's -f means "filesystem status" and would print
# something before failing, while BSD stat rejects -c cleanly on stderr.
chmod_once() {
  local mode="$1" path="$2" current
  [[ -e "$path" ]] || return 0
  current="$(stat -c '%a' "$path" 2>/dev/null || stat -f '%Lp' "$path" 2>/dev/null || true)"
  [[ "$current" == "$mode" ]] && return 0
  run_cmd chmod "$mode" "$path"
}

chmod_once 700 "$ssh_dir"

# --apple-use-keychain was introduced in macOS 12 (OpenSSH 8.6); macOS 11 and
# older only accept the older -K spelling. Falling back to -K unconditionally
# would silently stop storing the passphrase on every Mac this runs on today,
# so the flag has to be chosen, not just tried-and-warned.
ssh_macos_major="$(macos_major)"
if [[ "${ssh_macos_major:-99}" -lt 12 ]] 2>/dev/null; then
  ssh_keychain_flag="-K"
else
  ssh_keychain_flag="--apple-use-keychain"
fi
unset ssh_macos_major

for identity in $(identity_list); do
  key="$(identity_key "$identity")"
  if [[ -f "$key" && -f "$key.pub" ]]; then
    log "Already present: $key"
  elif [[ -f "$key" && ! -f "$key.pub" ]]; then
    # ssh-keygen can succeed after the user declines to overwrite $key.pub at
    # its interactive prompt, leaving a private key with no matching public
    # half. Rebuild the public half from the private key instead of asking
    # ssh-keygen to touch $key again. Routed through `bash -c` (not a bare
    # `run_cmd ssh-keygen ... > "$key.pub"`) so the redirect is part of the
    # command run_cmd executes, not a redirect on run_cmd's own stdout, which
    # would otherwise swallow the "Would execute" line into $key.pub on a
    # dry run.
    log "Rebuilding the missing public half for the $identity identity..."
    if ! run_cmd bash -c 'ssh-keygen -y -f "$1" > "$1.pub"' _ "$key"; then
      warn "Rebuilding $key.pub failed for the $identity identity; skipping the rest of it."
      continue
    fi
  else
    if [[ -f "$key.pub" && ! -f "$key" ]]; then
      # A public key with no matching private key is not a usable pair; back
      # it up so a fresh keygen below does not silently discard it.
      backup_target "$key.pub" >/dev/null
    fi
    log "Generating the $identity ed25519 key (you will be asked for a passphrase)..."
    if ! run_cmd ssh-keygen -t ed25519 -C "$(identity_email "$identity")" -f "$key"; then
      warn "ssh-keygen failed for the $identity identity; skipping the rest of it."
      continue
    fi
  fi
  chmod_once 600 "$key"
  chmod_once 644 "$key.pub"
  run_cmd ssh-add "$ssh_keychain_flag" "$key" || warn "ssh-add failed for $key."
done

copy_config_once "$TEEUP_CAP_DIR/config/ssh/config" "$ssh_dir/config"
chmod_once 600 "$ssh_dir/config"
