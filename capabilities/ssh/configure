#!/usr/bin/env bash
# One ed25519 key per identity, usually just one identity (personal); a work
# identity exists only when machines/<hostname>.conf configures one. An
# existing ~/.ssh/config is authority (2026-09-17 decision): identity_key
# (lib/answers.sh) already prefers whatever key such a config names over
# teeup's own id_ed25519_<identity> convention, so this script generates
# nothing for an identity that already has one, and only ever writes its own
# ssh config when the user has none. ssh-keygen prompts for a passphrase;
# that is why this capability is interactive. --apple-use-keychain then
# stores it in the login Keychain, so it is typed once and never again.
ssh_dir="$HOME/.ssh"
# Whether teeup made this directory decides whether teeup sets its mode: the
# files under an existing ~/.ssh are the user's, and so is the directory.
ssh_dir_is_ours=false
if [[ ! -d "$ssh_dir" ]]; then
  run_cmd mkdir -p "$ssh_dir"
  ssh_dir_is_ours=true
fi

# file_mode <path> -> the octal mode, or nothing. GNU stat is probed first on
# purpose: GNU's -f means "filesystem status" and would print something before
# failing, while BSD stat rejects -c cleanly on stderr.
file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || true
}

# chmod_ours <mode> <path>: set the mode of a file teeup itself created. Only
# when the mode is actually wrong, so a second configure is the reported no-op
# the contract asks for and a dry run does not print four "Would execute:
# chmod" lines for nothing. Never through a symlink: the mode would land on
# whatever the link points at, which by definition is not a file teeup made.
chmod_ours() {
  local mode="$1" path="$2" current
  [[ -e "$path" && ! -L "$path" ]] || return 0
  current="$(file_mode "$path")"
  [[ "$current" == "$mode" ]] && return 0
  run_cmd chmod "$mode" "$path"
}

# The mode of a file teeup did not create is the user's business -- chmodding
# it lands as a diff in whatever manages it, and teeup's whole premise here is
# that an existing ~/.ssh is the user's. It only says something when the mode
# is loose enough to matter, and says what to run.
#
# warn_if_group_or_other <path> <what>: a private key readable by anyone but
# its owner. ssh refuses to use one.
warn_if_group_or_other() {
  local path="$1" what="$2" current
  [[ -e "$path" ]] || return 0
  current="$(file_mode "$path")"
  case "$current" in
    ???) ;;
    *) return 0 ;;
  esac
  [[ "${current#?}" == "00" ]] && return 0
  warn "$what $path is mode $current and teeup did not create it, so its mode is left alone."
  warn "ssh refuses a private key others can read. Tighten it with: chmod 600 $path"
}

# warn_if_writable_by_others <path> <what>: anyone but the owner able to write
# a config or the directory holding the keys.
warn_if_writable_by_others() {
  local path="$1" what="$2" current group other
  [[ -e "$path" ]] || return 0
  current="$(file_mode "$path")"
  case "$current" in
    ???) ;;
    *) return 0 ;;
  esac
  group="${current#?}"
  group="${group%?}"
  other="${current#??}"
  (( (group & 2) == 0 && (other & 2) == 0 )) && return 0
  warn "$what $path is mode $current and teeup did not create it, so its mode is left alone."
  warn "Anyone in its group can rewrite it. Tighten it with: chmod go-w $path"
}

if [[ "$ssh_dir_is_ours" == "true" ]]; then
  chmod_ours 700 "$ssh_dir"
else
  warn_if_writable_by_others "$ssh_dir" "The ssh directory"
fi

# --apple-use-keychain was introduced in macOS 12 (OpenSSH 8.6); macOS 11 and
# older only accept the older -K spelling. Falling back to -K unconditionally
# would silently stop storing the passphrase on every Mac this runs on today,
# so the flag has to be chosen, not just tried-and-warned.
ssh_macos_major="$(macos_major)"
if [[ "${ssh_macos_major:-99}" -lt 12 ]] 2>/dev/null; then
  ssh_keychain_flag="-K"
else
  ssh_keychain_flag="--apple-use-keychain"
fi
unset ssh_macos_major

for identity in $(identity_list); do
  key="$(identity_key "$identity")"
  # identity_key already consulted ~/.ssh/config; a path that differs from
  # teeup's own convention came from there, and is worth saying so about.
  if [[ "$key" != "$HOME/.ssh/id_ed25519_$identity" ]]; then
    log "Using the $identity key already named in $ssh_dir/config: $key"
  fi
  # -s, not -f, for both halves: a zero-byte file is a missing one. The first
  # version of the rebuild below left exactly such a $key.pub behind when the
  # passphrase was mistyped, and a -f guard then reported the pair "Already
  # present" on every later run, so the empty file was never repaired and was
  # what got handed to GitHub. A zero-byte private half (a killed ssh-keygen,
  # a botched restore) is the mirror image: ssh-add can only warn and the
  # github capability would upload an orphan .pub. Routing both through the
  # repair paths is what makes a re-run the repair path again.
  if [[ -s "$key" && -s "$key.pub" ]]; then
    log "Already present: $key"
  elif [[ -s "$key" && ! -s "$key.pub" ]]; then
    # ssh-keygen can succeed after the user declines to overwrite $key.pub at
    # its interactive prompt, leaving a private key with no matching public
    # half. Rebuild the public half from the private key instead of asking
    # ssh-keygen to touch $key again. Routed through `bash -c` (not a bare
    # `run_cmd ssh-keygen ... > "$key.pub"`) so the redirect is part of the
    # command run_cmd executes, not a redirect on run_cmd's own stdout, which
    # would otherwise swallow the "Would execute" line into $key.pub on a
    # dry run.
    #
    # The redirect writes to a temp file in $HOME/.ssh, never to $key.pub
    # directly: the shell creates and truncates a redirect target *before*
    # ssh-keygen runs, so `> "$1.pub"` left a zero-byte .pub behind whenever
    # the passphrase was mistyped or cancelled. The next run then saw both
    # halves present, skipped the repair for good, and handed GitHub an empty
    # key. Only a ssh-keygen that succeeded and produced a non-empty file is
    # moved into place; anything else takes the temp file with it.
    log "Rebuilding the missing public half for the $identity identity..."
    if ! run_cmd bash -c '
      tmp="$(mktemp "$1.teeup_rebuild_XXXXXX")" || exit 1
      if ssh-keygen -y -f "$1" > "$tmp" && [ -s "$tmp" ]; then
        mv "$tmp" "$1.pub"
      else
        rm -f "$tmp"
        exit 1
      fi' _ "$key"; then
      warn "Rebuilding $key.pub failed for the $identity identity; skipping the rest of it."
      continue
    fi
  else
    # -L as well as -e, for both halves: a dangling symlink is invisible to
    # every -e, -f and -s test (they all follow the link), so the backup guard
    # never fired and ssh-keygen wrote the new PRIVATE key through the link,
    # to wherever it pointed -- possibly outside ~/.ssh entirely, into a synced
    # folder or a dotfiles repo. A symlink at a key path is never a file teeup
    # created, so it is foreign by definition: back it up and put a real file
    # in its place, never write through it.
    if [[ -L "$key" ]]; then
      log "$key is a symlink; backing it up so the new key is a real file."
      backup_target "$key" >/dev/null
    elif [[ -e "$key" ]]; then
      # Zero bytes (the -s tests above failed). Moved aside rather than left
      # for ssh-keygen, whose "Overwrite (y/n)?" prompt on an existing file
      # would stall a run that has no answer for it.
      log "Empty private key at $key; backing it up before generating a fresh pair."
      backup_target "$key" >/dev/null
    fi
    if [[ -e "$key.pub" || -L "$key.pub" ]]; then
      # A public key with no usable private key is not a pair; back it up so
      # a fresh keygen below does not silently discard it.
      backup_target "$key.pub" >/dev/null
    fi
    log "Generating the $identity ed25519 key (you will be asked for a passphrase)..."
    if ! run_cmd ssh-keygen -t ed25519 -C "$(identity_email "$identity")" -f "$key"; then
      warn "ssh-keygen failed for the $identity identity; skipping the rest of it."
      continue
    fi
  fi
  # teeup's own convention is the one path teeup creates keys at; a key
  # adopted from the user's ssh config is theirs, mode included (the .pub of
  # such a pair used to be *loosened* from 600 to 644 here).
  if [[ "$key" == "$HOME/.ssh/id_ed25519_$identity" ]]; then
    chmod_ours 600 "$key"
    chmod_ours 644 "$key.pub"
  else
    warn_if_group_or_other "$key" "The key"
  fi
  run_cmd ssh-add "$ssh_keychain_flag" "$key" || warn "ssh-add failed for $key."
done

# ssh_work_alias_block: the Host block teeup's own config uses for the work
# identity, printed only when there is a work identity to name. The alias is
# local (github.com-work), but HostName is the identity's real host, so a work
# identity on a GitHub Enterprise instance is reachable through the same alias
# as a second github.com account.
ssh_work_alias_block() {
  local alias host key display
  alias="$(ssh_host_alias work)"
  host="$(identity_gh_host work)"
  key="$(identity_key work)"
  display="$key"
  case "$key" in "$HOME"/*) display="~${key#"$HOME"}" ;; esac
  printf '# Clone work repositories as git@%s:org/repo.git, which picks the\n' "$alias"
  printf '# work key. git itself has one identity, whatever the directory.\n'
  printf 'Host %s\n  HostName %s\n  User git\n  IdentityFile %s\n  IdentitiesOnly yes\n\n' \
    "$alias" "$host" "$display"
}

# An existing ~/.ssh/config is authority: teeup never backs up and replaces
# a foreign one (copy_config_once's usual behaviour for every other shipped
# config) because that would ask the Host blocks read above to point at
# keys this run may have just decided not to touch. It only ever writes its
# own config when there is none yet.
ssh_config_is_foreign=false
if [[ -e "$ssh_dir/config" || -L "$ssh_dir/config" ]]; then
  log "Already present: $ssh_dir/config"
  # A config teeup installed itself already carries the aliases below; only a
  # file teeup never wrote is the user's to be told about.
  [[ -n "$(stock_sha "$ssh_dir/config" || true)" ]] || ssh_config_is_foreign=true
else
  # Rendered, not copied as-is: the work alias exists only on a machine with a
  # work identity. Shipping it everywhere left every other machine with a Host
  # block naming a key that does not exist, under IdentitiesOnly yes.
  ssh_rendered_config="$(mktemp)"
  ssh_work_alias_written=false
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "#TEEUP_WORK_ALIAS"*)
        # The marker's own lines never reach the installed file; the block
        # takes the place of the first of them, and only when this machine
        # has a work identity at all.
        if [[ "$ssh_work_alias_written" == "false" ]] && answers_has_work; then
          ssh_work_alias_block
          ssh_work_alias_written=true
        fi
        ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$TEEUP_CAP_DIR/config/ssh/config" > "$ssh_rendered_config"
  copy_config_once "$ssh_rendered_config" "$ssh_dir/config" "$TEEUP_CAP_DIR/config/ssh/config"
  rm -f "$ssh_rendered_config"
fi
if [[ "$ssh_config_is_foreign" == "true" ]]; then
  warn_if_writable_by_others "$ssh_dir/config" "The ssh config"
else
  chmod_ours 600 "$ssh_dir/config"
fi

# A config teeup did not write is never rewritten -- but then nothing has told
# the user that the key this run just generated is not reachable through any
# Host block, so `git@github.com-work:org/repo.git` resolves to a host that
# does not exist and the key is only ever offered by the agent. Say so, with
# the block to paste and the file to paste it into.
if [[ "$ssh_config_is_foreign" == "true" ]]; then
  for identity in $(identity_list); do
    # What the config names for this alias, against the key actually in use:
    # they differ when the config names none at all, and also when it names
    # one that is not there (identity_key falls back to teeup's own path,
    # which ssh would then never offer for that host).
    ssh_named_key="$(ssh_config_named_key "$identity" || true)"
    [[ "$ssh_named_key" == "$(identity_key "$identity")" ]] && continue
    warn "$ssh_dir/config is yours and has no Host block for the $identity key."
    warn "git@$(ssh_host_alias "$identity"):org/repo.git will not resolve until you add this to $ssh_dir/config:"
    printf '\n'
    printf 'Host %s\n' "$(ssh_host_alias "$identity")"
    printf '  HostName %s\n' "$(identity_gh_host "$identity")"
    printf '  User git\n'
    printf '  IdentityFile %s\n' "$(identity_key "$identity")"
    printf '  IdentitiesOnly yes\n'
    printf '\n'
  done
fi

# git runs before ssh in the core list, so `git configure` ran with no keys on
# disk and wrote commit.gpgsign = false. The keys exist now, so re-render git's
# generated settings here; otherwise a first bootstrap finishes with commit
# signing off and the only sign of it is a log line the user has to notice.
# cap_run comes from the library every capability script has loaded, and git
# configure touches nothing under ~/.ssh, so there is no recursion.
#
# Only when git has already been configured: a standalone `teeup configure ssh`
# on a machine whose git capability has never run has nothing to re-render. In
# a dry run nothing was installed, so that file does not exist either --
# preview the re-run anyway rather than hiding a step the real run performs.
ssh_git_config="$(user_config_dir)/git/config"
if [[ "$DRY_RUN" == "true" || -f "$ssh_git_config" ]]; then
  log "Re-running the git configuration now that the keys exist."
  cap_run git configure || warn "Could not re-run the git configuration. Run: teeup configure git"
else
  log "No $ssh_git_config yet; commit signing turns on at: teeup configure git"
fi
