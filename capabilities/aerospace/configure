#!/usr/bin/env bash
# AeroSpace's own README states its floor: "AeroSpace binary runs on: macOS
# 13+". Below that install already declined to fetch it, so there is no app
# to point a config at and no Accessibility toggle worth naming.
aerospace_macos_major="$(macos_major)"
if [[ "${aerospace_macos_major:-99}" -lt 13 ]] 2>/dev/null; then
  not_applicable "AeroSpace requires macOS 13 or newer; this Mac is on macOS $aerospace_macos_major, so there is nothing to configure."
fi
unset aerospace_macos_major

# AeroSpace has no include mechanism and reads exactly one config file, so
# there is no per-machine overlay to fold in: teeup copies its aerospace.toml
# into place once and the machine's owner edits that file directly. The
# stock-checksum rule in copy_config_once/refresh_if_pristine is what makes
# that safe -- teeup replaces the file only while it is still byte-for-byte
# what teeup last wrote, and an edited one is reported and left alone.
#
# This replaced a merge that folded a local.toml onto the shipped base. Six
# review rounds found twelve defects in it, several of which produced a config
# AeroSpace would not load, and hand-modelling TOML in awk was the wrong tool
# for the job. Copy-once has no parser to get wrong.
#
# AeroSpace also reads ~/.aerospace.toml, the location its own guide suggests,
# and reports a config in both places as ambiguous. An existing one is the
# user's working setup, so teeup's copy is not installed next to it.
HOME_AERO="$HOME/.aerospace.toml"
AEROSPACE_CFG_DIR="$(user_config_dir)/aerospace"
AEROSPACE_DEST_TOML="$AEROSPACE_CFG_DIR/aerospace.toml"
AEROSPACE_SRC_TOML="$TEEUP_CAP_DIR/config/aerospace/aerospace.toml"

if [[ -e "$HOME_AERO" ]]; then
  log "Keeping your $HOME_AERO; teeup's aerospace.toml was not installed, because AeroSpace reports two configs as ambiguous. To use teeup's, move $HOME_AERO aside and run: teeup configure aerospace"
else
  # Where AeroSpace is running it gets the last word before anything is
  # installed: a config it rejects must never reach $AEROSPACE_DEST_TOML.
  # The file being shipped is teeup's own and is expected to pass, so a
  # failure here means teeup's shipped config is broken -- worth failing
  # loudly rather than installing. Skipped under DRY_RUN, which must never
  # touch $AEROSPACE_DEST_TOML even to stage a check.
  if [[ "$DRY_RUN" != "true" ]]; then
    AEROSPACE_VALIDATION_ERR=""
    if ! AEROSPACE_VALIDATION_ERR="$(aerospace_config_ok "$AEROSPACE_DEST_TOML" "$AEROSPACE_SRC_TOML")"; then
      err "AeroSpace rejected teeup's own aerospace.toml, so $AEROSPACE_DEST_TOML was not changed. AeroSpace said: $AEROSPACE_VALIDATION_ERR"
      exit 1
    fi
  fi
  AEROSPACE_REFRESH_RC=0
  copy_config_once "$AEROSPACE_SRC_TOML" "$AEROSPACE_DEST_TOML" || AEROSPACE_REFRESH_RC=$?
  if [[ "$AEROSPACE_REFRESH_RC" -ne 0 ]]; then
    err "$AEROSPACE_DEST_TOML was not updated, so AeroSpace is still on its previous configuration."
    exit 1
  fi
fi

if [[ -d "${TEEUP_APPS_DIR:-/Applications}/AeroSpace.app" ]]; then
  log "AeroSpace is installed."
elif casks_supported; then
  log "AeroSpace will appear in /Applications once its cask finishes installing."
else
  warn "MacPorts has no AeroSpace cask; download it from https://github.com/nikitabobko/AeroSpace/releases and move it to /Applications."
fi

# No script can grant Accessibility: macOS requires a human in System Settings,
# and doctor re-checks the part of this that is checkable. The step is printed
# in full the first time only (state_done ensure succeeds once per machine):
# teeup update re-runs every core configure, and the block on every update
# would train people to skip it. Later runs print one line.
if state_done ensure aerospace-accessibility-notice; then
  cat <<'STEP'
One manual step, once per machine:
  System Settings > Privacy & Security > Accessibility > turn AeroSpace on
Until you do, AeroSpace cannot move a single window. Then start it with:
  open -a AeroSpace
STEP
else
  log "If AeroSpace cannot move windows, turn it on under System Settings > Privacy & Security > Accessibility."
fi
