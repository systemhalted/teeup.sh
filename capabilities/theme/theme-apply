#!/usr/bin/env bash
# Push the rendered palettes into ~/.config/starship.toml, which plan 2a ships
# with a `palette = "teeup-dark"` root key and a populated marker block near
# the top. The file belongs to the user, so only the region between the
# markers and that one root key are rewritten; everything else is left alone.
STARSHIP="$(user_config_dir)/starship.toml"
START="# teeup:theme-palette:start"
END="# teeup:theme-palette:end"
THEME_DIR="${TEEUP_THEME_DIR:-$TEEUP_STATE_DIR/current/theme}"

if [[ ! -f "$STARSHIP" ]]; then
  log "No $STARSHIP yet; its palette will be written the next time you run teeup theme set."
  exit 0
fi
start_count="$(grep -cxF "$START" "$STARSHIP" || true)"
end_count="$(grep -cxF "$END" "$STARSHIP" || true)"
if [[ "$start_count" -eq 0 && "$end_count" -eq 0 ]]; then
  warn "$STARSHIP has no '$START' block; leaving it alone."
  exit 0
fi
# The rewrite below drops everything from the start marker to the next end
# marker. An end marker above the start, a second start or a missing end would
# make that delete the user's own tables or duplicate a palette table (a TOML
# parse error), so anything but one start followed by one end is refused.
start_line="$(grep -n -xF "$START" "$STARSHIP" | head -1 | cut -d: -f1)"
end_line="$(grep -n -xF "$END" "$STARSHIP" | head -1 | cut -d: -f1)"
problem=""
if [[ "$start_count" -eq 0 ]]; then
  problem="it has an end marker but no start marker"
elif [[ "$end_count" -eq 0 ]]; then
  problem="it has a start marker but no end marker"
elif [[ "$start_count" -gt 1 ]]; then
  problem="it has $start_count start markers"
elif [[ "$end_count" -gt 1 ]]; then
  problem="it has $end_count end markers"
elif [[ "$start_line" -gt "$end_line" ]]; then
  problem="the end marker comes before the start marker"
fi
if [[ -n "$problem" ]]; then
  warn "$STARSHIP: $problem ('$START' ... '$END'); leaving it alone."
  exit 0
fi

# `palette = ` is a root key, and in TOML a bare key after a table header
# belongs to that table. Plan 2a puts the palette line and this block at the top
# of the file for exactly that reason; if something moved them below a [table],
# rewriting them in place would produce a palette starship never reads, so stop
# and say so instead of writing something that silently does nothing.
first_table_line="$(grep -n '^\[' "$STARSHIP" | head -1 | cut -d: -f1)"
if [[ -n "$first_table_line" && "$start_line" -gt "$first_table_line" ]]; then
  warn "$STARSHIP has the teeup palette block below its first [table]; a root 'palette =' key there would belong to that table. Move the block and the 'palette =' line above line $first_table_line, then run: teeup theme set $(theme_current)"
  exit 0
fi
# The block may hold only [palettes.<name>] tables; everything in it is
# replaced. A table of the user's between the markers (an end marker moved to
# the bottom of the file) means the end marker is not above the first
# non-palette table, and the rewrite would delete that table.
other_table="$(grep -n '^\[' "$STARSHIP" | grep -v '^[0-9]*:\[palettes\.[^]]*\]' | head -1)"
other_table_line="${other_table%%:*}"
if [[ -n "$other_table" && "$other_table_line" -lt "$end_line" ]]; then
  warn "$STARSHIP: ${other_table#*:} at line $other_table_line sits between the teeup palette markers, and the palette rewrite would delete it; leaving it alone. Move '$END' above it, then run: teeup theme set $(theme_current)"
  exit 0
fi

block="$(mktemp)"
for mode in dark light; do
  rendered="$THEME_DIR/$mode/starship-palette.toml"
  if [[ -f "$rendered" ]]; then
    cat "$rendered" >> "$block"
    echo "" >> "$block"
  fi
done

if [[ ! -s "$block" ]]; then
  warn "No rendered starship palettes in $THEME_DIR; leaving $STARSHIP alone."
  rm -f "$block"
  exit 0
fi

# The root palette selector is the first `palette = ` line that sits before
# the first table header outside the marker block (other_table_line, computed
# above; the block's own [palettes.*] headers are replaced wholesale and never
# count as a table for this purpose). A `palette =` inside some other table
# belongs to that table and must never be rewritten. When no such line exists,
# root_palette_line stays empty and one is inserted immediately before the
# start marker instead -- already verified to sit above the first real
# [table] (checked above), so the insertion lands at the TOML root.
root_palette_line=""
while IFS=: read -r candidate_line _; do
  if [[ "$candidate_line" -ge "$start_line" && "$candidate_line" -le "$end_line" ]]; then
    continue
  fi
  if [[ -n "$other_table_line" && "$candidate_line" -ge "$other_table_line" ]]; then
    break
  fi
  root_palette_line="$candidate_line"
  break
done < <(grep -n '^palette *=' "$STARSHIP" || true)

active="teeup-$(appearance)"
rewritten="$(mktemp)"
# Values reach awk through ENVIRON, not -v: -v processes backslash escapes, so
# a TMPDIR containing `\n` would name a different block file. rootline is a
# line number (or 0, meaning "insert before the start marker instead").
TEEUP_AWK_BLOCK="$block" TEEUP_AWK_PALETTE="$active" TEEUP_AWK_START="$START" TEEUP_AWK_END="$END" TEEUP_AWK_ROOT_LINE="$root_palette_line" awk '
  BEGIN { blockfile = ENVIRON["TEEUP_AWK_BLOCK"]; pal = ENVIRON["TEEUP_AWK_PALETTE"]
          start = ENVIRON["TEEUP_AWK_START"]; end = ENVIRON["TEEUP_AWK_END"]
          rootline = ENVIRON["TEEUP_AWK_ROOT_LINE"] + 0 }
  $0 == start { if (rootline == 0) printf "palette = \"%s\"\n", pal
                print; skip = 1; while ((getline line < blockfile) > 0) print line; close(blockfile); next }
  $0 == end   { skip = 0; print; next }
  skip        { next }
  rootline != 0 && NR == rootline { printf "palette = \"%s\"\n", pal; next }
  { print }
' "$STARSHIP" > "$rewritten"

# write_managed_file already warns on its own refusal (M11); `|| true` keeps
# that a warning instead of skipping the cleanup below under `bash -eu`.
write_managed_file "$STARSHIP" "starship palette ($active)" < "$rewritten" || true
rm -f "$block" "$rewritten"
