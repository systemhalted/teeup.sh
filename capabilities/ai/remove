#!/usr/bin/env bash
# The aggregate is the one explicit request for all five, so removing it owns
# the symmetric all-five cleanup. Continue across leaves to remove everything
# safe, but keep cap-ai marked when any wrapper or state marker fails.
failed=""
for child in ai-claude ai-codex ai-gemini ai-copilot ai-opencode; do
  if ! cap_run "$child" remove; then
    failed="$failed $child"
    continue
  fi
  if ! state_done clear "cap-$child"; then
    failed="$failed $child"
    continue
  fi
  state_na clear "cap-$child" || true
done
failed="${failed# }"
if [[ -n "$failed" ]]; then
  err "Could not finish removing:$failed. Fix the warnings, then run: teeup remove ai"
  exit 1
fi
