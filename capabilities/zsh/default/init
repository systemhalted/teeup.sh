# capabilities/zsh/default/init - tool activation, last in the rc chain.
# Every block is guarded: on a machine without the tool the shell pays nothing
# and prints nothing.

if _teeup_mise_path="$(command -v mise)" 2>/dev/null; then
  eval "$("$_teeup_mise_path" activate zsh)"
  # mise rewrites PATH per directory, so command hashing has to be off.
  setopt NO_HASH_CMDS
fi

if _teeup_starship_path="$(command -v starship)" 2>/dev/null && [[ "${TERM:-}" != "dumb" ]]; then
  eval "$("$_teeup_starship_path" init zsh)"
fi

_teeup_hook_guard() {
  if (( ${+_teeup_starship_path} )) && [[ ! -x "$_teeup_starship_path" ]]; then
    precmd_functions=("${(@)precmd_functions:#starship_precmd}")
    preexec_functions=("${(@)preexec_functions:#starship_preexec}")
    PROMPT='%~ %# '
    unset _teeup_starship_path
  fi
  if (( ${+_teeup_mise_path} )) && [[ ! -x "$_teeup_mise_path" ]]; then
    precmd_functions=("${(@)precmd_functions:#_mise_hook}")
    chpwd_functions=("${(@)chpwd_functions:#_mise_hook}")
    unset _teeup_mise_path
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _teeup_hook_guard

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v fzf >/dev/null 2>&1; then
  # fzf 0.48 and newer ship their integration in the binary; older builds
  # shipped shell files next to the install prefix. Run it once, not once as
  # a probe and again for real: every interactive shell would otherwise pay
  # for a second fzf process.
  if _teeup_fzf_zsh="$(fzf --zsh 2>/dev/null)"; then
    eval "$_teeup_fzf_zsh"
  else
    for _f in /opt/homebrew/opt/fzf/shell /usr/local/opt/fzf/shell /opt/local/share/fzf/shell; do
      [ -r "$_f/completion.zsh" ] && . "$_f/completion.zsh"
      [ -r "$_f/key-bindings.zsh" ] && . "$_f/key-bindings.zsh"
    done
    unset _f
  fi
  unset _teeup_fzf_zsh
fi
