# capabilities/zsh/default/env - environment for every zsh, interactive or not.
# teeup owns this file; it is replaced on every teeup update. Your exports go
# in ~/.config/zsh/local.zsh or below the source line in ~/.zshenv.
# POSIX-shaped on purpose: a plain sh that sources it still works.

# --- PATH helpers ------------------------------------------------------------
# Remove every occurrence of $1 from PATH. POSIX parameter expansion only.
path_remove() {
  _pr=":$PATH:"
  while :; do
    case "$_pr" in
      *":$1:"*) _pr="${_pr%%":$1:"*}:${_pr#*":$1:"}" ;;
      *) break ;;
    esac
  done
  _pr="${_pr#:}"
  PATH="${_pr%:}"
  unset _pr
}

# Put $1 first even when it is already further back. This file is sourced more
# than once per login (~/.zshenv, then ~/.zprofile after macOS's path_helper
# and `brew shellenv` have prepended their own directories), and every pass has
# to restore user-path precedence.
path_prepend() {
  [ -d "$1" ] || return 0
  path_remove "$1"
  PATH="$1${PATH:+:$PATH}"
}

# Append only when missing; appended entries are meant to stay last.
path_append() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$PATH:$1" ;;
  esac
}

# --- teeup paths -------------------------------------------------------------
# TEEUP_PATH comes from ~/.config/teeup/env, sourced just before this file.
# TEEUP_STATE_DIR uses the same formula as lib/core.sh so the shell and the CLI
# never disagree about where generated files live.
TEEUP_STATE_DIR="${TEEUP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/teeup}"
export TEEUP_STATE_DIR

# --- package manager prefixes ------------------------------------------------
# Whichever backend the wizard recorded wins: path_prepend always wins ties by
# being the most recent call, so the selected prefix is prepended last and the
# other one first. Doing it here (rather than relying on `brew shellenv`)
# means shells that never run it (ssh commands, cron, GUI launchers) still
# find the binaries. TEEUP_TEST_PREFIX_ROOT is a test-only hook (see
# TEEUP_TEST_MISSING in lib/core.sh for the same pattern): it relocates the
# /opt and /usr/local trees below a temp directory so tests never touch the
# real ones.
_teeup_prefix_root="${TEEUP_TEST_PREFIX_ROOT:-}"

# The answers file holds only TEEUP_* assignments (teeup's own writer refuses
# any other key), so sourcing it here cannot leak unrelated shell state beyond
# the TEEUP_* exports it already contains, TEEUP_PACKAGE_MANAGER among them.
# TEEUP_CONFIG_DIR wins when set (the env file sourced just above this file
# exports it), so a non-default XDG_CONFIG_HOME or TEEUP_CONFIG_DIR can never
# make this disagree with lib/core.sh's user_config_dir()/answers_file().
_teeup_answers="${TEEUP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/teeup}/answers"
[ -r "$_teeup_answers" ] && . "$_teeup_answers"
unset _teeup_answers

# The machine file overrides the answers file (answers_load in lib/answers.sh
# sources it last, for the same reason): it encodes hard constraints such as
# the package manager, and the CLI and this shell layer must agree on which
# backend is in effect. It also has to agree on *which* machine file: the
# user's own, under $TEEUP_CONFIG_DIR/machines/, wins over the checkout's,
# the same overlay machine_file() in lib/answers.sh gives the CLI -- written
# again here, in this file's own POSIX sh, because a shell startup path has
# no access to that library. `hostname -s` runs once (with the same fallback
# to a bare `hostname` for a `-s` that is not supported); trying the user's
# path first costs one more `[ -r ]` test, a stat next to the fork `hostname`
# already pays, so this stays cheap enough for every shell start.
_teeup_host="$(hostname -s 2>/dev/null || hostname || true)"
_teeup_machine="${TEEUP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/teeup}/machines/$_teeup_host.conf"
[ -r "$_teeup_machine" ] || _teeup_machine="$TEEUP_PATH/machines/$_teeup_host.conf"
[ -r "$_teeup_machine" ] && . "$_teeup_machine"
unset _teeup_host _teeup_machine

# No answer on record (a bare shell before the wizard ever ran, or an answers
# file that predates this key) falls back to the old Darwin-version heuristic:
# macOS 12 and older gets MacPorts, since Homebrew dropped support there.
# Anything else, including a non-Darwin uname, defaults to Homebrew.
_teeup_backend="${TEEUP_PACKAGE_MANAGER:-}"
if [ -z "$_teeup_backend" ]; then
  _teeup_darwin="$(uname -r 2>/dev/null || true)"
  _teeup_darwin="${_teeup_darwin%%.*}"
  if [ "${_teeup_darwin:-99}" -le 21 ] 2>/dev/null; then
    _teeup_backend=macports
  fi
  unset _teeup_darwin
fi
[ "$_teeup_backend" = "macports" ] || _teeup_backend=homebrew

_teeup_brew=""
if [ -x "$_teeup_prefix_root/opt/homebrew/bin/brew" ]; then
  _teeup_brew="$_teeup_prefix_root/opt/homebrew"
elif [ -x "$_teeup_prefix_root/usr/local/bin/brew" ]; then
  _teeup_brew="$_teeup_prefix_root/usr/local"
fi
if [ "$_teeup_backend" = "macports" ]; then
  if [ -n "$_teeup_brew" ]; then
    path_prepend "$_teeup_brew/sbin"
    path_prepend "$_teeup_brew/bin"
  fi
  path_prepend "$_teeup_prefix_root/opt/local/sbin"
  path_prepend "$_teeup_prefix_root/opt/local/bin"
else
  path_prepend "$_teeup_prefix_root/opt/local/sbin"
  path_prepend "$_teeup_prefix_root/opt/local/bin"
  if [ -n "$_teeup_brew" ]; then
    path_prepend "$_teeup_brew/sbin"
    path_prepend "$_teeup_brew/bin"
  fi
fi
unset _teeup_backend _teeup_brew _teeup_prefix_root

# Cargo's own bin directory. mise's rust backend is rustup, which installs
# into ~/.rustup and ~/.cargo, and anything `cargo install` puts in
# ~/.cargo/bin is covered by no shim. Ported from the chezmoi repo's
# ~/.config/shell/envs; prepended BEFORE ~/.local/bin so that one still wins
# -- teeup's own wrappers live there and a cargo-installed binary of the same
# name must not shadow one.
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.local/bin"

# Go's workspace, ported from the same file: it pins a location rather than
# taking Go's own ~/go default. path_append adds only a directory that exists,
# so a machine without Go gains the variable and nothing else. This has to
# stay ABOVE the two shims lines below -- they are appended last on purpose,
# and the teeup shims must remain the final PATH entry (checked by
# capabilities/teeup-runtime/doctor).
export GOPATH="${GOPATH:-$HOME/Development/GoWorkspace}"
path_append "$GOPATH/bin"
# mise's own shims let shells without `mise activate` find mise tools. mise
# itself resolves its data root from MISE_DATA_DIR, then XDG_DATA_HOME, then
# ~/.local/share (in that order), so this has to match or the shims directory
# named here is not the one mise actually populates. teeup's lazy-install
# shims come after them and after everything else: a shim exists only to
# catch a command nothing real provides (spec section 6).
path_append "${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
# Moved rather than only appended: path_append leaves an entry where an
# inherited PATH already had it, and a nested shell can inherit the shims
# ahead of a directory its parent's local.zsh appended.
path_remove "$TEEUP_STATE_DIR/shims"
path_append "$TEEUP_STATE_DIR/shims"
export PATH

# --- editor ------------------------------------------------------------------
# A lazy shim answers `command -v` for a command nothing installed provides
# (the neovim capability's provides="nvim"), so a hit inside the shims
# directory is not an editor. The shims are last on PATH, so a real nvim
# anywhere would have been found first.
#
# `|| true` is not decoration: an assignment whose command substitution exits
# non-zero takes the whole shell down under `set -e` (verified in bash and in
# zsh), and this file is read by every zsh that starts, including
# `zsh -e -c ...`. Without it, a machine with no nvim and no shim -- neovim
# skipped, say -- would abort shell startup here instead of falling through to
# the vim fallback below. Every command substitution in this file needs the
# same guard, for the same reason.
_teeup_nvim="$(command -v nvim 2>/dev/null || true)"
case "$_teeup_nvim" in
  "$TEEUP_STATE_DIR/shims/"*) _teeup_nvim="" ;;
esac
if [ -z "${EDITOR:-}" ]; then
  if command -v emacsclient >/dev/null 2>&1; then
    # An empty ALTERNATE_EDITOR makes emacsclient start the daemon itself.
    ALTERNATE_EDITOR=""
    export ALTERNATE_EDITOR
    EDITOR="emacsclient -t"
  elif [ -n "$_teeup_nvim" ]; then
    EDITOR="nvim"
  else
    EDITOR="vim"
  fi
  export EDITOR
fi
unset _teeup_nvim
# Defaulted, not forced: a parent process that set VISUAL or SUDO_EDITOR on
# purpose keeps its value, and an inherited EDITOR does not silently become
# all three.
export VISUAL="${VISUAL:-$EDITOR}"
export SUDO_EDITOR="${SUDO_EDITOR:-$EDITOR}"

# --- everything else ---------------------------------------------------------
# BAT_THEME is the shell-level theme hook; `teeup theme set` overrides this
# default through the generated file sourced in default/rc.
export BAT_THEME="${BAT_THEME:-ansi}"
export LESS="${LESS:--R}"
if command -v bat >/dev/null 2>&1; then
  export MANROFFOPT="-c"
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# Self-maintained Emacs packages, ported from the chezmoi repo's
# ~/.config/shell/envs: point the Emacs configuration at local checkouts when
# there are any. The preferred single-root layout is
# ~/Work/environment/emacs/packages; ~/Work/emacs/packages remains as a
# migration fallback, and the three older paths stay so existing machines
# still resolve.
#
# Each variable is resolved independently and the loop stops only once all
# three are set, so checkouts split across two roots are all found. Breaking
# at the first root that exists would silently lose the rest. With no checkout
# anywhere every variable stays unset and the Emacs configuration installs the
# packages from GitHub instead.
for _teeup_pkg_dir in "$HOME/Work/environment/emacs/packages" \
                      "$HOME/Work/emacs/packages" \
                      "$HOME/Work/products/emacs-packages" \
                      "$HOME/Workspaces/Palak/products/emacs-packages" \
                      "$HOME/Workspaces/Personal/products/emacs-packages"; do
  [ -d "$_teeup_pkg_dir" ] || continue
  if [ -z "${SDKMAN_EL_DIR:-}" ] && [ -d "$_teeup_pkg_dir/sdkman.el" ]; then
    export SDKMAN_EL_DIR="$_teeup_pkg_dir/sdkman.el"
  fi
  if [ -z "${TRUSTRAIL_EL_DIR:-}" ] && [ -d "$_teeup_pkg_dir/trustrail.el" ]; then
    export TRUSTRAIL_EL_DIR="$_teeup_pkg_dir/trustrail.el"
  fi
  if [ -z "${WORDWISE_EL_DIR:-}" ] && [ -d "$_teeup_pkg_dir/wordwise.el" ]; then
    export WORDWISE_EL_DIR="$_teeup_pkg_dir/wordwise.el"
  fi
  if [ -n "${SDKMAN_EL_DIR:-}" ] &&
     [ -n "${TRUSTRAIL_EL_DIR:-}" ] &&
     [ -n "${WORDWISE_EL_DIR:-}" ]; then
    break
  fi
done
unset _teeup_pkg_dir
