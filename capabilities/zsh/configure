#!/usr/bin/env bash
# The three home files are thin: they source teeup's default layer and leave
# room underneath for your own lines. copy_config_once never overwrites a file
# you edited and backs up a foreign one with a diff.
#
# The shipped files look up the env file via
# ${XDG_CONFIG_HOME:-$HOME/.config}/teeup/env, unquoted (no double quotes
# around the token), and nothing macOS reads before ~/.zshenv ever sets
# XDG_CONFIG_HOME, so a non-default XDG_CONFIG_HOME (or a TEEUP_CONFIG_DIR
# override) would leave a fresh shell unable to find it.
# Render that token to the resolved, absolute env-file path at configure time
# instead, the same way capabilities/git/configure renders ~/.config/git into
# its include paths, so the installed files carry the real path, already
# %q-quoted so the token needs no surrounding double quotes of its own.
# Rendered with replace_literal (lib/files.sh), not sed or ${var//pat/repl}:
# $TEEUP_CONFIG_DIR can contain |, \ or & (sed metacharacters), bash 5.2 treats
# & in a ${var//} replacement as the matched text, and bash 3.2 mis-parses a
# quoted ${var//} pattern that contains a slash.

# zsh reads ${ZDOTDIR:-$HOME}/.zshenv, not always $HOME/.zshenv; install the
# home files wherever zsh will actually look for them.
zsh_home_dir="${ZDOTDIR:-$HOME}"
[[ -d "$zsh_home_dir" ]] || run_cmd mkdir -p "$zsh_home_dir"

# %q-escaped so a $, `, " or \ in TEEUP_CONFIG_DIR cannot break the rendered
# home file: the shipped placeholder line below carries no double quotes of
# its own around the token, so the %q form (backslash escapes or $'...',
# both parsed the same way by zsh 5.9) has to supply all of the quoting.
env_path_q="$(printf '%q' "$TEEUP_CONFIG_DIR/env")"

# .zshrc's local.zsh include needs exactly the same treatment, and for exactly
# the same reason: with a one-shot custom XDG_CONFIG_HOME at install time,
# copy_config_once below puts local.zsh under that custom root while a fresh
# login shell (which nothing sets XDG_CONFIG_HOME for before ~/.zshenv runs)
# would expand the shipped token to ~/.config/zsh/local.zsh and find nothing.
# Rendered from $(user_config_dir), not $TEEUP_CONFIG_DIR: local.zsh is a
# plain XDG config file, and TEEUP_CONFIG_DIR can be overridden on its own.
local_zsh_q="$(printf '%q' "$(user_config_dir)/zsh/local.zsh")"

for f in .zshenv .zprofile .zshrc; do
  rendered_home_file="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    rendered_line="$(replace_literal "$line" '${XDG_CONFIG_HOME:-$HOME/.config}/teeup/env' "$env_path_q")"
    replace_literal "$rendered_line" '${XDG_CONFIG_HOME:-$HOME/.config}/zsh/local.zsh' "$local_zsh_q"
  done < "$TEEUP_CAP_DIR/home/$f" > "$rendered_home_file"
  copy_config_once "$rendered_home_file" "$zsh_home_dir/$f"
  rm -f "$rendered_home_file"
done

# The documented home for machine-specific and personal lines, shipped as a
# comment-only stub so ~/.zshrc can source it unconditionally.
copy_config_once "$TEEUP_CAP_DIR/config/zsh/local.zsh" "$(user_config_dir)/zsh/local.zsh"

log "Open a new terminal, or run: exec zsh"
