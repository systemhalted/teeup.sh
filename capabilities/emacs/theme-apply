#!/usr/bin/env bash
# A running daemon keeps the theme it loaded at startup; teeup-apply (defined
# by the starter layer) re-reads current/theme and current/font. Doom and
# Spacemacs do not define it, so the form is guarded with fboundp and is a
# no-op there. Nothing happens until teeup installed emacs: `teeup theme set`
# runs every capability's hook, and an emacsclient on PATH that teeup did not
# set up is not this hook's to drive. `emacsclient -e t` is the cheapest "is a
# daemon up" probe; `-a false` keeps it a probe, because the zsh layer exports
# an empty ALTERNATE_EDITOR, which would otherwise start a daemon (emacsclient
# Options: -a on the command line takes precedence over the variable).
if ! state_done check "cap-$TEEUP_CAP" && [[ "${TEEUP_CONFIGURING:-}" != "$TEEUP_CAP" ]]; then
  exit 0
fi

# I3: Doom's config.el loads one mode-independent file (the marked line
# capabilities/emacs/configure adds), so a long-running daemon re-evaluates
# the appearance itself instead of staying on whatever mode was current when
# `teeup configure emacs` last ran. That file is not part of the per-mode
# template loop (lib/theme.sh renders themed/*.tpl once per mode, under
# current/theme/<mode>/), and current/theme/ is replaced wholesale on every
# `teeup theme set`, so it is written here, after every switch, rather than
# once at configure time -- anything not rewritten here would not survive the
# next switch. It carries no palette values, so it needs no per-theme
# rendering; only Doom's config.el ever loads it.
if [[ "$(answers_get TEEUP_EMACS_FLAVOR starter)" == "doom" ]]; then
  write_managed_file "$TEEUP_STATE_DIR/current/theme/doom-theme-loader.el" \
    "Doom's mode-independent theme loader" <<'DOOM_THEME_LOADER_EOF' || true
;;; doom-theme-loader.el --- generated by `teeup theme set'; do not edit  -*- lexical-binding: t -*-
;; Doom's config.el has one marked line (capabilities/emacs/configure) that
;; loads this file instead of a specific mode's doom-theme.el. This file picks
;; a mode itself, each time Doom reads it, with the same rule
;; `teeup--doom-appearance' (defined by the rendered doom-theme.el, and
;; duplicated here for the same reason: Doom never loads
;; capabilities/emacs/default/teeup/init.el, where the starter's own
;; `teeup-appearance' lives) uses, then loads that mode's doom-theme.el. That
;; keeps a Doom daemon that starts once and keeps running, across a change of
;; appearance, on the mode the machine has now rather than the mode it had
;; when Doom last read config.el.
(defun teeup--doom-appearance ()
  "Return \"dark\" or \"light\", the same way teeup's shell `appearance` does."
  (let ((env (getenv "TEEUP_APPEARANCE")))
    (cond
     ((member env '("dark" "light")) env)
     ((and (executable-find "defaults")
           (string= "Dark"
                    (string-trim
                     (with-output-to-string
                       (with-current-buffer standard-output
                         (call-process "defaults" nil t nil "read" "-g" "AppleInterfaceStyle"))))))
      "dark")
     (t "light"))))

(let ((rendered (expand-file-name
                 (concat "current/theme/" (teeup--doom-appearance) "/doom-theme.el")
                 ;; Same precedence as lib/core.sh: TEEUP_STATE_DIR, else
                 ;; XDG_STATE_HOME, else ~/.local/state, then /teeup. The
                 ;; daemon's LaunchAgent plist (capabilities/emacs/configure)
                 ;; exports TEEUP_STATE_DIR into this same process, so a
                 ;; non-default state dir is honored here too.
                 (or (getenv "TEEUP_STATE_DIR")
                     (expand-file-name "teeup" (or (getenv "XDG_STATE_HOME") "~/.local/state"))))))
  (when (file-readable-p rendered) (load rendered nil t)))
DOOM_THEME_LOADER_EOF
fi

if have emacsclient && emacsclient -a false -e t >/dev/null 2>&1; then
  run_cmd emacsclient -a false -e "(when (fboundp 'teeup-apply) (teeup-apply))" ||
    warn "Could not tell the Emacs daemon to reload its theme; it picks the new one up at the next restart."
else
  log "No Emacs daemon is running; the theme is read at the next start."
fi
