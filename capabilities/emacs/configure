#!/usr/bin/env bash
# Two jobs: put the chosen flavor's configuration in place, and keep an Emacs
# daemon running through a LaunchAgent so `emacsclient -t` (the editor the
# git and zsh capabilities point at) always has something to talk to.
#
# The flavor is the answer TEEUP_EMACS_FLAVOR (starter, doom, spacemacs or
# none; the wizard asks it when the daily tier is on, and a machine file can
# pin it). Emacs reads ~/.emacs.el, ~/.emacs and ~/.emacs.d before
# ~/.config/emacs (Emacs manual, "Find Init"), which decides where each
# flavor lives: the starter and Doom use ~/.config/emacs, Spacemacs's own
# instructions use ~/.emacs.d, and a leftover legacy location silently wins
# over the starter, so it is reported rather than moved.
flavor="$(answers_get TEEUP_EMACS_FLAVOR starter)"
case "$flavor" in
  starter|doom|spacemacs|none) ;;
  *)
    warn "Unknown TEEUP_EMACS_FLAVOR '$flavor' (expected starter, doom, spacemacs or none); using starter."
    flavor=starter
    ;;
esac

EMACS_DIR="$(user_config_dir)/emacs"
DOOM_DIR="${DOOMDIR:-$(user_config_dir)/doom}"
SPACEMACS_DIR="$HOME/.emacs.d"

legacy_init=""
for candidate in "$HOME/.emacs.el" "$HOME/.emacs" "$HOME/.emacs.d"; do
  if [[ -e "$candidate" ]]; then
    legacy_init="$candidate"
    break
  fi
done

# is_doom_checkout <dir>: Doom's CLI lives at bin/doom in its own checkout.
is_doom_checkout() { [[ -x "$1/bin/doom" ]]; }
# is_spacemacs_checkout <dir>: every Spacemacs checkout has core/ and layers/.
is_spacemacs_checkout() { [[ -d "$1/core" && -d "$1/layers" && -f "$1/init.el" ]]; }

case "$flavor" in
  starter)
    if is_doom_checkout "$EMACS_DIR"; then
      log "$EMACS_DIR is a Doom checkout; moving it aside for the starter configuration."
      backup_target "$EMACS_DIR" >/dev/null
    fi
    copy_config_once "$TEEUP_CAP_DIR/config/emacs/init.el" "$EMACS_DIR/init.el"
    copy_config_once "$TEEUP_CAP_DIR/config/emacs/local.el" "$EMACS_DIR/local.el"
    if [[ -n "$legacy_init" ]]; then
      warn "$legacy_init exists and Emacs reads it instead of $EMACS_DIR/init.el. Move it aside to use the teeup starter."
    fi
    ;;
  doom)
    if is_doom_checkout "$EMACS_DIR"; then
      log "Already a Doom checkout: $EMACS_DIR"
    else
      if [[ -e "$EMACS_DIR" ]]; then
        log "$EMACS_DIR is not a Doom checkout; moving it aside."
        backup_target "$EMACS_DIR" >/dev/null
      fi
      run_cmd git clone --depth 1 https://github.com/doomemacs/core "$EMACS_DIR" ||
        warn "Could not clone Doom Emacs; check the network and re-run: teeup configure emacs"
    fi
    # `doom install` is idempotent by Doom's own description, but a sync takes
    # minutes, so it runs only until the private config exists. --no-env
    # skips the one interactive prompt (envvar file), which this non-TTY
    # process could not answer.
    if [[ -f "$DOOM_DIR/init.el" ]]; then
      log "Doom is set up ($DOOM_DIR); after editing it run: doom sync"
    elif ! have emacs; then
      warn "emacs is not on PATH; once it is, run: $EMACS_DIR/bin/doom install --no-env"
    else
      run_cmd "$EMACS_DIR/bin/doom" install --no-env ||
        warn "doom install did not finish; re-run it by hand: $EMACS_DIR/bin/doom install --no-env"
    fi
    if [[ -n "$legacy_init" ]]; then
      warn "$legacy_init exists and Emacs reads it instead of $EMACS_DIR. Move it aside to use Doom."
    fi
    ;;
  spacemacs)
    if is_spacemacs_checkout "$SPACEMACS_DIR"; then
      log "Already a Spacemacs checkout: $SPACEMACS_DIR"
    else
      if [[ -e "$SPACEMACS_DIR" ]]; then
        log "$SPACEMACS_DIR is not a Spacemacs checkout; moving it aside."
        backup_target "$SPACEMACS_DIR" >/dev/null
      fi
      run_cmd git clone https://github.com/syl20bnr/spacemacs "$SPACEMACS_DIR" ||
        warn "Could not clone Spacemacs; check the network and re-run: teeup configure emacs"
    fi
    for candidate in "$HOME/.emacs.el" "$HOME/.emacs"; do
      if [[ -e "$candidate" ]]; then
        warn "$candidate exists and Emacs reads it instead of $SPACEMACS_DIR. Move it aside to use Spacemacs."
      fi
    done
    log "Spacemacs finishes its own setup on the first start; ~/.spacemacs is written then."
    ;;
  none)
    log "TEEUP_EMACS_FLAVOR=none: leaving your Emacs configuration alone."
    ;;
esac

# --- Doom's own theme file ----------------------------------------------------
# Doom reads its theme from `doom-theme' in config.el; it never loads
# capabilities/emacs/default/teeup/init.el, so `teeup theme set` did nothing
# for a Doom user. capabilities/emacs/themed/doom-theme.el.tpl renders one
# doom-theme.el per appearance under current/theme, the way the starter's own
# emacs.el does; this adds one marked, idempotent line near the top of
# config.el (so a user's own later `(setq doom-theme ...)` still wins).
#
# Final review I3: the line used to hard-code the mode current/theme/
# doom-theme-loader.el is the mode-independent path both here and picks it
# whichever mode matched this machine's appearance *at the moment `teeup
# configure emacs` last ran*, which is wrong for a Doom daemon that keeps
# running (say, started in the evening, still up the next afternoon): it
# never re-evaluated the appearance. The line now always loads one fixed,
# mode-independent file, current/theme/doom-theme-loader.el
# (capabilities/emacs/theme-apply renders it after every `teeup theme set`,
# since it is not part of the per-mode template loop and current/theme/ is
# replaced wholesale on every switch); that file itself picks dark or light
# with the same rule as `teeup--doom-appearance` each time Doom reads it, then
# loads that mode's doom-theme.el, which is what actually defines
# `teeup-apply` for the theme-apply hook to call afterwards.
#
# A config.el that does not exist yet (Doom not installed, or `doom install`
# above did not finish) gets nothing: there is nothing to load the line into,
# and creating one here would fight Doom's own first-run setup.
doom_theme_config_el="$DOOM_DIR/config.el"
if [[ "$flavor" == "doom" && -f "$doom_theme_config_el" ]]; then
  doom_theme_marker=";; teeup: theme (managed by teeup; remove this line to opt out)"
  # A user theme's directory, and TEEUP_STATE_DIR itself, can hold a space or
  # shell metacharacter; \ then " (in that order, or the second escape would
  # double the backslashes the first one just added) is all an absolute path
  # can contain that would otherwise break out of the elisp string literal
  # below.
  doom_theme_loader="$TEEUP_STATE_DIR/current/theme/doom-theme-loader.el"
  doom_theme_loader_escaped="$(replace_literal "$doom_theme_loader" '\' '\\')"
  doom_theme_loader_escaped="$(replace_literal "$doom_theme_loader_escaped" '"' '\"')"
  # `(load! FILE nil t)` is not the same as `(load! FILE "" t)`: load!
  # expands to (doom-load (file-name-concat (or PATH (dir!)) FILE) noerror),
  # and file-name-concat only skips an empty-string PATH -- with PATH nil (so
  # file-name-concat falls back to (dir!), config.el's own directory) it
  # plainly concatenates that directory in front of FILE even though FILE is
  # already absolute, producing a path that does not exist (verified against
  # emacs-mirror/emacs src/fileio.c's Ffile_name_concat, and against
  # doomemacs/doomemacs lisp/doom-lib.el's `load!`/`doom-load`, commit
  # 01d68aaf6bd7db073365385cd82e1ad7e815295c, with a local `emacs -Q --batch`
  # check of both forms on 2026-09-26). "" is the form that actually loads an
  # absolute FILE.
  doom_theme_load_line="(load! \"$doom_theme_loader_escaped\" \"\" t)"
  if grep -qF "$doom_theme_marker" "$doom_theme_config_el"; then
    # I3: a marked line written before this fix still names one mode's own
    # doom-theme.el directly; rewrite just that one line so every configure
    # run converges on the mode-independent loader, without moving the
    # marker or anything else in the file.
    doom_theme_next_line="$(grep -A1 -F "$doom_theme_marker" "$doom_theme_config_el" | tail -n 1)"
    if [[ "$doom_theme_next_line" == "$doom_theme_load_line" ]]; then
      log "Already present in $(basename "$doom_theme_config_el"): the teeup theme line"
    elif [[ "$DRY_RUN" == "true" ]]; then
      printf "%b %s\n" "🔍" "[DRY-RUN] Would rewrite the line after $doom_theme_marker in $doom_theme_config_el to: $doom_theme_load_line"
    elif [[ -L "$doom_theme_config_el" ]]; then
      warn "$doom_theme_config_el is a symlink; teeup does not write through it. Point the line after $doom_theme_marker at: $doom_theme_load_line"
    else
      doom_theme_config_tmp="$(mktemp)"
      doom_theme_after_marker=false
      doom_theme_rewrite_ok=true
      while IFS= read -r doom_theme_line || [[ -n "$doom_theme_line" ]]; do
        if [[ "$doom_theme_after_marker" == true ]]; then
          printf '%s\n' "$doom_theme_load_line" >> "$doom_theme_config_tmp"
          doom_theme_after_marker=false
          continue
        fi
        printf '%s\n' "$doom_theme_line" >> "$doom_theme_config_tmp"
        if [[ "$doom_theme_line" == "$doom_theme_marker" ]]; then
          doom_theme_after_marker=true
        fi
      done < "$doom_theme_config_el" || doom_theme_rewrite_ok=false
      if [[ "$doom_theme_rewrite_ok" == true ]] && mv "$doom_theme_config_tmp" "$doom_theme_config_el"; then
        ok "Rewrote the teeup theme line in $doom_theme_config_el to load the mode-independent loader"
      else
        rm -f "$doom_theme_config_tmp"
        warn "Could not rewrite $doom_theme_config_el; point the line after $doom_theme_marker at: $doom_theme_load_line"
      fi
    fi
  else
    if [[ "$DRY_RUN" == "true" ]]; then
      printf "%b %s\n" "🔍" "[DRY-RUN] Would add to $doom_theme_config_el: $doom_theme_marker"
    elif [[ -L "$doom_theme_config_el" ]]; then
      warn "$doom_theme_config_el is a symlink; teeup does not write through it. Add near the top by hand: $doom_theme_load_line"
    else
      # Emacs only honors a `-*- ... -*-` file-local-variables cookie (e.g.
      # `lexical-binding: t`) on the file's first line; prepending the marked
      # block ahead of it would silently push the cookie to line 2+ and
      # change how the rest of config.el loads, with no error anywhere. When
      # the first line carries one, keep it first and insert the block right
      # after it instead; otherwise insert at the top as before.
      doom_theme_first_line=""
      IFS= read -r doom_theme_first_line < "$doom_theme_config_el" || true
      doom_theme_rest_from=1
      case "$doom_theme_first_line" in
        *'-*-'*) doom_theme_rest_from=2 ;;
      esac
      doom_theme_config_tmp="$(mktemp)"
      if {
           if [[ "$doom_theme_rest_from" -eq 2 ]]; then
             printf '%s\n' "$doom_theme_first_line"
           fi
           printf '%s\n%s\n\n' "$doom_theme_marker" "$doom_theme_load_line"
           tail -n "+$doom_theme_rest_from" "$doom_theme_config_el"
         } > "$doom_theme_config_tmp" &&
         mv "$doom_theme_config_tmp" "$doom_theme_config_el"; then
        ok "Added the teeup theme line near the top of $doom_theme_config_el"
      else
        rm -f "$doom_theme_config_tmp"
        warn "Could not update $doom_theme_config_el; add near the top by hand: $doom_theme_load_line"
      fi
    fi
  fi
fi

# --- the daemon --------------------------------------------------------------
# launchd starts the agent with no PATH and none of the shell's environment,
# so the plist carries the binary's full path and the variables the starter
# layer reads: TEEUP_PATH first (a config that cannot find the checkout falls
# back to a plain Emacs), and XDG_CONFIG_HOME, without which a daemon on a
# machine with a non-default one would look for ~/.config/emacs, find nothing
# and create ~/.emacs.d (Emacs manual, "Find Init"). The values are
# XML-escaped: a home directory with an ampersand in it would otherwise be a
# malformed plist.
#
# RunAtLoad starts the daemon at login and whenever the agent is (re)loaded.
# KeepAlive with SuccessfulExit false restarts it only after a crash
# (launchd.plist(5)): `kill-emacs` exits 0, so a daemon stopped on purpose
# stays down until the next login, `launchctl kickstart`, or an `emacsclient`
# from zsh (the shell layer exports an empty ALTERNATE_EDITOR, which starts
# one).
plist_escape() {
  printf '%s\n' "$(replace_literal "$(replace_literal "$(replace_literal "$1" '&' '&amp;')" '<' '&lt;')" '>' '&gt;')"
}

# Prefer the emacs-app cask's own binary inside the bundle over a PATH
# `emacs`: when Homebrew's terminal-only emacs formula is already installed
# (I2, install's warning above), the cask's link step skips linking
# emacs/emacsclient over the formula's binary, so `command -v emacs` still
# resolves the formula build and the daemon would never open a GUI frame.
# TEEUP_APPS_DIR is the test hook for /Applications; ~/Applications is where
# HOMEBREW_CASK_OPTS can land a cask instead; MacPorts moves the emacs-app
# port's bundle under macports_apps_dir (lib/pkg.sh) instead of either (I4) --
# only searched on MacPorts, so a Homebrew machine never even stats a path
# that could not exist there.
emacs_bin=""
emacs_bin_is_gui=false
emacs_app_dirs="${TEEUP_APPS_DIR:-/Applications} $HOME/Applications"
casks_supported || emacs_app_dirs="$emacs_app_dirs $(macports_apps_dir)"
for app_dir in $emacs_app_dirs; do
  if [[ -x "$app_dir/Emacs.app/Contents/MacOS/Emacs" ]]; then
    emacs_bin="$app_dir/Emacs.app/Contents/MacOS/Emacs"
    emacs_bin_is_gui=true
    break
  fi
done
if [[ -z "$emacs_bin" ]] && have emacs; then
  emacs_bin="$(command -v emacs)"
fi
if [[ -z "$emacs_bin" ]]; then
  log "emacs is not on PATH yet; the daemon LaunchAgent is written the next time you run: teeup configure emacs"
else
  # pkg_prefix depends only on the package-manager answer and macos_major
  # (or, in tests, TEEUP_PKG_PREFIX), none of which differ between sessions on
  # the same machine, so unlike $TMPDIR below it cannot itself put a stale
  # value in the plist-unchanged gate.
  agent_path="$(dirname "$emacs_bin"):$(pkg_prefix)/bin:$(pkg_prefix)/sbin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  # The server socket lives under TMPDIR (emacs<uid>), and emacsclient looks
  # under its own TMPDIR, so the daemon needs one in the plist. $TMPDIR
  # itself legitimately differs between sessions on the same Mac (a
  # Terminal.app/WindowServer session gets /var/folders/.../T/; a non-login
  # context such as `ssh host teeup configure emacs` usually has it unset),
  # and baking the session's own value into the plist made the
  # plist-unchanged gate below flip on every other run, bootout-ing and
  # rebootstrap-ing a live daemon for no reason (I3). getconf
  # DARWIN_USER_TEMP_DIR is what macOS derives every session's TMPDIR from,
  # so it is the same value no matter which session asks; ${TMPDIR:-} is only
  # the fallback for a getconf without that variable (not macOS, and the
  # test harness).
  emacs_tmpdir="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)"
  [[ -n "$emacs_tmpdir" ]] || emacs_tmpdir="${TMPDIR:-}"
  tmpdir_entry=""
  if [[ -n "$emacs_tmpdir" ]]; then
    tmpdir_entry="
    <key>TMPDIR</key>
    <string>$(plist_escape "$emacs_tmpdir")</string>"
  fi
  rendered_plist="$(mktemp)"
  cat > "$rendered_plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sh.teeup.emacs</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(plist_escape "$emacs_bin")</string>
    <string>--fg-daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(plist_escape "$agent_path")</string>
    <key>XDG_CONFIG_HOME</key>
    <string>$(plist_escape "$(user_config_dir)")</string>
    <key>TEEUP_PATH</key>
    <string>$(plist_escape "$TEEUP_PATH")</string>
    <key>TEEUP_CONFIG_DIR</key>
    <string>$(plist_escape "$TEEUP_CONFIG_DIR")</string>
    <key>TEEUP_STATE_DIR</key>
    <string>$(plist_escape "$TEEUP_STATE_DIR")</string>$tmpdir_entry
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
PLIST

  # launchagent_install always reloads, which would kill a running daemon (and
  # its unsaved buffers) on every `teeup configure emacs`. So the agent is only
  # (re)installed when the plist changed or launchd does not have it loaded;
  # `launchctl print` is the read that answers the second half.
  plist_path="$HOME/Library/LaunchAgents/sh.teeup.emacs.plist"
  if [[ -f "$plist_path" ]] && cmp -s "$rendered_plist" "$plist_path" &&
     launchctl print "gui/$(id -u)/sh.teeup.emacs" >/dev/null 2>&1; then
    log "Emacs daemon agent already loaded: sh.teeup.emacs"
  elif launchagent_install sh.teeup.emacs < "$rendered_plist"; then
    # The "opens a window" half is only true when the chosen binary is a GUI
    # build (an Emacs.app bundle, emacs_bin_is_gui above); the MacPorts
    # terminal-only `emacs` port (I4) can never satisfy emacsclient -c.
    if [[ "$emacs_bin_is_gui" == "true" ]]; then
      ok_unless_dry "Emacs runs as a daemon at login; emacsclient -t opens a terminal frame, emacsclient -c a window."
    else
      ok_unless_dry "Emacs runs as a daemon at login; emacsclient -t opens a terminal frame. $emacs_bin is a terminal-only build, so emacsclient -c cannot open a window; install the emacs-app cask (or MacPorts' emacs-app port) for that."
    fi
  else
    # launchagent_install already warned why; this says what is actually
    # true now, instead of the unconditional success line I1 found (a "runs
    # as a daemon" claim right after launchd refused to load it).
    warn "Emacs is not running as a daemon; run: launchctl bootstrap gui/$(id -u) $plist_path"
  fi
  rm -f "$rendered_plist"
  log "A running daemon keeps its old configuration until: launchctl kickstart -k gui/$(id -u)/sh.teeup.emacs"
fi

# --- git's editor -------------------------------------------------------------
# The git capability writes core.editor = emacsclient -t only when emacsclient
# is on PATH, and git runs in the core tier, before this daily capability has
# installed Emacs. Re-running it here (copying capabilities/ssh/configure's own
# git re-run, DRY_RUN branch included) makes a first bootstrap end with git
# opening emacsclient rather than vim. A machine where git was never
# configured, or skips it, has nothing to update; a git already pointed at
# emacsclient is left alone.
git_generated="$(user_config_dir)/git/teeup-generated"
git_wants_emacsclient=false
if [[ -f "$git_generated" ]] && ! grep -q 'editor = emacsclient' "$git_generated"; then
  git_wants_emacsclient=true
fi
if have emacsclient && ! cap_skipped git; then
  if [[ "$DRY_RUN" == "true" || "$git_wants_emacsclient" == "true" ]]; then
    log "Re-running the git configuration so git opens emacsclient."
    cap_run git configure || warn "Could not re-run the git configuration. Run: teeup configure git"
  else
    log "No $git_generated to update, or it already opens emacsclient."
  fi
fi
